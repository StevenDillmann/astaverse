# Astaverse expects OpenAI + Gemini keys (no Anthropic / OpenRouter).
OPENAI_API_KEY=
GEMINI_API_KEY=

# Models for plan sampling (s2), decision extraction (s3), and belief
# elicitation (s8). Pointing s2 and s3 at DIFFERENT models is bias control 4:
# one model doing both misses the forks it never entertains. Separate them when
# extraction recall matters.
ASTAVERSE_PLAN_MODEL=openai/gpt-5.6-luna
ASTAVERSE_DECISION_MODEL=openai/gpt-5.6-luna
ASTAVERSE_BELIEF_MODEL=openai/gpt-5.6-luna

# Judge used by reward-kit inside the Harbor verifier.
REWARDKIT_JUDGE=openai/gpt-5.6-luna
