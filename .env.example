# Astaverse expects OpenAI + Gemini keys (no Anthropic / OpenRouter).
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model used to sample plans (s2) and to extract decisions (s3).
# Deliberately different by default — see "bias controls" in the README.
ASTAVERSE_PLAN_MODEL=openai/gpt-5-mini
ASTAVERSE_DECISION_MODEL=gemini/gemini-2.5-pro
ASTAVERSE_BELIEF_MODEL=openai/gpt-5-mini

# Judge used by reward-kit inside the Harbor verifier.
REWARDKIT_JUDGE=openai/gpt-5-mini
