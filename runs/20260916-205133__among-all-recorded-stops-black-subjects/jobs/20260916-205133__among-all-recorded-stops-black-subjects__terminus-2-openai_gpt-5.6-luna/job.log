\ndef _load_universe(path):\n    with open(path) as f:\n        u = yaml.safe_load(f)\n    decisions = {z[\'decision_id\']: z[\'option_id\'] for z in u[\'decisions\']}\n    return u[\'id\'], decisions\n\n\ndef main():\n    df = pd.read_csv(DATA, low_memory=False)\n    paths = sorted(glob.glob(\'/app/universes/*.yaml\'))\n    rows = []\n    for path in paths:\n        uid, decisions = _load_universe(path)\n        result = analyze(df, decisions)\n        rows.append({\'universe_id\': uid, \'decisions\': decisions, **result})\n    with open(OUT, \'w\') as f:\n        for row in rows:\n            f.write(json.dumps(row, allow_nan=False) + \'\\n\')\n    good = [r for r in rows if r[\'converged\'] and r[\'estimate_standardized\'] is not None]\n    lines = [\'# Multiverse analysis report\', \'\',\n             \'The analysis compares Black and White search rates. Race, stop scope, search outcome, missing-value handling, adjustment, and uncertainty dependence are all selected from each universe YAML and passed through the same `analyze` function.\', \'\']\n    lines += [\'## Results\', f\'- Universes evaluated: **{len(rows)}**\', f\'- Successful fits: **{len(good)}**\']\n    if good:\n        vals = np.array([r[\'estimate_standardized\'] for r in good])\n        lines += [f\'- Standardized estimate range: **{vals.min():.6g}** to **{vals.max():.6g}**\', f\'- Positive estimates: **{sum(v > 0 for v in vals)} / {len(vals)}**\', \'\']\n        for dec in sorted({k for r in rows for k in r[\'decisions\']}):\n            groups = {}\n            for r in good:\n                opt = r[\'decisions\'][dec]\n                groups.setdefault(opt, []).append(r[\'estimate_standardized\'])\n            lines.append(f\'### {dec}\')\n            for opt, a in sorted(groups.items()):\n                lines.append(f\'- `{opt}`: mean {np.mean(a):.6g}, range {np.min(a):.6g} to {np.max(a):.6g}, n={len(a)}\')\n            lines.append(\'\')\n        lines += [\'The largest decision effects ca