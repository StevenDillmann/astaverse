[42.399126, "i", "cat > /app/analysis.py <<'PY'\nimport json, math, glob, os\nimport numpy as np\nimport pandas as pd\nimport yaml\nimport statsmodels.api as sm\nfrom scipy import stats\n\nDATA = '/app/data.csv'\nOUT = '/app/universes.jsonl'\n\n\ndef _num(v):\n    if v is None or not np.isfinite(v):\n        return None\n    return float(v)\n\n\ndef _direction(v):\n    if v is None or not np.isfinite(v) or abs(v) < 1e-15:\n        return 'none'\n    return 'positive' if v > 0 else 'negative'\n\n\ndef _empty(n=0):\n    return {'estimate': None, 'estimate_standardized': None,\n            'std_error': None, 'std_error_standardized': None,\n            'ci_low_standardized': None, 'ci_high_standardized': None,\n            'p_value': None, 'n': int(n), 'direction': 'none',\n            'converged': False}\n\n\ndef _binary_series(s):\n    if pd.api.types.is_bool_dtype(s):\n        return s.astype(float)\n    return pd.to_numeric(s, errors='coerce')\n\n\ndef analyze(df, selections: dict[str, str]) -> dict:\n    \"\"\"Run the analysis for ONE universe.\"\"\"\n    try:\n        race_choice = selections['race_variable_definition']\n        scope = selections['stop_scope']\n        outcome_choice = selections['search_outcome_definition']\n        missing = selections['missing_search_handling']\n        adjustment = selections['confounding_adjustment']\n        dependence = selections['uncertainty_dependence']\n\n        d = df.copy()\n        if scope == 'durham_county_only':\n            d = d[d['county_name'].eq('Durham County')].copy()\n        elif scope == 'durham_police_only':\n            d = d[d['department_name'].eq('Durham Police Department')].copy()\n        elif scope != 'all_dataset_rows':\n            raise ValueError('unknown stop scope')\n\n        if race_choice == 'subject_race_black_white':\n            r = d['subject_race'].astype('string')\n            keep = r.isin(['black', 'white'])\n            d = d.loc[keep].copy()\n            d['_black'] = r.loc[keep].eq('black').astype(float).to_numpy()\n        elif race_choice == 'raw_race_black_white':\n            r = d['raw_Race'].astype('string')\n            keep = r.isin(['B', 'W'])\n            d = d.loc[keep].copy()\n            d['_black'] = r.loc[keep].eq('B').astype(float).to_numpy()\n        elif race_choice == 'subject_race_with_unknown_as_white':\n            r = d['subject_race'].astype('string')\n            keep = r.notna()\n            d = d.loc[keep].copy()\n            d['_black'] = r.loc[keep].eq('black').astype(float).to_numpy()\n        else:\n            raise ValueError('unknown race definition')\n\n        if outcome_choice == 'search_conducted':\n            y = _binary_series(d['search_conducted'])\n        elif outcome_choice == 'any_person_or_vehicle_search':\n            a, b = _binary_series(d['search_person']), _binary_series(d['search_vehicle'])\n            y = pd.Series(np.where(a.notna() & b.notna(), ((a == 1) | (b == 1)).astype(float), np.nan), index=d.index)\n        elif outcome_choice == 'person_search_only':\n            y = _binary_series(d['search_person'])\n        elif outcome_choice == 'vehicle_search_only':\n            y = _binary_series(d['search_vehicle'])\n        else:\n            raise ValueError('unknown outcome definition')\n        d['_y'] = y\n        if missing == 'missing_as_no_search':\n            d['_y'] = d['_y'].fillna(0.0)\n        elif missing in ('complete_case', 'report_missing_as_separate_status'):\n            d = d[d['_y'].notna()].copy()\n        else:\n            raise ValueError('unknown missing handling')\n\n        if len(d) < 2 or d['_black'].nunique() < 2 or d['_y'].nunique() < 2:\n            return _empty(len(d))\n\n        # Adjustment models require complete covariates; this is a model-fitting\n        # requirement, not a universe-specific exception.\n        if adjustment == 'unadjusted_rate_comparison':\n            n = len(d)\n            x = d['_black'].to_numpy(float)\n            yy = d['_y'].to_numpy(float)\n            nb, nw = int(x.sum()), int((1-x).sum())\n            pb, pw = yy[x == 1].mean(), yy[x == 0].mean()\n            est = float(pb - pw)\n            if dependence == 'iid_two_proportion"]
[42.399182, "i", "':\n                se = math.sqrt(pb*(1-pb)/nb + pw*(1-pw)/nw)\n                pval = 2 * stats.norm.sf(abs(est/se)) if se > 0 else (0.0 if est else 1.0)\n            else:\n                X = sm.add_constant(x)\n                fit = sm.OLS(yy, X).fit()\n                if dependence == 'officer_cluster_robust':\n                    groups = d['officer_id_hash'].fillna('__missing__')\n                elif dependence == 'department_cluster_robust':\n                    groups = d['department_name'].fillna('__missing__')\n                else:\n                    raise ValueError('unknown dependence')\n                rob = fit.get_robustcov_results(cov_type='cluster', groups=groups)\n                se, pval = float(rob.bse[1]), float(rob.pvalues[1])\n            sx = float(np.std(x, ddof=1)); sy = float(np.std(yy, ddof=1))\n            scale = sx / sy if sy > 0 else sx\n            eststd, sestd = est*scale, se*abs(scale)\n            lo, hi = eststd - 1.96*sestd, eststd + 1.96*sestd\n            return {'estimate': _num(est), 'estimate_standardized': _num(eststd),\n                    'std_error': _num(se), 'std_error_standardized': _num(sestd),\n                    'ci_low_standardized': _num(lo), 'ci_high_standardized': _num(hi),\n                    'p_value': _num(pval), 'n': n, 'direction': _direction(eststd), 'converged': True}\n\n        if adjustment != 'covariate_adjusted_logistic':\n            raise ValueError('unknown adjustment')\n        d = d.copy()\n        d['_year'] = pd.to_datetime(d['date'], errors='coerce').dt.year\n        covars = ['_y', '_black', 'subject_age', 'subject_sex', 'reason_for_stop',\n                  'department_name', 'county_name', '_year']\n        d = d.dropna(subset=covars).copy()\n        if len(d) < 2 or d['_black'].nunique() < 2 or d['_y'].nunique() < 2:\n            return _empty(len(d))\n        sx = float(d['_black'].std(ddof=1))\n        if not np.isfinite(sx) or sx == 0:\n            return _empty(len(d))\n        d['_black_std'] = (d['_black'] - d['_black'].mean()) / sx\n        formula = '_y ~ _black_std + subject_age + C(subject_sex) + C(reason_for_stop) + C(department_name) + C(county_name) + C(_year)'\n        model = sm.GLM.from_formula(formula, data=d, family=sm.families.Binomial())\n        fit = model.fit()\n        if dependence == 'officer_cluster_robust':\n            groups = d['officer_id_hash'].fillna('__missing__')\n            fit = model.fit(cov_type='cluster', cov_kwds={'groups': groups})\n        elif dependence == 'department_cluster_robust':\n            groups = d['department_name'].fillna('__missing__')\n            fit = model.fit(cov_type='cluster', cov_kwds={'groups': groups})\n        elif dependence != 'iid_two_proportion':\n            raise ValueError('unknown dependence')\n        term = '_black_std'\n        eststd = float(fit.params[term]); sestd = float(fit.bse[term])\n        est = eststd / sx; se = sestd / sx\n        pval = float(fit.pvalues[term])\n        lo, hi = eststd - 1.96*sestd, eststd + 1.96*sestd\n        return {'estimate': _num(est), 'estimate_standardized': _num(eststd),\n                'std_error': _num(se), 'std_error_standardized': _num(sestd),\n                'ci_low_standardized': _num(lo), 'ci_high_standardized': _num(hi),\n                'p_value': _num(pval), 'n': int(len(d)), 'direction': _direction(eststd),\n                'converged': bool(getattr(fit, 'converged', True))}\n    except Exception:\n        return _empty(0)\n\n\ndef _load_universe(path):\n    with open(path) as f:\n        u = yaml.safe_load(f)\n    decisions = {z['decision_id']: z['option_id'] for z in u['decisions']}\n    return u['id'], decisions\n\n\ndef main():\n    df = pd.read_csv(DATA, low_memory=False)\n    paths = sorted(glob.glob('/app/universes/*.yaml'))\n    rows = []\n    for path in paths:\n        uid, decisions = _load_universe(path)\n        result = analyze(df, decisions)\n        rows.append({'universe_id': uid, 'decisions': decisions, **result})\n    with open(OUT, 'w') as f:\n        for row in rows:\n            f.write(json.dumps(row, allow_nan=False) + '\\n')\n    good = [r for r in rows if"]
