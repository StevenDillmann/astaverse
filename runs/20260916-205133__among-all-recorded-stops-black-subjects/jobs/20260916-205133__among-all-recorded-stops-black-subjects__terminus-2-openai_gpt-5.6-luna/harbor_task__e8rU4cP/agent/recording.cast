[42.399622, "i", " r['converged'] and r['estimate_standardized'] is not None]\n    lines = ['# Multiverse analysis report', '',\n             'The analysis compares Black and White search rates. Race, stop scope, search outcome, missing-value handling, adjustment, and uncertainty dependence are all selected from each universe YAML and passed through the same `analyze` function.', '']\n    lines += ['## Results', f'- Universes evaluated: **{len(rows)}**', f'- Successful fits: **{len(good)}**']\n    if good:\n        vals = np.array([r['estimate_standardized'] for r in good])\n        lines += [f'- Standardized estimate range: **{vals.min():.6g}** to **{vals.max():.6g}**', f'- Positive estimates: **{sum(v > 0 for v in vals)} / {len(vals)}**', '']\n        for dec in sorted({k for r in rows for k in r['decisions']}):\n            groups = {}\n            for r in good:\n                opt = r['decisions'][dec]\n                groups.setdefault(opt, []).append(r['estimate_standardized'])\n            lines.append(f'### {dec}')\n            for opt, a in sorted(groups.items()):\n                lines.append(f'- `{opt}`: mean {np.mean(a):.6g}, range {np.min(a):.6g} to {np.max(a):.6g}, n={len(a)}')\n            lines.append('')\n        lines += ['The largest decision effects can be identified by comparing the option means above; these are descriptive specification-curve summaries, not additional hypothesis tests.', '']\n    lines += ['## Method details', '- Unadjusted universes use the Black-minus-White difference in stop-level rates.', '- Adjusted universes fit logistic regression with age, sex, stop reason, department, county, and calendar year covariates.', '- IID uncertainty uses analytic/model-based standard errors; officer or department choices use clustered robust covariance.', '- Standardized estimates use a one-SD Black indicator contrast; unadjusted binary outcomes are additionally expressed in outcome-SD units.']\n    with open('/app/results.md', 'w') as f:\n        f.write('\\n'.join(lines) + '\\n')\n    print(f'wrote {len(rows)} universes; successful={len(good)}')\n\nif __name__ == '__main__':\n    main()\nPY\npython3 /app/analysis.py\n"]
