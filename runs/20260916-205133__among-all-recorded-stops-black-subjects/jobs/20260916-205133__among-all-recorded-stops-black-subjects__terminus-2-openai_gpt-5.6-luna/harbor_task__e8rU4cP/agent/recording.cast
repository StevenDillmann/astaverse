[110.180557, "o", "    return self._fit_irls(\r\n           ^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/site-packages/statsmodels/genmod/generalized_linear_model.py\", line 1466, in _fit_irls\r\n"]
