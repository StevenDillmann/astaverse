[6.573046, "o", "--- astra.yaml ---\r\n"]
[6.573865, "o", "id: nc-durham-stops_multiverse\r\nname: 'nc-durham-stops: multiverse analysis'\r\ndescription: Decision space extracted by mode 'direct'.\r\ninputs:\r\n- id: dataset\r\n  type: data\r\n  source: /Users/stevend/Desktop/Asta/astaverse/data/datasets/nc-durham-stops/data.csv\r\n  description: Primary dataset under analysis\r\noutputs:\r\n- id: universe_stats\r\n  type: table\r\n  description: 'Per-universe statistics (estimate, estimate_standardized, std_error, std_error_standardized,\r\n    95% standardized confidence interval, p_value, n, direction). Carries no verdict by design: verdicts\r\n    are assigned downstream.'\r\n  inputs:\r\n  - dataset\r\n  decisions:\r\n  - confounding_adjustment\r\n  - missing_search_handling\r\n  - race_variable_definition\r\n  - search_outcome_definition\r\n  - stop_scope\r\n  - uncertainty_dependence\r\n  recipe:\r\n    command: python /app/analysis.py\r\ndecisions:\r\n  race_variable_definition:\r\n    label: Race comparison definition\r\n    rationale: 'Which recorded race field and categories define the Black-versus-White comparison?  [found\r\n      by: direct]'\r\n    default: subject_race_black_white\r\n    options:\r\n      subject_race_black_white:\r\n        label: Use subject_race categories\r\n        description: Retain rows with subject_race == \"black\" or subject_race == \"white\"; compare those\r\n          two groups and exclude all other subject_race values.\r\n      raw_race_black_white:\r\n        label: Use raw_Race codes\r\n        description: Retain rows with raw_Race == \"B\" or raw_Race == \"W\"; define B as Black and W as White,\r\n          and exclude all other raw_Race values.\r\n      subject_race_with_unknown_as_white:\r\n        label: Use subject_race with unknowns assigned to White\r\n        description: Use subject_race == \"black\" as Black and combine subject_race == \"white\" with subject_race\r\n"]
[6.57389, "o", "          == \"unknown\" or other non-Black categories as the comparison group.\r\n    x_astaverse:\r\n      kind: variable_choice\r\n      post_hoc: false\r\n      option_support:\r\n        subject_race_black_white: []\r\n        raw_race_black_white: []\r\n        subject_race_with_unknown_as_white: []\r\n  stop_scope:\r\n    label: Stops included in the estimand\r\n    rationale: \"Does \\u201Call recorded stops\\u201D mean every row in the dataset or only stops from a\\\r\n      \\ Durham geographic or departmental subset?  [found by: direct]\"\r\n    default: all_dataset_rows\r\n    options:\r\n      all_dataset_rows:\r\n        label: All eligible dataset rows\r\n        description: Use stops from every county_name and department_name represented in nc-durham-stops,\r\n          subject only to the selected race and outcome missingness rules.\r\n      durham_county_only:\r\n        label: Durham County stops\r\n        description: Retain only rows with county_name == \"Durham County\".\r\n      durham_police_only:\r\n        label: Durham Police Department stops\r\n"]
[6.573924, "o", "        description: Retain only rows with department_name == \"Durham Police Department\".\r\n    x_astaverse:\r\n      kind: preprocessing\r\n      post_hoc: false\r\n      option_support:\r\n        all_dataset_rows: []\r\n        durham_county_only: []\r\n        durham_police_only: []\r\n  search_outcome_definition:\r\n    label: Search-rate outcome\r\n    rationale: 'Which column or combination of columns counts as a search?  [found by: direct]'\r\n    default: search_conducted\r\n    options:\r\n      search_conducted:\r\n        label: Any recorded search\r\n        description: Set the binary outcome to 1 when search_conducted == 1 and to 0 when search_conducted\r\n          == 0.\r\n      any_person_or_vehicle_search:\r\n        label: Person-or-vehicle search\r\n        description: Set the binary outcome to 1 when search_person == 1 or search_vehicle == 1; otherwise\r\n          set it to 0.\r\n      person_search_only:\r\n        label: Person search\r\n        description: Set the binary outcome to 1 only when search_person == 1; set it to 0 when search_person\r\n          == 0.\r\n      vehicle_search_only:\r\n        label: Vehicle search\r\n        description: Set the binary outcome to 1 only when search_vehicle == 1; set it to 0 when search_vehicle\r\n          == 0.\r\n    x_astaverse:\r\n      kind: variable_choice\r\n      post_hoc: false\r\n      option_support:\r\n        search_conducted: []\r\n        any_person_or_vehicle_search: []\r\n        person_search_only: []\r\n        vehicle_search_only: []\r\n  missing_search_handling:\r\n    label: Missing outcome handling\r\n    rationale: 'How should stops with a missing value for the selected search outcome be handled?  [found\r\n      by: direct]'\r\n    default: complete_case\r\n    options:\r\n      complete_case:\r\n        label: Exclude missing outcome values\r\n"]
[6.57412, "o", "        description: Exclude any retained Black or White stop whose selected search outcome is missing;\r\n          calculate each race-specific rate using only rows with a nonmissing outcome.\r\n      missing_as_no_search:\r\n        label: Code missing as no search\r\n        description: For retained Black or White stops, replace a missing selected search outcome with\r\n          0 before calculating rates.\r\n      report_missing_as_separate_status:\r\n        label: Treat missing outcomes as unavailable\r\n        description: Do not impute missing outcomes; calculate rates among nonmissing outcomes and additionally\r\n          report the number and fraction of missing outcomes by race.\r\n    x_astaverse:\r\n      kind: preprocessing\r\n      post_hoc: false\r\n      option_support:\r\n        complete_case: []\r\n        missing_as_no_search: []\r\n        report_missing_as_separate_status: []\r\n  confounding_adjustment:\r\n    label: Adjustment for stop composition\r\n    rationale: 'Should the Black-versus-White search-rate comparison be an unadjusted comparison across\r\n      stops or adjust for recorded stop and driver characteristics?  [found by: direct]'\r\n    default: unadjusted_rate_comparison\r\n    options:\r\n      unadjusted_rate_comparison:\r\n        label: Unadjusted stop-level rates\r\n        description: For each race, divide the number of stops with the selected search outcome equal\r\n          to 1 by the number of eligible stops, with no adjustment for age, sex, reason, date, county,\r\n          department, or officer.\r\n      covariate_adjusted_logistic:\r\n        label: Covariate-adjusted logistic model\r\n        description: Fit a logistic regression for the selected binary search outcome with Black-versus-White\r\n          race as the focal predictor and subject_age, subject_sex, reason_for_stop, department_name,\r\n          county_name, and calendar year extracted from date as covariates; report the race contrast from\r\n          the model.\r\n    x_astaverse:\r\n      kind: model\r\n      post_hoc: false\r\n      option_support:\r\n        unadjusted_rate_comparison: []\r\n        covariate_adjusted_logistic: []\r\n  uncertainty_dependence:\r\n    label: Dependence and uncertainty calculation\r\n    rationale: 'How should uncertainty account for repeated stops associated with the same officer_id_hash?  [found\r\n      by: direct]'\r\n    default: iid_two_proportion\r\n    options:\r\n      iid_two_proportion:\r\n        label: Independent-stop uncertainty\r\n        description: Use a two-sample proportion comparison or equivalent model-based standard error that\r\n          treats all eligible stop rows as independent.\r\n      officer_cluster_robust:\r\n        label: Officer-clustered uncertainty\r\n        description: Estimate uncertainty with standard errors or a bootstrap clustered by officer_id_hash,\r\n          allowing stops handled by the same officer to be correlated.\r\n      department_cluster_robust:\r\n        label: Department-clustered uncertainty\r\n        description: Estimate uncertainty with standard errors or a bootstrap clustered by department_name,\r\n          allowing dependence among stops reported by the same department.\r\n    x_astaverse:\r\n      kind: inference\r\n      post_hoc: false\r\n      option_support:\r\n        iid_two_proportion: []\r\n        officer_cluster_robust: []\r\n        department_cluster_robust: []\r\n  verdict_rule:\r\n    label: Verdict decision rule\r\n    rationale: How the reported statistics become a supported / not-supported verdict. Left implicit by\r\n      every plan, and consequential on its own.\r\n    default: alpha_05_two_sided\r\n    options:\r\n      alpha_05_two_sided:\r\n        label: p < 0.05, two-sided\r\n        description: Conventional two-sided test at the 5% level.\r\n      alpha_01_two_sided:\r\n        label: p < 0.01, two-sided\r\n        description: Stricter two-sided threshold at the 1% level.\r\n      alpha_05_directional:\r\n        label: p < 0.05 and direction matches\r\n        description: Significant at 5% AND the estimate points the way the hypothesis predicts; a significant\r\n          effect the other way counts as not supported.\r"]
[6.574137, "o", "\n    x_astaverse:\r\n      kind: verdict_rule\r\n      post_hoc: true\r\n      option_support:\r\n        alpha_05_two_sided: []\r\n        alpha_01_two_sided: []\r\n        alpha_05_directional: []\r\nprior_insights:\r\n  hypothesis:\r\n    id: hypothesis\r\n    label: Hypothesis under test\r\n    claim: Among all recorded stops, Black subjects have a higher search rate than White subjects.\r\nx_astaverse:\r\n  astra_schema_shape: 0.0.13\r\n  note: ASTRA-shaped, emitted by astaverse without astra-tools. Run `astra validate` to check conformance.\r\n"]
[6.574218, "o", "--- universe sample ---\r\n"]
[6.577251, "o", "--- /app/universes/universe_000.yaml\r\n"]
[6.577655, "o", "id: universe_000\r\ndecisions:\r\n- decision_id: confounding_adjustment\r\n  option_id: unadjusted_rate_comparison\r\n- decision_id: missing_search_handling\r\n  option_id: complete_case\r\n- decision_id: race_variable_definition\r\n  option_id: subject_race_black_white\r\n- decision_id: search_outcome_definition\r\n  option_id: search_conducted\r\n- decision_id: stop_scope\r\n  option_id: all_dataset_rows\r\n- decision_id: uncertainty_dependence\r\n  option_id: iid_two_proportion\r\n"]
[6.578106, "o", "--- /app/universes/universe_001.yaml\r\n"]
[6.578454, "o", "id: universe_001\r\ndecisions:\r\n- decision_id: confounding_adjustment\r\n  option_id: covariate_adjusted_logistic\r\n- decision_id: missing_search_handling\r\n  option_id: complete_case\r\n- decision_id: race_variable_definition\r\n  option_id: subject_race_black_white\r\n- decision_id: search_outcome_definition\r\n  option_id: search_conducted\r\n- decision_id: stop_scope\r\n  option_id: all_dataset_rows\r\n- decision_id: uncertainty_dependence\r\n  option_id: iid_two_proportion\r\n"]
