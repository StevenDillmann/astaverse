[139.942713, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> def num(x):\r\n\u001b[?2004l\r\u001b[?2004h>     try: return None if x is None or not np.isfinite(x) else float(x)\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception: return None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def empty(n=0):\r\n\u001b[?2004l\r\u001b[?2004h>     return {'estimate':None,'estimate_standardized':None,'std_error':None,'std_error_standardized':None,'ci_low_standardized':None,'ci_high_standardized':None,'p_value':None,'n':int(n),'direction':'none','converged':False}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def direction(x):\r\n\u001b[?2004l\r\u001b[?2004h>     return 'none' if x is None or not np.isfinite(x) or abs(x)<1e-15 else ('positive' if x>0 else 'negative')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def binary(s):\r\n\u001b[?2004l\r\u001b[?2004h>     if pd.api.types.is_bool_dtype(s): return s.astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
