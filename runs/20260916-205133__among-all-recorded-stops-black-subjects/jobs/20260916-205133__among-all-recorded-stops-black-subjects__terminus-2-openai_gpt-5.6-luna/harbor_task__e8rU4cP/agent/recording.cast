[139.95714, "o", "    lines=['# Multiverse analysis report','',f'Evaluated **{len(rows)}** universes; **{len(good)}** converged.','', 'The parameterized `analyze` function applies all six selections for each universe. Unadjusted models estimate the Black-minus-White search-rate difference; adjusted models use logistic regression with age, sex, stop reason, department, county, and year. IID, officer-clustered, and department-clustered uncertainty are handled through the corresponding covariance calculation.','']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.957233, "o", "    if good:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.957522, "o", "        v=np.array([r['estimate_standardized'] for r in good]); lines += [f'Standardized estimate range: **{v.min():.6g}** to **{v.max():.6g}**.',f'Positive estimates: **{sum(v>0)} / {len(v)}**.','']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.957609, "o", "        for dec in sorted(good[0]['decisions']):\r\n\u001b[?2004l\r"]
[139.957699, "o", "\u001b[?2004h> "]
[139.957759, "o", "            lines.append('## '+dec)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.95786, "o", "            for opt in sorted({r['decisions'][dec] for r in good}):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.958135, "o", "                a=np.array([r['estimate_standardized'] for r in good if r['decisions'][dec]==opt]); lines.append(f'- `{opt}`: mean {a.mean():.6g}; range {a.min():.6g} to {a.max():.6g}; n={len(a)}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.958291, "o", "            lines.append('')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.958522, "o", "    lines += ['## Standardization','Unadjusted effects are expressed per SD of the race indicator and outcome; logistic effects are coefficients for a one-SD race-indicator change, with confidence intervals transformed identically.']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.958753, "o", "    open('/app/results.md','w').write('\\n'.join(lines)+'\\n'); print('wrote',len(rows),'universes; successful',len(good))\r\n\u001b[?2004l\r\u001b[?2004h> "]
