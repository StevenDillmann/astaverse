[212.452377, "i", "python3 - <<'PY'\np='/app/analysis.py'\ns=open(p).read()\ns=s.replace('from sklearn.linear_model import LogisticRegression\\n','')\nstart=s.index(\"        model=LogisticRegression(\")\nend=s.index(\"        j=1; es=\", start)\nnew=\"\"\"        X=Z.to_numpy(float)\\n        beta=np.zeros(X.shape[1], dtype=float)\\n        converged=False\\n        ridge=1e-8\\n        for _ in range(80):\\n            eta=np.clip(X@beta, -35, 35)\\n            pr=1.0/(1.0+np.exp(-eta))\\n            W=np.maximum(pr*(1-pr), 1e-8)\\n            H=X.T@(W[:,None]*X)\\n            score=X.T@(yy-pr)\\n            step=np.linalg.pinv(H + ridge*np.eye(X.shape[1]))@score\\n            beta_new=beta+step\\n            if np.max(np.abs(step)) < 1e-7:\\n                beta=beta_new; converged=True; break\\n            beta=beta_new\\n        eta=np.clip(X@beta, -35, 35)\\n        pr=1.0/(1.0+np.exp(-eta))\\n        W=np.maximum(pr*(1-pr), 1e-8)\\n        H=X.T@(W[:,None]*X)\\n        bread=np.linalg.pinv(H + ridge*np.eye(X.shape[1]))\\n        resid=yy-pr\\n        if dep=='iid_two_proportion': sevec=np.sqrt(np.maximum(np.diag(bread),0))\\n        else: sevec=cluster_se(X,resid,bread,groups)\\n        if not converged: return empty(len(yy))\\n\"\"\"\ns=s[:start]+new+s[end:]\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/analysis.py && python3 /app/analysis.py\n"]
