[676.08069, "o", "        uid,dec=load_u(path); rows.append({'universe_id':uid,'decisions':dec,**analyze(df,dec)})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.080801, "o", "    with open(OUT,'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
