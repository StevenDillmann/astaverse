[676.074736, "o", "        elif out=='person_search_only': y=pd.to_numeric(df['search_person'],errors='coerce').to_numpy(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.074988, "o", "        elif out=='vehicle_search_only': y=pd.to_numeric(df['search_vehicle'],errors='coerce').to_numpy(float)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.075346, "o", "            a=pd.to_numeric(df['search_person'],errors='coerce').to_numpy(float); b=pd.to_numeric(df['search_vehicle'],errors='coerce').to_numpy(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.075556, "o", "            y=np.where(np.isfinite(a)&np.isfinite(b),((a==1)|(b==1)).astype(float),np.nan)\r\n\u001b[?2004l\rec)\r\n \u001b[?2004h> "]
[676.075699, "o", "        if miss=='missing_as_no_search': y=np.nan_to_num(y,nan=0.)\r\n\u001b[?2004l\r"]
[676.075725, "o", "\u001b[?2004h> "]
[676.075852, "o", "        else: mask &= np.isfinite(y)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.075949, "o", "        x=black[mask]; yy=y[mask]; n=len(yy)\r\n\u001b[?2004l\rf r['decisio\u001b[?2004h> "]
[676.076133, "o", "        if n<2 or len(np.unique(x))<2 or len(np.unique(yy))<2: return empty(n)\r\n\u001b[?2004l\rn()\u001b[?2004h> "]
[676.076242, "o", "        if adj=='unadjusted_rate_comparison':\r\n\u001b[?2004l\r\r\n         \u001b[?2004h> "]
[676.076356, "o", "            nb=int(x.sum()); nw=n-nb; pb=yy[x==1].mean(); pw=yy[x==0].mean(); est=pb-pw\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.07661, "o", "            X=np.column_stack([np.ones(n),x]); resid=yy-(pw+est*x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.076866, "o", "            if dep=='iid_two_proportion': se=math.sqrt(pb*(1-pb)/nb+pw*(1-pw)/nw)\r\n\u001b[?2004l\rcovarianc\u001b[?2004h> "]
[676.077038, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.077254, "o", "                g=df['officer_id_hash'].to_numpy()[mask] if dep=='officer_cluster_robust' else df['department_name'].to_numpy()[mask]\r\n\u001b[?2004l\r_=='__main__'\u001b[?2004h> "]
[676.077367, "o", "                bread=np.linalg.inv(X.T@X); se=cluster_se(X,resid,g,bread)[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.077584, "o", "            p=2*stats.norm.sf(abs(est/se)) if se else (0. if est else 1.); sx=x.std(ddof=1); sy=yy.std(ddof=1); scale=sx/sy if sy else sx; es=est*scale; ses=abs(scale)*se\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.078699, "o", "            return {'estimate':num(est),'estimate_standardized':num(es),'std_error':num(se),'std_error_standardized':num(ses),'ci_low_standardized':num(es-1.96*ses),'ci_high_standardized':num(es+1.96*ses),'p_value':num(p),'n':n,'direction':direction(es),'converged':True}\r\n\u001b[?2004l\r\u001b[?2004h>         # Compact numeric representation of the specified adjustment covariates.\r\n\u001b[?2004l\r\u001b[?2004h>         age=pd.to_numeric(df['subject_age'],errors='coerce').to_numpy(float)[mask]\r\n\u001b[?2004l\r\u001b[?2004h>         sex=codes(df['subject_sex'])[mask]; reason=codes(df['reason_for_stop'])[mask]; dept=codes(df['department_name'])[mask]; county=codes(df['county_name'])[mask]; year=pd.to_datetime(df['date'],errors='coerce').dt.year.to_numpy(float)[mask]\r\n\u001b[?2004l\r\u001b[?2004h>         valid=np.isfinite(age)&np.isfinite(sex)&np.isfinite(reason)&np.isfinite(dept)&np.isfinite(county)&np.isfinite(year)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.078874, "o", "        x=x[valid]; yy=yy[valid]; n=len(yy); age=age[valid]; sex=sex[valid]; reason=reason[valid]; dept=dept[valid]; county=county[valid]; year=year[valid]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.07892, "o", "        if n<2 or len(np.unique(x))<2 or len(np.unique(yy))<2: return empty(n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.079077, "o", "        sx=x.std(ddof=1); xs=(x-x.mean())/sx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.079122, "o", "        def z(a): return (a-a.mean())/(a.std(ddof=1) or 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.079275, "o", "        X=np.column_stack([np.ones(n),xs,z(age),z(sex),z(reason),z(dept),z(county),z(year)])\r\n\u001b[?2004l\r\u001b[?2004h>         if dep=='iid_two_proportion': g=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.079413, "o", "        elif dep=='officer_cluster_robust': g=df['officer_id_hash'].to_numpy()[mask][valid]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.079471, "o", "        else: g=df['department_name'].to_numpy()[mask][valid]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.079516, "o", "        b,sevec,ok=logistic(X,yy,g)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.079637, "o", "        if not ok: return empty(n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.079783, "o", "        es=float(b[1]); ses=float(sevec[1]); est=es/sx; se=ses/sx; p=2*stats.norm.sf(abs(es/ses)) if ses else (0. if es else 1.)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.080063, "o", "        return {'estimate':num(est),'estimate_standardized':num(es),'std_error':num(se),'std_error_standardized':num(ses),'ci_low_standardized':num(es-1.96*ses),'ci_high_standardized':num(es+1.96*ses),'p_value':num(p),'n':n,'direction':direction(es),'converged':True}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[676.080087, "o", "    except Exception: return empty(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[676.080167, "o", "\u001b[?2004l\r\u001b[?2004h> def load_u(path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
