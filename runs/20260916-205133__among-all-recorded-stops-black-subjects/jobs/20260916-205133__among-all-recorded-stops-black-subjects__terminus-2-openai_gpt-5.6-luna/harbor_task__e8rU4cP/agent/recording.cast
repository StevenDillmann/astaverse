[111.05882, "o", "\u001b[?2004hroot@0692f40acaf5:/app# "]
[139.939608, "i", "cat > /app/analysis.py <<'PY'\nimport json, math, glob\nimport numpy as np\nimport pandas as pd\nimport yaml\nfrom scipy import stats\nfrom sklearn.linear_model import LogisticRegression\n\nDATA='/app/data.csv'; OUT='/app/universes.jsonl'\n\ndef num(x):\n    try: return None if x is None or not np.isfinite(x) else float(x)\n    except Exception: return None\n\ndef empty(n=0):\n    return {'estimate':None,'estimate_standardized':None,'std_error':None,'std_error_standardized':None,'ci_low_standardized':None,'ci_high_standardized':None,'p_value':None,'n':int(n),'direction':'none','converged':False}\n\ndef direction(x):\n    return 'none' if x is None or not np.isfinite(x) or abs(x)<1e-15 else ('positive' if x>0 else 'negative')\n\ndef binary(s):\n    if pd.api.types.is_bool_dtype(s): return s.astype(float)\n    return pd.to_numeric(s,errors='coerce')\n\ndef cluster_se(X, resid, bread, groups):\n    g=pd.Series(groups).fillna('__missing__').astype(str).to_numpy(); meat=np.zeros((X.shape[1],X.shape[1]))\n    for z in np.unique(g):\n        q=X[g==z].T @ resid[g==z]\n        meat += np.outer(q,q)\n    cov=bread @ meat @ bread\n    return np.sqrt(np.maximum(np.diag(cov),0))\n\ndef analyze(df, selections: dict[str,str]) -> dict:\n    try:\n        race=selections['race_variable_definition']; scope=selections['stop_scope']; out=selections['search_outcome_definition']; miss=selections['missing_search_handling']; adj=selections['confounding_adjustment']; dep=selections['uncertainty_dependence']\n        d=df\n        if scope=='durham_county_only': d=d[d.county_name.eq('Durham County')]\n        elif scope=='durham_police_only': d=d[d.department_name.eq('Durham Police Department')]\n        if race=='subject_race_black_white':\n            r=d.subject_race.astype('string'); keep=r.isin(['black','white']); x=r.eq('black').astype(float)\n        elif race=='raw_race_black_white':\n            r=d.raw_Race.astype('string'); keep=r.isin(['B','W']); x=r.eq('B').astype(float)\n        elif race=='subject_race_with_unknown_as_white':\n            r=d.subject_race.astype('string'); keep=r.notna(); x=r.eq('black').astype(float)\n        else: raise ValueError()\n        d=d.loc[keep].copy(); d['_black']=x.loc[keep].to_numpy()\n        if out=='search_conducted': y=binary(d.search_conducted)\n        elif out=='any_person_or_vehicle_search':\n            a,b=binary(d.search_person),binary(d.search_vehicle); y=pd.Series(np.where(a.notna()&b.notna(),((a==1)|(b==1)).astype(float),np.nan),index=d.index)\n        elif out=='person_search_only': y=binary(d.search_person)\n        elif out=='vehicle_search_only': y=binary(d.search_vehicle)\n        else: raise ValueError()\n        d['_y']=y\n        if miss=='missing_as_no_search': d['_y']=d['_y'].fillna(0.)\n        else: d=d[d._y.notna()].copy()\n        if len(d)<2 or d._black.nunique()<2 or d._y.nunique()<2: return empty(len(d))\n        x=d._black.to_numpy(float); yy=d._y.to_numpy(float); n=len(d)\n        if adj=='unadjusted_rate_comparison':\n            nb=int(x.sum()); nw=n-nb; pb=yy[x==1].mean(); pw=yy[x==0].mean(); est=pb-pw\n            X=np.column_stack([np.ones(n),x]); resid=yy-(pw+est*x)\n            if dep=='iid_two_proportion': se=math.sqrt(pb*(1-pb)/nb+pw*(1-pw)/nw); p=2*stats.norm.sf(abs(est/se)) if se else (0. if est else 1.)\n            else:\n                bread=np.linalg.inv(X.T@X)\n                groups=d.officer_id_hash if dep=='officer_cluster_robust' else d.department_name\n                se=cluster_se(X,resid,bread,groups)[1]; p=2*stats.norm.sf(abs(est/se)) if se else (0. if est else 1.)\n            sx=x.std(ddof=1); sy=yy.std(ddof=1); scale=sx/sy if sy else sx; es=est*scale; ses=abs(scale)*se\n            return {'estimate':num(est),'estimate_standardized':num(es),'std_error':num(se),'std_error_standardized':num(ses),'ci_low_standardized':num(es-1.96*ses),'ci_high_standardized':num(es+1.96*ses),'p_value':num(p),'n':n,'direction':direction(es),'converged':True}\n        if adj!='covariate_adjusted_logistic': raise ValueError()\n        d=d.copy(); d['_year']=pd.to_datetime(d.date,errors='coerce').dt.year\n        cols=['_y','_blac"]
[139.939683, "i", "k','subject_age','subject_sex','reason_for_stop','department_name','county_name','_year']\n        d=d.dropna(subset=cols).copy(); n=len(d)\n        if n<2 or d._black.nunique()<2 or d._y.nunique()<2: return empty(n)\n        sx=d._black.std(ddof=1); d['_black_std']=(d._black-d._black.mean())/sx\n        cats=['subject_sex','reason_for_stop','department_name','county_name','_year']\n        Z=pd.get_dummies(d[['subject_age']+cats],columns=cats,dtype=float)\n        Z.insert(0,'const',1.); Z.insert(1,'_black_std',d['_black_std'].to_numpy()); Z=Z.replace([np.inf,-np.inf],np.nan).dropna()\n        yy=d.loc[Z.index,'_y'].to_numpy(float); groups=d.loc[Z.index,'officer_id_hash' if dep=='officer_cluster_robust' else 'department_name'] if dep!='iid_two_proportion' else None\n        if len(np.unique(yy))<2: return empty(len(yy))\n        model=LogisticRegression(C=1e6,solver='lbfgs',max_iter=100,n_jobs=1,fit_intercept=False)\n        model.fit(Z.to_numpy(),yy); beta=model.coef_[0]; X=Z.to_numpy(); pr=model.predict_proba(X)[:,1]; W=pr*(1-pr); H=X.T@(W[:,None]*X); bread=np.linalg.pinv(H); resid=yy-pr\n        if dep=='iid_two_proportion': sevec=np.sqrt(np.maximum(np.diag(bread),0))\n        else: sevec=cluster_se(X,resid,bread,groups)\n        j=1; es=float(beta[j]); ses=float(sevec[j]); est=es/float(sx); se=ses/float(sx); p=2*stats.norm.sf(abs(es/ses)) if ses else (0. if es else 1.)\n        return {'estimate':num(est),'estimate_standardized':num(es),'std_error':num(se),'std_error_standardized':num(ses),'ci_low_standardized':num(es-1.96*ses),'ci_high_standardized':num(es+1.96*ses),'p_value':num(p),'n':len(yy),'direction':direction(es),'converged':True}\n    except Exception:\n        return empty(0)\n\ndef load_u(path):\n    with open(path) as f: u=yaml.safe_load(f)\n    return u['id'],{z['decision_id']:z['option_id'] for z in u['decisions']}\n\ndef main():\n    df=pd.read_csv(DATA,low_memory=False)\n    rows=[]\n    for pth in sorted(glob.glob('/app/universes/*.yaml')):\n        uid,dec=load_u(pth); rows.append({'universe_id':uid,'decisions':dec,**analyze(df,dec)})\n    with open(OUT,'w') as f:\n        for r in rows: f.write(json.dumps(r,allow_nan=False)+'\\n')\n    good=[r for r in rows if r['converged'] and r['estimate_standardized'] is not None]\n    lines=['# Multiverse analysis report','',f'Evaluated **{len(rows)}** universes; **{len(good)}** converged.','', 'The parameterized `analyze` function applies all six selections for each universe. Unadjusted models estimate the Black-minus-White search-rate difference; adjusted models use logistic regression with age, sex, stop reason, department, county, and year. IID, officer-clustered, and department-clustered uncertainty are handled through the corresponding covariance calculation.','']\n    if good:\n        v=np.array([r['estimate_standardized'] for r in good]); lines += [f'Standardized estimate range: **{v.min():.6g}** to **{v.max():.6g}**.',f'Positive estimates: **{sum(v>0)} / {len(v)}**.','']\n        for dec in sorted(good[0]['decisions']):\n            lines.append('## '+dec)\n            for opt in sorted({r['decisions'][dec] for r in good}):\n                a=np.array([r['estimate_standardized'] for r in good if r['decisions'][dec]==opt]); lines.append(f'- `{opt}`: mean {a.mean():.6g}; range {a.min():.6g} to {a.max():.6g}; n={len(a)}')\n            lines.append('')\n    lines += ['## Standardization','Unadjusted effects are expressed per SD of the race indicator and outcome; logistic effects are coefficients for a one-SD race-indicator change, with confidence intervals transformed identically.']\n    open('/app/results.md','w').write('\\n'.join(lines)+'\\n'); print('wrote',len(rows),'universes; successful',len(good))\nif __name__=='__main__': main()\nPY\npython3 /app/analysis.py\n"]
