[936.87924, "i", "python3 - <<'PY'\nimport json\nrows=[json.loads(x) for x in open('/app/universes.jsonl')]\nprint('records',len(rows),'unique',len({r['universe_id'] for r in rows}),'converged',sum(r['converged'] for r in rows))\nreported=[r for r in rows if r['decisions']['missing_search_handling']=='report_missing_as_separate_status']\nprint('report_missing_records',len(reported),'notes_present',sum('notes' in r for r in reported))\nprint('sample_note',reported[0].get('notes'))\nprint('all_json_valid',all(r['universe_id']==f'universe_{i:03d}' for i,r in enumerate(rows)))\nPY\n"]
