[42.421486, "o", "\u001b[?2004h> "]
[42.421679, "o", "        if adjustment != 'covariate_adjusted_logistic':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.421935, "o", "            raise ValueError('unknown adjustment')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.421962, "o", "        d = d.copy()\r\n\u001b[?2004l\rrses use th"]
[42.422088, "o", "\u001b[?2004h> "]
[42.422211, "o", "        d['_year'] = pd.to_datetime(d['date'], errors='coerce').dt.year\r\n\u001b[?2004l\r"]
[42.422231, "o", "\u001b[?2004h> "]
[42.422459, "o", "        covars = ['_y', '_black', 'subject_age', 'subject_sex', 'reason_for_stop',\r\n\u001b[?2004l\rpartment, county, and cal\u001b[?2004h> "]
[42.422704, "o", "                  'department_name', 'county_name', '_year']\r\n\u001b[?2004l\rlytic/mod"]
[42.422725, "o", "\u001b[?2004h> "]
[42.422856, "o", "        d = d.dropna(subset=covars).copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.423209, "o", "        if len(d) < 2 or d['_black'].nunique() < 2 or d['_y'].nunique() < 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.423314, "o", "            return _empty(len(d))\r\n\u001b[?2004l\r"]
[42.4234, "o", "\u001b[?2004h> "]
[42.423628, "o", "        sx = float(d['_black'].std(ddof=1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.42391, "o", "        if not np.isfinite(sx) or sx == 0:\r\n\u001b[?2004l\r"]
[42.42395, "o", "\u001b[?2004h> "]
[42.424062, "o", "            return _empty(len(d))\r\n\u001b[?2004l\rs f\u001b[?2004h> "]
[42.424366, "o", "        d['_black_std'] = (d['_black'] - d['_black'].mean()) / sx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.424832, "o", "        formula = '_y ~ _black_std + subject_age + C(subject_sex) + C(reason_for_stop) + C(department_name) + C(county_name) + C(_year)'\r\n\u001b[?2004l\r"]
[42.424887, "o", "\u001b[?2004h> "]
[42.42516, "o", "        model = sm.GLM.from_formula(formula, data=d, family=sm.families.Binomial())\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.425229, "o", ">         fit = model.fit()"]
[42.425316, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.425383, "o", "        if dependence == 'officer_cluster_robust':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.425535, "o", "            groups = d['officer_id_hash'].fillna('__missing__')\r\n\u001b[?2004l\r"]
[42.425605, "o", "\u001b[?2004h> "]
[42.425822, "o", "            fit = model.fit(cov_type='cluster', cov_kwds={'groups': groups})\r\n\u001b[?2004l\r"]
[42.425845, "o", "\u001b[?2004h> "]
[42.426023, "o", "        elif dependence == 'department_cluster_robust':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.426199, "o", "            groups = d['department_name'].fillna('__missing__')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.426393, "o", "            fit = model.fit(cov_type='cluster', cov_kwds={'groups': groups})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.426538, "o", "        elif dependence != 'iid_two_proportion':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.426726, "o", "            raise ValueError('unknown dependence')"]
[42.426847, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         term = '_black_std'\r\n\u001b[?2004l\r"]
[42.426923, "o", "\u001b[?2004h> "]
[42.427158, "o", "        eststd = float(fit.params[term]); sestd = float(fit.bse[term])\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.427194, "o", "> "]
[42.427332, "o", "        est = eststd / sx; se = sestd / sx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.427363, "o", "        pval = float(fit.pvalues[term])"]
[42.427392, "o", "\r\n\u001b[?2004l\r"]
[42.427493, "o", "\u001b[?2004h> "]
[42.427652, "o", "        lo, hi = eststd - 1.96*sestd, eststd + 1.96*sestd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.427885, "o", "        return {'estimate': _num(est), 'estimate_standardized': _num(eststd),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.428117, "o", "                'std_error': _num(se), 'std_error_standardized': _num(sestd),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.428304, "o", "                'ci_low_standardized': _num(lo), 'ci_high_standardized': _num(hi),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.428528, "o", "                'p_value': _num(pval), 'n': int(len(d)), 'direction': _direction(eststd),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.428736, "o", "                'converged': bool(getattr(fit, 'converged', True))}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.428799, "o", "    except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.428868, "o", "        return _empty(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[42.428891, "o", "> \r\n\u001b[?2004l\r"]
[42.428909, "o", "\u001b[?2004h> "]
[42.429037, "o", "def _load_universe(path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.429066, "o", "    with open(path) as f:"]
[42.429087, "o", "\r\n\u001b[?2004l\r"]
[42.429118, "o", "\u001b[?2004h> "]
[42.429216, "o", "        u = yaml.safe_load(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.429389, "o", "    decisions = {z['decision_id']: z['option_id'] for z in u['decisions']}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.429507, "o", "    return u['id'], decisions\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.42957, "o", "\u001b[?2004h> def main():\r\n\u001b[?2004l\r"]
[42.429589, "o", "\u001b[?2004h> "]
[42.42974, "o", "    df = pd.read_csv(DATA, low_memory=False)\r\n\u001b[?2004l\r"]
[42.429783, "o", "\u001b[?2004h> "]
[42.429891, "o", "    paths = sorted(glob.glob('/app/universes/*.yaml'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.429908, "o", "> "]
[42.430001, "o", "    rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.430074, "o", "    for path in paths:\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.430095, "o", "> "]
[42.430262, "o", "        uid, decisions = _load_universe(path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.430411, "o", "        result = analyze(df, decisions)\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.430436, "o", "> "]
[42.430644, "o", "        rows.append({'universe_id': uid, 'decisions': decisions, **result})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.430732, "o", "    with open(OUT, 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.430814, "o", "        for row in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.430918, "o", "            f.write(json.dumps(row, allow_nan=False) + '\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.431128, "o", "    good = [r for r in rows if r['converged'] and r['estimate_standardized'] is not None]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.431247, "o", "    lines = ['# Multiverse analysis report', '',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.4317, "o", "             'The analysis compares Black and White search rates. Race, stop scope, search outcome, missing-value handling, adjustment, and uncertainty dependence are all selected from each universe YAML and passed through the same `analyze` function.', '']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.431882, "o", "    lines += ['## Results', f'- Universes evaluated: **{len(rows)}**', f'- Successful fits: **{len(good)}**']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.431902, "o", "    if good:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.432032, "o", "        vals = np.array([r['estimate_standardized'] for r in good])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.432275, "o", "        lines += [f'- Standardized estimate range: **{vals.min():.6g}** to **{vals.max():.6g}**', f'- Positive estimates: **{sum(v > 0 for v in vals)} / {len(vals)}**', '']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.432386, "o", "        for dec in sorted({k for r in rows for k in r['decisions']}):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.432461, "o", "            groups = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.432483, "o", "            for r in good:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.432572, "o", "                opt = r['decisions'][dec]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.432708, "o", "                groups.setdefault(opt, []).append(r['estimate_standardized'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.432798, "o", "            lines.append(f'### {dec}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.432919, "o", "            for opt, a in sorted(groups.items()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.433183, "o", "                lines.append(f'- `{opt}`: mean {np.mean(a):.6g}, range {np.min(a):.6g} to {np.max(a):.6g}, n={len(a)}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.433308, "o", "            lines.append('')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.433742, "o", "        lines += ['The largest decision effects can be identified by comparing the option means above; these are descriptive specification-curve summaries, not additional hypothesis tests.', '']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.434607, "o", "    lines += ['## Method details', '- Unadjusted universes use the Black-minus-White difference in stop-level rates.', '- Adjusted universes fit logistic regression with age, sex, stop reason, department, county, and calendar year covariates.', '- IID uncertainty uses analytic/model-based standard errors; officer or department choices use clustered robust covariance.', '- Standardized estimates use a one-SD Black indicator contrast; unadjusted binary outcomes are additionally expressed in outcome-SD units.']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.434691, "o", "    with open('/app/results.md', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.434789, "o", "        f.write('\\n'.join(lines) + '\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.434942, "o", "    print(f'wrote {len(rows)} universes; successful={len(good)}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[42.43499, "o", "\u001b[?2004l\r"]
[42.435038, "o", "\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[42.435172, "o", "\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[42.436958, "o", "\u001b[?2004hroot@0692f40acaf5:/app# "]
[42.436987, "o", "python3 /app/analysis.py\r\n\u001b[?2004l\r"]
[72.494506, "i", "wc -l /app/universes.jsonl; sed -n '1,2p' /app/universes.jsonl; tail -n 3 /app/universes.jsonl; echo '--- report ---'; sed -n '1,160p' /app/results.md\n"]
[72.495109, "o", "wc -l /app/universes.jsonl; sed -n '1,2p' /app/universes.jsonl; tail -n 3 /app/universes.jsonl; echo '--- report ---'; sed -n '1,160p' /app/results.md\r\n"]
[104.792626, "i", "ps -eo pid,etime,stat,cmd | grep -E 'analysis.py|python3' | grep -v grep\n"]
[104.794826, "o", "ps -eo pid,etime,stat,cmd | grep -E 'analysis.py|python3' | grep -v grep\r\n"]
[105.691812, "i", "ls -lh /app/universes.jsonl /app/results.md 2>/dev/null || true\n"]
[105.691926, "o", "ls -lh /app/universes.jsonl /app/results.md 2>/dev/null || true\r\n"]
[110.087497, "i", "\u0003"]
[110.089763, "o", "^C"]
