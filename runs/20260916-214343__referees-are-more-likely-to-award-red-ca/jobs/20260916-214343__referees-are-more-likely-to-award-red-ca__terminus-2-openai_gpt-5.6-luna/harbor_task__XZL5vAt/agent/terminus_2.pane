   198	
   199	def _load_selections(path):
   200	    obj = yaml.safe_load(open(path))
   201	    return obj['id'], {x['decision_id']: x['option_id'] for x in obj['decisions']}
   202	
   203	def main():
   204	    df = pd.read_csv('/app/data.csv', low_memory=False)
   205	    rows = []
   206	    for path in sorted(glob.glob('/app/universes/*.yaml')):
   207	        uid, selections = _load_selections(path)
   208	        r = analyze(df, selections)
   209	        r = {'universe_id': uid, 'decisions': selections, **r}
   210	        rows.append(r)
   211	    rows.sort(key=lambda z: z['universe_id'])
