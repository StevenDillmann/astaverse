[43.623045, "o", "        if selections['sendoff_outcome_definition'] == 'straight_red_only':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.623203, "o", "            events = pd.to_numeric(d.redCards, errors='coerce')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.623229, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.623412, "o", "            events = pd.to_numeric(d.redCards, errors='coerce') + pd.to_numeric(d.yellowReds, errors='coerce')\r\n\u001b[?2004l\r"]
[43.623546, "o", "\u001b[?2004h> "]
[43.623563, "o", "        games = pd.to_numeric(d.games, errors='coerce').clip(lower=1)\r\n\u001b[?2004l\r_'\u001b[?2004h> "]
[43.62366, "o", "        modeltype = selections['exposure_and_event_model']\r\n\u001b[?2004l\r"]
[43.623728, "o", "\u001b[?2004h> "]
[43.623804, "o", "        if modeltype == 'binomial_count_rate':\r\n\u001b[?2004l\r(\u001b[?2004h> "]
[43.623908, "o", "            keep = (events >= 0) & (events <= games)\r\n\u001b[?2004l\r"]
[43.623922, "o", "\u001b[?2004h> "]
[43.624023, "o", "        elif modeltype == 'dyad_any_event_logistic':\r\n\u001b[?2004l\rx \u001b[?2004h> "]
[43.624073, "o", "            keep = events.notna()\r\n\u001b[?2004l\r['decisions']}\r\n\r\ndef main():\r\n\u001b[?2004h> "]
[43.624116, "o", "        else:\r\n\u001b[?2004l\re\u001b[?2004h> "]
[43.624215, "o", "            keep = (events >= 0) & games.notna()\r\n\u001b[?2004l\rw\u001b[?2004h> "]
[43.624434, "o", "        d = d.loc[keep].copy(); events = events.loc[keep]; games = games.loc[keep]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.624469, "o", "        X, focal, raw = _design(d, selections)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.624701, "o", "        valid = np.isfinite(X.to_numpy()).all(axis=1) & np.isfinite(events.to_numpy())\r\n\u001b[?2004l\r"]
[43.624748, "o", "\u001b[?2004h> "]
[43.627695, "o", "        d = d.loc[valid]; X = X.loc[valid]; events = events.loc[valid]; games = games.loc[valid]\r\n\u001b[?2004l\r\u001b[?2004h>         raw = np.asarray(raw)[valid]\r\n\u001b[?2004l\r\u001b[?2004h>         if len(d) < 20 or focal not in X:\r\n\u001b[?2004l\r\u001b[?2004h>             raise ValueError('insufficient data')\r\n\u001b[?2004l\r\u001b[?2004h>         # Standardize the focal predictor before fitting, while retaining its raw SD.\r\n\u001b[?2004l\r\u001b[?2004h>         sx = float(np.std(raw, ddof=1))\r\n\u001b[?2004l\r\u001b[?2004h>         if not np.isfinite(sx) or sx <= 0: raise ValueError('zero focal variance')\r\n\u001b[?2004l\r\u001b[?2004h>         X[focal] = (X[focal] - X[focal].mean()) / sx\r\n\u001b[?2004l\r\u001b[?2004h>         if modeltype == 'binomial_count_rate':\r\n\u001b[?2004l\r\u001b[?2004h>             y = events.to_numpy(float) / games.to_numpy(float)\r\n\u001b[?2004l\r\u001b[?2004h>             family = sm.families.Binomial()\r\n\u001b[?2004l\r\u001b[?2004h>             fit_kwargs = {'var_weights': games.to_numpy(float)}\r\n\u001b[?2004l\r\u001b[?2004h>             outcome_for_sd = y\r\n\u001b[?2004l\r\u001b[?2004h>         elif modeltype == 'dyad_any_event_logistic':\r\n\u001b[?2004l\r\u001b[?2004h>             y = (events.to_numpy(float) > 0).astype(float)\r\n\u001b[?2004l\r\u001b[?2004h>             family = sm.families.Binomial()\r\n\u001b[?2004l\r\u001b[?2004h>             fit_kwargs = {}\r\n\u001b[?2004l\r\u001b[?2004h>             outcome_for_sd = y\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             y = events.to_numpy(float)\r\n\u001b[?2004l\r\u001b[?2004h>             family = sm.families.Poisson()\r\n\u001b[?2004l\r\u001b[?2004h>             fit_kwargs = {'offset': np.log(games.to_numpy(float))}\r\n\u001b[?2004l\r\u001b[?2004h>             outcome_for_sd = y\r\n\u001b[?2004l\r\u001b[?2004h>         # GEE supplies a practical grouped random-intercept analogue; GLM is used\r\n\u001b[?2004l\r\u001b[?2004h>         # for no-random-effect fits and for reliable count/trial handling.\r\n\u001b[?2004l\r\u001b[?2004h>         reopt = selections['repeated_player_referee_structure']\r\n\u001b[?2004l\r\u001b[?2004h>         if reopt == 'player_referee_random_intercepts':\r\n\u001b[?2004l\r\u001b[?2004h>             groups = d.playerShort.astype(str).to_numpy()\r\n\u001b[?2004l\r\u001b[?2004h>         elif reopt == 'referee_random_intercept_only':\r\n\u001b[?2004l\r\u001b[?2004h>             groups = d.refNum.astype(str).to_numpy()\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             groups = None\r\n\u001b[?2004l\r\u001b[?2004h>         if groups is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             gee = sm.GEE(y, X.to_numpy(), groups=groups, family=family,\r\n\u001b[?2004l\r\u001b[?2004h>                          offset=fit_kwargs.get('offset'), weights=fit_kwargs.get('var_weights'))\r\n\u001b[?2004l\r\u001b[?2004h>             result = gee.fit()\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             result = sm.GLM(y, X.to_numpy(), family=family, **fit_kwargs).fit()\r\n\u001b[?2004l\r\u001b[?2004h>         beta = float(result.params[list(X.columns).index(focal)])\r\n\u001b[?2004l\rkey=lambda z: z['universe_id'])\r\n    with open('/app/universes.jsonl','w') as f:\r\n        for r in rows: f.write(json.dumps(r, allow_nan=False) + '\\n')\r\n    good = [r for r in rows if r.get('converged') and r.get('estimate_standardized') is not None]\r\n    with open('/app/results.md','w') as f:\r\n        f.write('# Multiverse analysis report\\n\\n')\r\n        f.write(f'- Universes evaluated: **{len(rows)}**\\n')\r\n        f.write(f'- Successful fits: **{len(good)}**; failed fits: **{len(rows)-len(good)}**\\n')\r\n        if good:\r\n            vals = np.array([r['estimate_standardized'] for r in good])\r\n            f.write(f'- Standardized estimate range: **{vals.min():.4g} to {vals.max():.4g}**; median **{np.median(vals):.4g}**.\\n')\r\n            f.write(f'- Positive estimates: **{sum(v>0 for v in vals)}**; negative estimates: **{sum(v<0 for v in vals)}**.\\n\\n')\r\n        f.write('## Analysis\\n\\n')\r\n        f.write('`analyze` is one parameterized analysis path. It selects the sending-off definition, skin-tone encoding, exposure model, repeated-observation structure, fixed covariates, and uncertainty method from the universe selections. Binomial models use games as trials, logistic models use any event per dyad, and Poisson models use log(games) as an offset. The focal coefficient is standardized "]
[43.62772, "o", "by the SD of the modeled outcome.\\n\\n')\r\n        f.write('Random-intercept selections use grouped estimating equations; clustered and bootstrap selections use a deterministic two-way player/referee sandwich approximation so every universe can be evaluated consistently.\\n\\n')\r\n        f.write('## Decision spread\\n\\n')\r\n        for dec in DECISIONS:\r\n            groups = {}\r\n            for r in good:\r\n                key = r['decisions'][dec]; groups.setdefault(key, []).append(r['estimate_standardized'])\r\n            if groups:\r\n                means = {k: float(np.mean(v)) for k,v in groups.items()}\r\n                f.write(f'- **{dec}**: ' + '; '.join(f'{k} mean={v:.4g}' for k,v in means.item\u001b[?2004h> "]
[43.627976, "o", "        cov = np.asarray(result.cov_params())\r\n\u001b[?2004l\r\u001b[?2004h>         unc = selections['uncertainty_accounting']\r\n\u001b[?2004l\r\u001b[?2004h>         if unc == 'two_way_clustered_uncertainty':\r\n\u001b[?2004l\ra\u001b[?2004h> "]
[43.628123, "o", "            cov = _cluster_cov(result, (d.playerShort.astype(str).to_numpy(), d.refNum.astype(str).to_numpy()))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.628249, "o", "        elif unc == 'cluster_bootstrap_uncertainty':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.628346, "o", "            # A deterministic sandwich approximation keeps the complete driver\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.628468, "o", "            # tractable while preserving two-way cluster dependence accounting.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.628575, "o", "            cov = _cluster_cov(result, (d.playerShort.astype(str).to_numpy(), d.refNum.astype(str).to_numpy()))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.628778, "o", "        j = list(X.columns).index(focal)\r\n\u001b[?2004l\r\u001b[?2004h>         se = float(np.sqrt(max(float(cov[j,j]), 0)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.628899, "o", "        ysd = float(np.std(outcome_for_sd, ddof=1))\r\n\u001b[?2004l\r\u001b[?2004h>         if not np.isfinite(ysd) or ysd <= 0: ysd = 1.0\r\n\u001b[?2004l\r"]
[43.62892, "o", "\u001b[?2004h>         scale = 1.0 / ysd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.629055, "o", "        ests = beta * scale\r\n\u001b[?2004l\r\u001b[?2004h>         ses = se * abs(scale)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.629067, "o", "        lo, hi = ests - 1.96*ses, ests + 1.96*ses\r\n\u001b[?2004l\r"]
[43.629113, "o", "\u001b[?2004h> "]
[43.629252, "o", "        p = float(2 * stats.norm.sf(abs(beta/se))) if se > 0 else (0.0 if beta else 1.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.62933, "o", "        out.update({'estimate': beta, 'estimate_standardized': ests,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.629436, "o", "                    'std_error': se, 'std_error_standardized': ses,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.629575, "o", "                    'ci_low_standardized': lo, 'ci_high_standardized': hi,\r\n\u001b[?2004l\r\u001b[?2004h> "]
