[5.439288, "o", "\r\n--- /app/universes/universe_182.yaml\r\nid: universe_182\r\ndecisions:\r\n- decision_id: exposure_and_event_model\r\n  option_id: poisson_exposure_model\r\n- decision_id: fixed_covariate_adjustment\r\n  option_id: league_position_adjusted\r\n- decision_id: repeated_player_referee_structure\r\n  option_id: player_referee_random_intercepts\r\n- decision_id: sendoff_outcome_definition\r\n  option_id: all_sendings_off\r\n- decision_id: skin_tone_measurement_and_encoding\r\n  option_id: mean_binary_threshold\r\n- decision_id: uncertainty_accounting\r\n  option_id: model_based_uncertainty\r\n\r\n\r\n--- /app/universes/universe_079.yaml\r\n"]
[5.439424, "o", "id: universe_079\r\ndecisions:\r\n- decision_id: exposure_and_event_model\r\n  option_id: binomial_count_rate\r\n- decision_id: fixed_covariate_adjustment\r\n  option_id: league_position_adjusted\r\n- decision_id: repeated_player_referee_structure\r\n  option_id: player_referee_random_intercepts\r\n- decision_id: sendoff_outcome_definition\r\n  option_id: all_sendings_off\r\n- decision_id: skin_tone_measurement_and_encoding\r\n  option_id: mean_continuous\r\n- decision_id: uncertainty_accounting\r\n  option_id: cluster_bootstrap_uncertainty\r\n\r\n"]
