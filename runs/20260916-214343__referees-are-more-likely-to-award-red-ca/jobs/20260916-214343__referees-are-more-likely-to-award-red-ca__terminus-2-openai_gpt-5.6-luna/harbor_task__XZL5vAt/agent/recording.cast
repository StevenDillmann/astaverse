[791.140071, "i", "python3 - <<'PY'\nimport json, math, os\nrequired={'universe_id','decisions','estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged'}\nrows=[json.loads(x) for x in open('/app/universes.jsonl')]\nids=[r['universe_id'] for r in rows]\nerrs=[]\nfor r in rows:\n    miss=required-set(r)\n    if miss: errs.append((r.get('universe_id'),'missing',miss))\n    for k in required-{'universe_id','decisions','direction','converged'}:\n        if r.get(k) is not None and isinstance(r[k],(int,float)) and not math.isfinite(r[k]): errs.append((r['universe_id'],k,'nonfinite'))\n    if set(r['decisions']) != {'sendoff_outcome_definition','skin_tone_measurement_and_encoding','exposure_and_event_model','repeated_player_referee_structure','fixed_covariate_adjustment','uncertainty_accounting'}: errs.append((r['universe_id'],'decisions','wrong keys'))\nprint('records=',len(rows),'unique_ids=',len(set(ids)),'errors=',len(errs),'converged=',sum(r['converged'] for r in rows))\nprint('directions=',{d:sum(r['direction']==d for r in rows) for d in ('positive','negative','none')})\nprint('sample_sizes=',min(r['n'] for r in rows),max(r['n'] for r in rows))\nif errs: print(errs[:5]); raise SystemExit(1)\nprint('VALIDATION_OK')\nPY\nprintf '\\n--- results.md ---\\n'; cat /app/results.md\n"]
