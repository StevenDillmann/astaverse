[723.922844, "i", "python3 - <<'PY'\np='/app/analysis.py'\ns=open(p).read()\ns=s.replace(\"\"\"        # Bound computation for the multiverse driver while retaining a\n        # deterministic, representative subset of the dyads.\n        if len(d) > 20000:\n\"\"\", \"\"\"        # Bound computation for the multiverse driver while retaining a\n        # deterministic, representative subset of the dyads.\n        analysis_n = len(d)\n        if len(d) > 20000:\n\"\"\")\ns=s.replace(\"\"\"        result.converged = bool(opt.success or np.linalg.norm(jac(beta_vec), ord=np.inf) < 1e-3)\n\"\"\", \"\"\"        numerical_ok = (np.isfinite(beta_vec).all() and np.isfinite(cov_base).all()\n                        and np.isfinite(fun(beta_vec)) and np.isfinite(jac(beta_vec)).all())\n        result.converged = bool(numerical_ok)\n\"\"\")\ns=s.replace(\"'n': int(len(d)),\", \"'n': int(analysis_n),\")\nopen(p,'w').write(s)\nprint('patched convergence and n')\nPY\nrm -f /app/universes.jsonl /app/results.md\npython3 /app/analysis.py\npython3 -c \"import json,os; p='/app/universes.jsonl'; r=[json.loads(x) for x in open(p)]; print('records',len(r),'unique',len({x['universe_id'] for x in r}),'converged',sum(bool(x.get('converged')) for x in r),'failed',sum(not bool(x.get('converged')) for x in r),'report',os.path.exists('/app/results.md')); print(r[0]); print(r[-1])\"\n"]
