[566.914315, "o", "   105\t            raw = raw[take]\r\n   106\t        if len(d) < 20 or focal not in X:\r\n   107\t            raise ValueError('insufficient data')\r\n   108\t        # Standardize the focal predictor before fitting, while retaining its raw SD.\r\n   109\t        sx = float(np.std(raw, ddof=1))\r\n   110\t        if not np.isfinite(sx) or sx <= 0: raise ValueError('zero focal variance')\r\n   111\t        X[focal] = (X[focal] - X[focal].mean()) / sx\r\n   112\t        if modeltype == 'binomial_count_rate':\r\n   113\t            y = events.to_numpy(float) / games.to_numpy(float)\r\n   114\t            family = sm.families.Binomial()\r\n   115\t            fit_kwargs = {'var_weights': games.to_numpy(float)}\r\n   116\t            outcome_for_sd = y\r\n   117\t        elif modeltype == 'dyad_any_event_logistic':\r\n   118\t            y = (events.to_numpy(float) > 0).astype(float)\r\n   119\t            family = sm.families.Binomial()\r\n   120\t            fit_kwargs = {}\r\n   121\t            outcome_for_sd = y\r\n   122\t        else:\r\n   123\t            y = events.to_numpy(float)\r\n   124\t            family = sm.families.Poisson()\r\n   125\t            fit_kwargs = {'offset': np.log(games.to_numpy(float))}\r\n   126\t            outcome_for_sd = y\r\n   127\t        # Fast vectorized maximum-likelihood fit. This avoids the very slow\r\n   128\t        # statsmodels IRLS/WLS loop when evaluating all universes.\r\n   129\t        from scipy.optimize import minimize\r\n   130\t        xa = X.to_numpy(dtype=float)\r\n   131\t        ya = np.asarray(y, dtype=float)\r\n   132\t        off = np.asarray(fit_kwargs.get('offset', np.zeros(len(ya))), dtype=float)\r\n   133\t        wt = np.asarray(fit_kwargs.get('var_weights', np.ones(len(ya))), dtype=float)\r\n   134\t        if modeltype == 'binomial_count_rate':\r\n   135\t            succ = events.to_numpy(dtype=float)\r\n   136\t            trials = games.to_numpy(dtype=float)\r\n   137\t            def fun(b):\r\n   138\t                z = np.clip(xa @ b, -35, 35)\r\n   139\t                return float(np.sum(trials*np.logaddexp(0,z) - succ*z))\r\n   140\t            def jac(b):\r\n   141\t                z = np.clip(xa @ b, -35, 35)\r\n   142\t                return xa.T @ (trials/(1+np.exp(-z)) - succ)\r\n   143\t            def mu(b): return 1/(1+np.exp(-np.clip(xa@b,-35,35)))\r\n   144\t        elif modeltype == 'dyad_any_event_logistic':\r\n   145\t            def fun(b):\r\n   146\t                z = np.clip(xa @ b, -35, 35)\r\n   147\t                return float(np.sum(np.logaddexp(0,z) - ya*z))\r\n   148\t            def jac(b):\r\n   149\t                z = np.clip(xa @ b, -35, 35)\r\n   150\t                return xa.T @ (1/(1+np.exp(-z)) - ya)\r\n   151\t            def mu(b): return 1/(1+np.exp(-np.clip(xa@b,-35,35)))\r\n   152\t        else:\r\n   153\t            def fun(b):\r\n   154\t                z = np.clip(xa @ b + off, -35, 35)\r\n   155\t                return float(np.sum(np.exp(z) - ya*z))\r\n   156\t            def jac(b):\r\n   157\t                z = np.clip(xa @ b + off, -35, 35)\r\n   158\t                return xa.T @ (np.exp(z) - ya)\r\n   159\t            def mu(b): return np.exp(np.clip(xa@b+off,-35,35))\r\n   160\t        opt = minimize(fun, np.zeros(xa.shape[1]), jac=jac, method='L-BFGS-B',\r\n   161\t                       options={'maxiter': 35, 'ftol': 1e-7, 'gtol': 1e-4, 'maxls': 10})\r\n   162\t        beta_vec = np.asarray(opt.x, dtype=float)\r\n   163\t        m = np.asarray(mu(beta_vec), dtype=float)\r\n   164\t        if modeltype in ('binomial_count_rate','dyad_any_event_logistic'):\r\n   165\t            ww = (trials if modeltype == 'binomial_count_rate' else np.ones(len(m))) * m*(1-m)\r\n   166\t        else:\r\n   167\t            ww = m\r\n   168\t        hess = xa.T @ (ww[:,None] * xa)\r\n   169\t        cov_base = np.linalg.pinv(hess + np.eye(hess.shape[0])*1e-8)\r\n   170\t        class _FastResult:\r\n"]
