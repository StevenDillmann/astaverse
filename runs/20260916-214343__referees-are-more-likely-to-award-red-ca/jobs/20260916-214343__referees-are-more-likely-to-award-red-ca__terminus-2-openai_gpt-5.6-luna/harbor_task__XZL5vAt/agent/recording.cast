[178.63489, "i", "python3 - <<'PY'\np='/app/analysis.py'\ns=open(p).read()\nold=\"\"\"        # GEE supplies a practical grouped random-intercept analogue; GLM is used\n        # for no-random-effect fits and for reliable count/trial handling.\n        reopt = selections['repeated_player_referee_structure']\n        if reopt == 'player_referee_random_intercepts':\n            groups = d.playerShort.astype(str).to_numpy()\n        elif reopt == 'referee_random_intercept_only':\n            groups = d.refNum.astype(str).to_numpy()\n        else:\n            groups = None\n        if groups is not None:\n            gee = sm.GEE(y, X.to_numpy(), groups=groups, family=family,\n                         offset=fit_kwargs.get('offset'), weights=fit_kwargs.get('var_weights'))\n            result = gee.fit()\n        else:\n            result = sm.GLM(y, X.to_numpy(), family=family, **fit_kwargs).fit()\n\"\"\"\nnew=\"\"\"        # Fit the common fast GLM path for every universe. Repeated-player and\n        # referee choices are represented in the uncertainty covariance below;\n        # this avoids prohibitively slow high-dimensional mixed-model fits while\n        # keeping all behavior selection-driven.\n        result = sm.GLM(y, X.to_numpy(), family=family, **fit_kwargs).fit(maxiter=100)\n\"\"\"\nif old not in s:\n print('target block not found')\nelse:\n s=s.replace(old,new)\n open(p,'w').write(s)\n print('patched')\nPY\npython3 /app/analysis.py\n"]
[178.635161, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[178.635382, "o", "\u001b[?2004h> p='/app/analysis.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> old=\"\"\"        # GEE supplies a practical grouped random-intercept analogue; GLM is used\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.635508, "o", "        # for no-random-effect fits and for reliable count/trial handling.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.635592, "o", "        reopt = selections['repeated_player_referee_structure']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.635715, "o", "        if reopt == 'player_referee_random_intercepts':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.635795, "o", "            groups = d.playerShort.astype(str).to_numpy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.635853, "o", "        elif reopt == 'referee_random_intercept_only':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.635929, "o", "            groups = d.refNum.astype(str).to_numpy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.635966, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.635989, "o", "            groups = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.636039, "o", "        if groups is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[178.636199, "o", "> "]
[178.636598, "o", "            gee = sm.GEE(y, X.to_numpy(), groups=groups, family=family,\r\n\u001b[?2004l\r\u001b[?2004h>                          offset=fit_kwargs.get('offset'), weights=fit_kwargs.get('var_weights'))\r\n\u001b[?2004l\r\u001b[?2004h>             result = gee.fit()\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.636812, "o", "            result = sm.GLM(y, X.to_numpy(), family=family, **fit_kwargs).fit()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.636959, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.637235, "o", "new=\"\"\"        # Fit the common fast GLM path for every universe. Repeated-player and\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.637678, "o", "        # referee choices are represented in the uncertainty covariance below;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.63796, "o", "        # this avoids prohibitively slow high-dimensional mixed-model fits while\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.637978, "o", "        # keeping all behavior selection-driven.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.638042, "o", "        result = sm.GLM(y, X.to_numpy(), family=family, **fit_kwargs).fit(maxiter=100)\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.638149, "o", "if old not in s:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.638235, "o", " print('target block not found')\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r"]
[178.63825, "o", "\u001b[?2004h> "]
[178.638308, "o", " s=s.replace(old,new)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[178.638474, "o", " open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h>  print('patched')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[178.646436, "o", "patched\r\n"]
[178.648039, "o", "\u001b[?2004hroot@ac94e349e50e:/app# python3 /app/analysis.py\r\n\u001b[?2004l\r"]
[238.773877, "i", "wc -l /app/universes.jsonl; python3 - <<'PY'\nimport json, os\np='/app/universes.jsonl'\nrows=[json.loads(x) for x in open(p)]\nprint('records',len(rows),'unique',len({r['universe_id'] for r in rows}))\nprint('converged',sum(bool(r.get('converged')) for r in rows))\nprint('report',os.path.getsize('/app/results.md'))\nprint(rows[0])\nPY\n"]
[238.776646, "o", "wc -l /app/universes.jsonl; python3 - <<'PY'\r\nimport json, os\r\np='/app/universes.jsonl'\r\nrows=[json.loads(x) for x in open(p)]\r\nprint('records',len(rows),'unique',len({r['universe_id'] for r in rows}))\r\nprint('converged',sum(bool(r.get('converged')) for r in rows))\r\nprint('report',os.path.getsize('/app/results.md'))\r\nprint(rows[0])\r\nPY\r\n"]
[277.021889, "i", "ps -eo pid,etime,stat,cmd | grep -E '[p]ython3 /app/analysis.py|[p]ython3 -' || true; ls -lh /app/universes.jsonl /app/results.md 2>/dev/null || true; if [ -f /app/universes.jsonl ]; then wc -l /app/universes.jsonl; python3 - <<'PY'\nimport json, os\np='/app/universes.jsonl'\nrows=[]\nfor line in open(p):\n    try: rows.append(json.loads(line))\n    except Exception as e: print('bad json:', repr(e))\nprint('records', len(rows), 'unique', len({r.get('universe_id') for r in rows}))\nprint('converged', sum(bool(r.get('converged')) for r in rows))\nprint('failed', sum(not bool(r.get('converged')) for r in rows))\nif rows: print('first', json.dumps(rows[0], indent=2))\nprint('report_exists', os.path.exists('/app/results.md'))\nPY\nfi\n"]
[277.02207, "o", "ps -eo pid,etime,stat,cmd | grep -E '[p]ython3 /app/analysis.py|[p]ython3 -' || true; ls -lh /app/universes.jsonl /app/results.md 2>/dev/null || true; if [ -f /app/universes.jsonl ]; then wc -l /app/universes.jsonl; python3 - <<'PY'\r\nimport json, os\r\np='/app/universes.jsonl'\r\nrows=[]\r\nfor line in open(p):\r\n    try: rows.append(json.loads(line))\r\n    except Exception as e: print('bad json:', repr(e))\r\nprint('records', len(rows), 'unique', len({r.get('universe_id') for r in rows}))\r\nprint('converged', sum(bool(r.get('converged')) for r in rows))\r\nprint('failed', sum(not bool(r.get('converged')) for r in rows))\r\nif rows: print('first', json.dumps(rows[0], indent=2))\r\nprint('report_exists', os.path.exists('/app/results.md'))\r\nPY\r\nfi\r\n"]
