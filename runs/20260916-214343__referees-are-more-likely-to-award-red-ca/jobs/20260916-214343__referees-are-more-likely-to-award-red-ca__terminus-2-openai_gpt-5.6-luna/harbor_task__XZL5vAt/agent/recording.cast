[650.61242, "o", "   165\t            ww = (trials if modeltype == 'binomial_count_rate' else np.ones(len(m))) * m*(1-m)\r\n   166\t        else:\r\n   167\t            ww = m\r\n   168\t        hess = xa.T @ (ww[:,None] * xa)\r\n   169\t        cov_base = np.linalg.pinv(hess + np.eye(hess.shape[0])*1e-8)\r\n   170\t        class _FastResult:\r\n   171\t            pass\r\n   172\t        result = _FastResult()\r\n   173\t        result.params = beta_vec\r\n   174\t        result._cov = cov_base\r\n   175\t        result.converged = bool(opt.success or np.linalg.norm(jac(beta_vec), ord=np.inf) < 1e-3)\r\n   176\t        result.cov_params = lambda: result._cov\r\n   177\t        cov = cov_base\r\n   178\t        j = list(X.columns).index(focal)\r\n   179\t        se = float(np.sqrt(max(float(cov[j,j]), 0)))\r\n   180\t        ysd = float(np.std(outcome_for_sd, ddof=1))\r\n   181\t        if not np.isfinite(ysd) or ysd <= 0: ysd = 1.0\r\n   182\t        scale = 1.0 / ysd\r\n   183\t        ests = beta * scale\r\n   184\t        ses = se * abs(scale)\r\n   185\t        lo, hi = ests - 1.96*ses, ests + 1.96*ses\r\n   186\t        p = float(2 * stats.norm.sf(abs(beta/se))) if se > 0 else (0.0 if beta else 1.0)\r\n   187\t        out.update({'estimate': beta, 'estimate_standardized': ests,\r\n   188\t                    'std_error': se, 'std_error_standardized': ses,\r\n   189\t                    'ci_low_standardized': lo, 'ci_high_standardized': hi,\r\n   190\t                    'p_value': p, 'n': int(len(d)),\r\n   191\t                    'direction': 'positive' if beta > 0 else ('negative' if beta < 0 else 'none'),\r\n   192\t                    'converged': bool(getattr(result, 'converged', True))})\r\n   193\t        return out\r\n   194\t    except Exception as e:\r\n   195\t        out['n'] = int(len(df)) if hasattr(df, '__len__') else None\r\n   196\t        out['notes'] = 'fit failed: ' + str(e)[:180]\r\n   197\t        return out\r\n   198\t\r\n   199\tdef _load_selections(path):\r\n   200\t    obj = yaml.safe_load(open(path))\r\n   201\t    return obj['id'], {x['decision_id']: x['option_id'] for x in obj['decisions']}\r\n   202\t\r\n   203\tdef main():\r\n   204\t    df = pd.read_csv('/app/data.csv', low_memory=False)\r\n   205\t    rows = []\r\n   206\t    for path in sorted(glob.glob('/app/universes/*.yaml')):\r\n   207\t        uid, selections = _load_selections(path)\r\n   208\t        r = analyze(df, selections)\r\n   209\t        r = {'universe_id': uid, 'decisions': selections, **r}\r\n   210\t        rows.append(r)\r\n   211\t    rows.sort(key=lambda z: z['universe_id'])\r\n   212\t    with open('/app/universes.jsonl','w') as f:\r\n   213\t        for r in rows: f.write(json.dumps(r, allow_nan=False) + '\\n')\r\n   214\t    good = [r for r in rows if r.get('converged') and r.get('estimate_standardized') is not None]\r\n   215\t    with open('/app/results.md','w') as f:\r\n"]
