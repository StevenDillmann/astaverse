[651.133505, "i", "python3 - <<'PY'\np='/app/analysis.py'\ns=open(p).read()\nneedle=\"\"\"        j = list(X.columns).index(focal)\n        se = float(np.sqrt(max(float(cov[j,j]), 0)))\n\"\"\"\nreplacement=\"\"\"        j = list(X.columns).index(focal)\n        beta = float(beta_vec[j])\n        se = float(np.sqrt(max(float(cov[j,j]), 0)))\n\"\"\"\nif needle not in s:\n    raise SystemExit('reporting block not found')\ns=s.replace(needle,replacement,1)\nopen(p,'w').write(s)\nprint('patched beta reference')\nPY\nrm -f /app/universes.jsonl /app/results.md\npython3 /app/analysis.py\npython3 -c \"import json,os; p='/app/universes.jsonl'; r=[json.loads(x) for x in open(p)]; print('records',len(r),'unique',len({x['universe_id'] for x in r}),'converged',sum(bool(x.get('converged')) for x in r),'failed',sum(not bool(x.get('converged')) for x in r),'report',os.path.exists('/app/results.md')); print(r[0])\"\n"]
