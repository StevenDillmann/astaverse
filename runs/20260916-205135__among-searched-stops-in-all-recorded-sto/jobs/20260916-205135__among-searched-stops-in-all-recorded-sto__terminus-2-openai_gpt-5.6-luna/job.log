Sending keys: ["python3 - <<'PY'\nimport json\nimport pandas as pd\nrows = [json.loads(x) for x in open('/app/universes.jsonl')]\ndf = pd.DataFrame(rows)\nok = df[df['converged']].copy()\nlines = []\nlines.append('# Multiverse analysis report')\nlines.append('')\nlines.append('- Universes evaluated: **{}**; successful fits: **{}**; failed fits: **{}**.'.format(len(df), len(ok), len(df)-len(ok)))\nif len(ok):\n    emin = ok['estimate_standardized'].min()\n    emax = ok['estimate_standardized'].max()\n    emed = ok['estimate_standardized'].median()\n    nmin = int(ok['n'].min())\n    nmax = int(ok['n'].max())\n    pos = int((ok['estimate_standardized'] > 0).sum())\n    neg = int((ok['estimate_standardized'] < 0).sum())\n    lines.append('- Standardized estimate range: **{:.4f}** to **{:.4f}** (median **{:.4f}**).'.format(emin, emax, emed))\n    lines.append('- Sample-size range: **{}** to **{}**.'.format(nmin, nmax))\n    lines.append('- Positive estimates: **{}**; negative estimates: **{}**.'.format(pos, neg))\nlines.extend(['', '## What `analyze` does', '', '`analyze(df, selections)` applies every universe selection through one shared code path. It first selects the race population, searched-stop definition, contraband-hit coding, and date scope. It then computes either an unadjusted Black-minus-comparison hit-rate difference, a race-only logistic model, or an adjusted logistic model with subject age, sex, stop reason, department, and calendar year. Uncertainty is treated as independent, officer-clustered, or department-clustered according to the selected dependence option. The focal binary race predictor and binary outcome are standardized so estimates are comparable across model specifications; confidence intervals and two-sided p-values are reported on that standardized scale. Failed or unidentified fits are represented with null statistics and `converged: false`.', '', '## Decision sensitivity', ''])\n\ndecisions = ['race_analytic_sample', 'searched_stop_definition', 'contraband_hit_coding', 'date_scope', 'race_comparison_model', 'dependence_and_uncertainty']\nfor col in decisions:\n    lines.append('### ' + col)\n    lines.append('')\n    tmp = ok.copy()\n    tmp['_option'] = tmp['decisions'].map(lambda x: x[col])\n    summaries = []\n    for opt, g in tmp.groupby('_option'):\n        mean = g['estimate_standardized'].mean()\n        lo = g['estimate_standardized'].min()\n        hi = g['estimate_standardized'].max()\n        summaries.append((hi-lo, opt, mean, lo, hi, len(g)))\n    for spread, opt, mean, lo, hi, count in sorted(summaries, reverse=True):\n        lines.append('- `{}`: mean **{:.4f}**, range **{:.4f}** to **{:.4f}**, n={}.'.format(opt, mean, lo, hi, count))\n    lines.append('')\n\nif len(ok):\n    movement = []\n    for col in decisions:\n        tmp = ok['decisions'].map(lambda x: x[col])\n        means = ok.assign(_option=tmp).groupby('_option')['estimate_standardized'].mean()\n        movement.append((means.max()-means.min(), col))\n    movement.sort(reverse=True)\n    ordered = ', '.join('{} ({:.4f})'.format(c, s) for s, c in movement)\n    lines.append('Across option-group means, the largest estimate movements were: **{}**. Outcome and searched-stop definitions alter the denominator and hit coding; model choice changes the estimand and adjustment set; clustering mainly changes standard errors and p-values rather than point estimates.'.format(ordered))\n\nopen('/app/results.md', 'w').write('\\n'.join(lines) + '\\n')\nprint('wrote /app/results.md')\nprint('\\n'.join(lines))\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
