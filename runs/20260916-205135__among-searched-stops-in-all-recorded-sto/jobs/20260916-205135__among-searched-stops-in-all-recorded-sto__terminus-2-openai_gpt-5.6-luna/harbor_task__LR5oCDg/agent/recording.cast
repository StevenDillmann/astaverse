[34.293568, "o", "            est = float(d.loc[b, '_hit'].mean() - d.loc[~b, '_hit'].mean())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29365, "o", "            se = _se_diff(d['_hit'], b, groups)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293753, "o", "            if not np.isfinite(se): return _result_null(len(d))\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.293773, "o", "> "]
[34.293959, "o", "            # Standardize the binary focal predictor; binary outcome is standardized too.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294156, "o", "            xs = float(np.sqrt(b.mean() * (1 - b.mean())))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294371, "o", "            ys = float(np.sqrt(d['_hit'].mean() * (1 - d['_hit'].mean())))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294512, "o", "            scale = xs / ys if ys > 0 else xs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294633, "o", "            es, ses = est * scale, abs(scale) * se\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.29473, "o", "            converged = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.294906, "o", "        elif modelopt in ('race_only_logistic', 'adjusted_logistic'):\r\n\u001b[?2004l\r"]
