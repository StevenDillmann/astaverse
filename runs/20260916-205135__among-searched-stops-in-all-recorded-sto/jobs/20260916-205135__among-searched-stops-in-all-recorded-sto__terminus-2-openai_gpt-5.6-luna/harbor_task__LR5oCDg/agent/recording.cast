[94.385803, "o", "rows=[json.loads(x) for x in open(p)]\r\n\u001b[?2004l\r\u001b[?2004h> print('lines',len(rows),'unique_ids',len({r['universe_id'] for r in rows}))\r\n\u001b[?2004l\r\u001b[?2004h> print('converged',sum(r['converged'] for r in rows),'failed',sum(not r['converged'] for r in rows))\r\n\u001b[?2004l\r\u001b[?2004h> print('keys',sorted(rows[0]))\r\n\u001b[?2004l\r\u001b[?2004h> print('sample',json.dumps(rows[0], indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> PY"]
[96.295663, "i", "python3 - <<'PY'\nimport json, pandas as pd, numpy as np\nrows=[json.loads(x) for x in open('/app/universes.jsonl')]\ndf=pd.DataFrame(rows)\nok=df[df.converged]\nlines=[]\nlines.append('# Multiverse analysis report\\n')\nlines.append(f'- Universes evaluated: **{len(df)}**; successful fits: **{len(ok)}**; failed fits: **{len(df)-len(ok)}**.')\nif len(ok):\n    lines.append(f'- Standardized estimate range: **{ok.estimate_standardized.min():.4f}** to **{ok.estimate_standardized.max():.4f}** (median **{ok.estimate_standardized.median():.4f}**).')\n    lines.append(f'- Sample-size range: **{int(ok.n.min())}** to **{int(ok.n.max())}**.')\n    lines.append(f'- Positive estimates: **{int((ok.estimate_standardized>0).sum())}**; negative estimates: **{int((ok.estimate_standardized<0).sum())}**.')\nlines.append('\\n## Analysis\\n')\nlines.append('`analyze(df, selections)` first selects the Black/White analytic population, searched-stop definition, contraband-hit coding, and date scope specified by the universe. It then estimates either the unadjusted Black-minus-comparison hit-rate difference, a race-only logistic coefficient, or an adjusted logistic coefficient including age, sex, stop reason, department, and calendar year. Independent, officer-clustered, and department-clustered uncertainty are supported. The focal binary race predictor and binary outcome are converted to comparable standardized units; confidence intervals and two-sided normal p-values are reported on that scale. Failed or non-identifiable fits are emitted with null statistics and `converged: false`.')\nlines.append('\\n## Decision sensitivity\\n')\nfor col in ['race_analytic_sample','searched_stop_definition','contraband_hit_coding','date_scope','race_comparison_model','dependence_and_uncertainty']:\n    vals=[]\n    for opt,g in df[df.converged].groupby(df[df.converged].decisions.map(lambda x:x[col])):\n        vals.append((opt, g.estimate_standardized.mean(), g.estimate_standardized.min(), g.estimate_standardized.max(), len(g)))\n    lines.append(f'### {col}\\n')\n    for opt,mean,mi,ma,n in sorted(vals): lines.append(f'- `{opt}`: mean {mean:.4f}, range {mi:.4f} to {ma:.4f}, n={n}')\n    lines.append('')\nlines.append('The largest movements are identified by comparing the ranges and means above; in particular, outcome/search definitions and the choice between unadjusted and adjusted models can change both the estimand and the available sample, while clustering primarily changes uncertainty rather than the point estimate.')\nopen('/app/results.md','w').write('\\n'.join(lines)+'\\n')\nprint(open('/app/results.md').read())\nPY\n"]
