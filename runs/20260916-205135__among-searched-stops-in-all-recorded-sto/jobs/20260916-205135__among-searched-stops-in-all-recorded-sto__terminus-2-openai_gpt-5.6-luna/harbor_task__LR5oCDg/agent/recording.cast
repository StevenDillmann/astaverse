[94.383896, "i", "python3 - <<'PY'\nimport json, collections, os\np='/app/universes.jsonl'\nrows=[json.loads(x) for x in open(p)]\nprint('lines',len(rows),'unique_ids',len({r['universe_id'] for r in rows}))\nprint('converged',sum(r['converged'] for r in rows),'failed',sum(not r['converged'] for r in rows))\nprint('keys',sorted(rows[0]))\nprint('sample',json.dumps(rows[0], indent=2))\nPY"]
