[34.301357, "o", "\u001b[?2004h> "]
[34.301492, "o", "                'p_value': p, 'n': int(len(d)), 'direction': direction,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.30163, "o", "                'converged': converged}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.30166, "o", "    except Exception:\r\n\u001b[?2004l\r"]
[34.301708, "o", "\u001b[?2004h> "]
[34.30183, "o", "        return _result_null(len(df))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.301865, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.30198, "o", "def _load_selection(path):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.302188, "o", "    with open(path) as f: u = yaml.safe_load(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.302246, "o", "> "]
[34.302468, "o", "    return u['id'], {x['decision_id']: x['option_id'] for x in u['decisions']}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[34.302533, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main():\r\n\u001b[?2004l\r"]
[34.302593, "o", "\u001b[?2004h> "]
[34.30275, "o", "    df = pd.read_csv('/app/data.csv', low_memory=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.302797, "o", "    rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.302958, "o", "    for path in sorted(glob.glob('/app/universes/*.yaml')):\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.303, "o", "> "]
[34.303043, "o", "        uid, selections = _load_selection(path)\r\n\u001b[?2004l\r"]
[34.303151, "o", "\u001b[?2004h> "]
[34.303233, "o", "        out = analyze(df, selections)\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.303291, "o", "> "]
[34.303451, "o", "        rows.append({'universe_id': uid, 'decisions': selections, **out})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.303583, "o", "    with open('/app/universes.jsonl', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.303607, "o", "> "]
[34.303879, "o", "        for row in rows: f.write(json.dumps(row, allow_nan=False) + '\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.303987, "o", "    print(f'wrote {len(rows)} universes')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[34.304013, "o", "\u001b[?2004h> "]
[34.304184, "o", "if __name__ == '__main__': main()\r\n\u001b[?2004l\r\u001b[?2004h"]
