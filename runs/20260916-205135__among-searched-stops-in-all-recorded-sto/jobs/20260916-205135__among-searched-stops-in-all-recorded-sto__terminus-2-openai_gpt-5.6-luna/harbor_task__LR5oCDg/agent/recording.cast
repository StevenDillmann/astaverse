[166.416042, "o", "{\r\n  \"universe_id\": \"universe_000\",\r\n  \"decisions\": {\r\n    \"contraband_hit_coding\": \"direct_contraband_complete_case\",\r\n    \"date_scope\": \"all_supplied_rows\",\r\n    \"dependence_and_uncertainty\": \"independent_stops\",\r\n    \"race_analytic_sample\": \"black_white_only\",\r\n    \"race_comparison_model\": \"unadjusted_rate_comparison\",\r\n    \"searched_stop_definition\": \"search_conducted\"\r\n  },\r\n  \"estimate\": 0.001520837758773319,\r\n  \"estimate_standardized\": 0.001329237367797243,\r\n  \"std_error\": 0.008312420647781892,\r\n  \"std_error_standardized\": 0.0072651931990386194,\r\n  \"ci_low_standardized\": -0.01291054130231845,\r\n  \"ci_high_standardized\": 0.015569016037912936,\r\n  \"p_value\": 0.8548296611861215,\r\n  \"n\": 18904,\r\n  \"direction\": \"positive\",\r\n  \"converged\": true\r\n}\r\n"]
