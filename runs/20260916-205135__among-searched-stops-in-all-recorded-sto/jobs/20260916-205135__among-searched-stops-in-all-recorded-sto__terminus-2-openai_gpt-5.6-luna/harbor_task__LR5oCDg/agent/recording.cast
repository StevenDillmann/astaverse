[34.298349, "o", "                g = d.loc[dat.index, 'officer_id_hash' if dep == 'cluster_officer' else 'department_name'].fillna('__MISSING__')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.298478, "o", "                kwargs = {'cov_type': 'cluster', 'cov_kwds': {'groups': g}}\r\n\u001b[?2004l\r"]
[34.298564, "o", "\u001b[?2004h> "]
[34.298707, "o", "            fit = sm.GLM(y, X, family=sm.families.Binomial()).fit(**kwargs)\r\n\u001b[?2004l\r"]
[34.298744, "o", "\u001b[?2004h"]
[34.298778, "o", "> "]
[34.298909, "o", "            if 'black' not in fit.params or not np.isfinite(fit.params['black']):\r\n\u001b[?2004l\r\u001b[?2004h"]
