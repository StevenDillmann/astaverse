[34.297469, "o", "\u001b[?2004h> "]
[34.29773, "o", "            X = sm.add_constant(dat.drop(columns=['_hit']), has_constant='add').astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.297823, "o", "            y = dat['_hit'].astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.297948, "o", "            kwargs = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
