[168.248483, "i", "python3 - <<'PY'\nimport json, pandas as pd\nrows=[json.loads(x) for x in open('/app/universes.jsonl')]\ndf=pd.DataFrame(rows)\nok=df[df.converged].copy()\nlines=['# Multiverse analysis report','',f'- Universes evaluated: **{len(df)}**; successful fits: **{len(ok)}**; failed fits: **{len(df)-len(ok)}**.']\nif len(ok):\n    lines += [f'- Standardized estimate range: **{ok.estimate_standardized.min():.4f}** to **{ok.estimate_standardized.max():.4f}** (median **{ok.estimate_standardized.median():.4f}**).', f'- Sample-size range: **{int(ok.n.min())}** to **{int(ok.n.max())}**.', f'- Positive estimates: **{int((ok.estimate_standardized>0).sum())}**; negative estimates: **{int((ok.estimate_standardized<0).sum())**}.']\nlines += ['', '## Analysis', '', '`analyze(df, selections)` applies every universe selection through one shared code path. It selects the race population, searched-stop definition, contraband outcome coding, and date scope. It then computes either an unadjusted Black-minus-comparison hit-rate difference, a race-only logistic model, or an adjusted logistic model with age, sex, stop reason, department, and calendar year. Uncertainty is independent, officer-clustered, or department-clustered as selected. The binary race predictor and binary outcome are standardized to make estimates comparable across model specifications; confidence intervals and p-values are reported on the standardized scale. Failed or unidentified fits are represented with null statistics and `converged: false`.', '', '## Decision sensitivity', '']\nfor col in ['race_analytic_sample','searched_stop_definition','contraband_hit_coding','date_scope','race_comparison_model','dependence_and_uncertainty']:\n    lines += [f'### {col}', '']\n    if len(ok):\n        tmp=ok.copy(); tmp['_option']=tmp.decisions.map(lambda x:x[col])\n        for opt,g in tmp.groupby('_option'):\n            lines.append(f'- `{opt}`: mean {g.estimate_standardized.mean():.4f}, range {g.estimate_standardized.min():.4f} to {g.estimate_standardized.max():.4f}, n={len(g)}')\n    lines.append('')\nlines += ['The largest movements can be identified from the ranges and group means above. Outcome and searched-stop definitions alter the selected denominator and outcome coding, while the model choice can change the estimand and adjustment set. Clustering primarily changes standard errors and p-values rather than point estimates.']\nopen('/app/results.md','w').write('\\n'.join(lines)+'\\n')\nprint(open('/app/results.md').read())\nPY\n"]
