[34.292034, "o", "\u001b[?2004h> "]
[34.292288, "o", "        if dep == 'cluster_officer': groups = d['officer_id_hash']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.292652, "o", "        elif dep == 'cluster_department': groups = d['department_name']\r\n\u001b[?2004l\rthon3 -m"]
[34.292708, "o", "\u001b[?2004h> "]
[34.293032, "o", "        elif dep != 'independent_stops': return _result_null(len(d))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293193, "o", "        if modelopt == 'unadjusted_rate_comparison':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.293299, "o", "            b = d['_black'].astype(bool)\r\n\u001b[?2004l\r\u001b[?2004h> "]
