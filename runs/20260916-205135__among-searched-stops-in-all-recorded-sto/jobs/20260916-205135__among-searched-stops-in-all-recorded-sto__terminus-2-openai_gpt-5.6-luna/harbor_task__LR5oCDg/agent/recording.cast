[34.299221, "o", "            se = float(fit.bse['black'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.299406, "o", "            xs = float(np.sqrt(dat['black'].mean() * (1 - dat['black'].mean())))\r\n\u001b[?2004l\r\u001b[?2004h> "]
