[34.299899, "o", "            return _result_null(len(d))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.299986, "o", "        if not np.isfinite(es) or not np.isfinite(ses):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.300082, "o", "            return _result_null(len(d))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.300299, "o", "        p = float(2 * norm.sf(abs(es / ses))) if ses > 0 else (0.0 if es != 0 else 1.0)"]
[34.300409, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.300522, "o", "        lo, hi = float(es - 1.96 * ses), float(es + 1.96 * ses)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.30066, "o", "        direction = 'positive' if est > 0 else ('negative' if est < 0 else 'none')\r\n"]
[34.300687, "o", "\u001b[?2004l\r"]
[34.300772, "o", "\u001b[?2004h> "]
[34.3009, "o", "        return {'estimate': float(est), 'estimate_standardized': float(es),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.301107, "o", "                'std_error': float(se), 'std_error_standardized': float(ses),\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.301183, "o", "> "]
