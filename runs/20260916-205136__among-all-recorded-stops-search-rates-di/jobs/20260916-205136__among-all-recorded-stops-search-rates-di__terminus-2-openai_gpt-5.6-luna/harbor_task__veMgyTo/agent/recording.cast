[133.285022, "i", "python3 - <<'PY'\np='/app/analysis.py'\ns=open(p).read()\ns=s.replace('from sklearn.linear_model import LogisticRegression\\n','import statsmodels.api as sm\\n')\nold=\"\"\"        fit=LogisticRegression(solver='lbfgs',max_iter=250,C=1e6,fit_intercept=True)\n        with warnings.catch_warnings():\n            warnings.simplefilter('ignore'); fit.fit(Xn,y)\n        beta=np.r_[fit.intercept_[0],fit.coef_[0]]\n        Xa=np.c_[np.ones(n),Xn]\n\"\"\"\nnew=\"\"\"        Xa=np.c_[np.ones(n),Xn]\n        with warnings.catch_warnings():\n            warnings.simplefilter('ignore')\n            fit=sm.GLM(y, Xa, family=sm.families.Binomial()).fit(maxiter=100, disp=0)\n        beta=np.asarray(fit.params, dtype=float)\n\"\"\"\nif old not in s:\n    raise SystemExit('target fit block not found')\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY\npython3 /app/analysis.py\nwc -l /app/universes.jsonl\npython3 - <<'PY'\nimport json, collections\np='/app/universes.jsonl'\nxs=[json.loads(x) for x in open(p)]\nprint('records',len(xs),'unique',len({x['universe_id'] for x in xs}),'converged',sum(x['converged'] for x in xs),'null_estimates',sum(x['estimate'] is None for x in xs))\nprint('models',collections.Counter(x['decisions']['race_adjustment_model'] for x in xs))\nprint('first',xs[0])\nprint('last',xs[-1])\nPY\ncat /app/results.md\n"]
