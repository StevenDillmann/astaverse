[6.881418, "o", "id: nc-durham-stops_multiverse\r\nname: 'nc-durham-stops: multiverse analysis'\r\ndescription: Decision space extracted by mode 'direct'.\r\ninputs:\r\n- id: dataset\r\n  type: data\r\n  source: /Users/stevend/Desktop/Asta/astaverse/data/datasets/nc-durham-stops/data.csv\r\n  description: Primary dataset under analysis\r\noutputs:\r\n- id: universe_stats\r\n  type: table\r\n  description: 'Per-universe statistics (estimate, estimate_standardized, std_error, std_error_standardized,\r\n    95% standardized confidence interval, p_value, n, direction). Carries no verdict by design: verdicts\r\n    are assigned downstream.'\r\n  inputs:\r\n  - dataset\r\n  decisions:\r\n  - analysis_universe\r\n  - contrast_structure\r\n  - dependence_handling\r\n  - race_adjustment_model\r\n  - race_definition\r\n  - search_outcome\r\n  recipe:\r\n    command: python /app/analysis.py\r\ndecisions:\r\n  analysis_universe:\r\n    label: Analysis universe\r\n    rationale: 'Which recorded stops should be included in the comparison?  [found by: direct]'\r\n"]
[6.88145, "o", "    default: all_recorded_rows\r\n    options:\r\n      all_recorded_rows:\r\n        label: All recorded rows\r\n        description: Include every row in the dataset, regardless of date or county_name, provided subject_race\r\n          and the selected search outcome are usable.\r\n      period_all_counties:\r\n        label: \"2002\\u20132015 stops in all counties\"\r\n        description: Keep rows with date from 2002-01-01 through 2015-12-31 inclusive, regardless of county_name.\r\n      period_durham_county:\r\n        label: \"2002\\u20132015 Durham County stops\"\r\n        description: Keep rows with date from 2002-01-01 through 2015-12-31 inclusive and county_name\r\n          equal to Durham County.\r\n    x_astaverse:\r\n      kind: preprocessing\r\n      post_hoc: false\r\n      option_support:\r\n        all_recorded_rows: []\r\n        period_all_counties: []\r\n        period_durham_county: []\r\n  race_definition:\r\n    label: Race-category definition and unknown handling\r\n    rationale: 'Which column and category set should define the known race groups?  [found by: direct]'\r\n    default: subject_race_known_only\r\n"]
[6.881466, "o", "    options:\r\n      subject_race_known_only:\r\n        label: Recorded subject_race, known categories only\r\n        description: Use subject_race and retain only black, white, hispanic, asian/pacific islander,\r\n          and other; exclude rows coded unknown or missing.\r\n      subject_race_with_unknown:\r\n        label: Recorded subject_race including unknown\r\n        description: Use subject_race with black, white, hispanic, asian/pacific islander, other, and\r\n          unknown as separate comparison categories; exclude only missing values.\r\n      raw_race_ethnicity_recode:\r\n        label: Reconstructed race from raw fields\r\n        description: Use raw_Race and raw_Ethnicity, applying the source release coding scheme to reconstruct\r\n          mutually exclusive black, white, hispanic, asian/pacific islander, other, and unknown categories\r\n          before analysis.\r\n    x_astaverse:\r\n      kind: variable_choice\r\n      post_hoc: false\r\n      option_support:\r\n        subject_race_known_only: []"]
[6.881484, "o", "\r\n        subject_race_with_unknown: []\r\n        raw_race_ethnicity_recode: []\r\n  search_outcome:\r\n    label: Search outcome definition"]
[6.881512, "o", "\r\n    rationale: 'Which recorded action should count as a search for the search rate?  [found by: direct]'\r\n    default: search_conducted\r\n    options:\r\n      search_conducted:\r\n        label: Any recorded search\r\n        description: Define the binary outcome as search_conducted = 1 versus search_conducted = 0; exclude\r\n          rows with missing search_conducted.\r\n      person_search:\r\n        label: Person search\r\n        description: Define the binary outcome as search_person = 1 versus search_person = 0; exclude\r\n          rows with missing search_person.\r\n      vehicle_search:\r\n        label: Vehicle search\r\n        description: Define the binary outcome as search_vehicle = 1 versus search_vehicle = 0; exclude\r\n          rows with missing search_vehicle.\r\n      search_or_frisk:\r\n        label: Search or frisk\r\n        description: Define the binary outcome as 1 when search_conducted = 1 or frisk_performed = 1,\r\n"]
[6.881526, "o", "          and 0 otherwise; exclude rows missing both component indicators.\r\n    x_astaverse:\r\n      kind: variable_choice\r\n      post_hoc: false\r\n      option_support:\r\n        search_conducted: []\r\n        person_search: []\r\n        vehicle_search: []\r\n        search_or_frisk: []\r\n  race_adjustment_model:\r\n    label: Adjustment and rate-comparison model\r\n    rationale: 'Should race-group search rates be compared without adjustment or conditional on recorded\r\n      stop characteristics?  [found by: direct]'\r\n    default: crude_rate_comparison\r\n    options:\r\n      crude_rate_comparison:\r\n        label: Unadjusted group-rate comparison\r\n"]
[6.881541, "o", "        description: For each race category, report searches divided by stops and compare the categories\r\n          using a single omnibus comparison of the unadjusted rates; do not include covariates.\r\n      unadjusted_logistic:\r\n        label: Unadjusted logistic regression\r\n        description: Fit a binary logistic regression of the selected search outcome on race category\r\n          alone, reporting race-group predicted probabilities or odds ratios.\r\n      adjusted_logistic:\r\n        label: Adjusted logistic regression\r\n        description: Fit a binary logistic regression of the selected search outcome on race category,\r\n          subject_age, subject_sex, reason_for_stop, county_name, department_name, and calendar date;\r\n"]
[6.881553, "o", "          report race-group adjusted predicted probabilities.\r\n    x_astaverse:\r\n      kind: model\r\n      post_hoc: false\r\n      option_support:\r\n        crude_rate_comparison: []\r\n        unadjusted_logistic: []\r\n        adjusted_logistic: []\r\n  contrast_structure:\r\n    label: Race contrasts\r\n    rationale: 'What race comparison should constitute the primary test?  [found by: direct]'\r\n    default: global_omnibus\r\n    options:\r\n      global_omnibus:\r\n        label: Global omnibus comparison\r\n        description: Test the null that all included race categories have the same search probability,\r\n          using one joint race comparison; do not make a specific race the reference for the primary claim.\r\n"]
[6.881565, "o", "      white_reference:\r\n        label: Each category versus white\r\n        description: Use white as the reference category and report separate contrasts of black, hispanic,\r\n          asian/pacific islander, and other versus white; omit unknown unless it is included by the race-definition\r\n          decision.\r\n      all_pairwise:\r\n        label: All pairwise race comparisons\r\n        description: Report a separate comparison for every pair of included race categories, rather than\r\n          one global comparison or only comparisons with white.\r\n    x_astaverse:"]
[6.881575, "o", "\r\n      kind: inference\r\n      post_hoc: false\r\n      option_support:\r\n        global_omnibus: []\r\n        white_reference: []\r\n        all_pairwise: []\r\n  dependence_handling:\r\n    label: Dependence and uncertainty calculation\r\n    rationale: 'How should repeated stops associated with the same officer or department affect uncertainty\r\n"]
[6.881589, "o", "      estimates?  [found by: direct]'\r\n    default: iid\r\n    options:\r\n      iid:\r\n        label: Independent-stop standard errors\r\n        description: Treat rows as independent when computing standard errors, confidence intervals, and\r\n          test statistics.\r\n      cluster_officer:\r\n        label: Cluster by officer\r\n"]
[6.881862, "o", "        description: Compute heteroskedasticity-robust standard errors clustered by officer_id_hash, allowing\r\n          arbitrary dependence among stops handled by the same officer.\r\n      cluster_department:\r\n        label: Cluster by department\r\n        description: Compute heteroskedasticity-robust standard errors clustered by department_name, allowing\r\n          dependence within reporting departments.\r\n      two_way_cluster:\r\n        label: Two-way officer and department clustering\r\n        description: Compute two-way cluster-robust standard errors using officer_id_hash and department_name\r\n          as the two clustering dimensions.\r\n    x_astaverse:\r\n      kind: inference\r\n      post_hoc: false\r\n      option_support:\r\n        iid: []\r\n        cluster_officer: []\r\n        cluster_department: []\r\n        two_way_cluster: []\r\n  verdict_rule:\r\n    label: Verdict decision rule\r\n    rationale: How the reported statistics become a supported / not-supported verdict. Left implicit by\r\n      every plan, and consequential on its own.\r\n    default: alpha_05_two_sided\r\n    options:\r\n      alpha_05_two_sided:\r\n        label: p < 0.05, two-sided\r\n        description: Conventional two-sided test at the 5% level.\r\n      alpha_01_two_sided:\r\n        label: p < 0.01, two-sided\r\n        description: Stricter two-sided threshold at the 1% level.\r\n      alpha_05_directional:\r\n        label: p < 0.05 and direction matches\r\n        description: Significant at 5% AND the estimate points the way the hypothesis predicts; a significant\r\n          effect the other way counts as not supported.\r\n    x_astaverse:\r\n      kind: verdict_rule\r\n      post_hoc: true\r\n      option_support:\r\n        alpha_05_two_sided: []\r\n        alpha_01_two_sided: []\r\n        alpha_05_directional: []\r\nprior_insights:\r\n  hypothesis:\r\n    id: hypothesis\r\n    label: Hypothesis under test\r\n    claim: Among all recorded stops, search rates differ across the known race categories.\r\nx_astaverse:\r\n  astra_schema_shape: 0.0.13\r\n  note: ASTRA-shaped, emitted by astaverse without astra-tools. Run `astra validate` to check conformance.\r\n--- data header ---\r\n"]
