[380.147992, "o", "     1\timport os, json, glob, math, warnings\r\n     2\timport numpy as np\r\n     3\timport pandas as pd\r\n     4\timport yaml\r\n     5\tfrom scipy import sparse\r\n     6\tfrom scipy.special import expit\r\n     7\timport statsmodels.api as sm\r\n     8\t\r\n     9\tDATA='/app/data.csv'\r\n    10\tOUT='/app/universes.jsonl'\r\n    11\tRACES=['black','white','hispanic','asian/pacific islander','other','unknown']\r\n    12\tKNOWN=RACES[:-1]\r\n    13\t\r\n    14\tdef _bool(s):\r\n    15\t    return pd.to_numeric(s.replace({'TRUE':1,'FALSE':0,'True':1,'False':0}), errors='coerce')\r\n    16\t\r\n    17\tdef _race(df, opt):\r\n    18\t    if opt.startswith('subject_race'):\r\n    19\t        r=df['subject_race'].astype('string').str.lower()\r\n    20\t        allowed=RACES if opt.endswith('with_unknown') else KNOWN\r\n    21\t        return r.where(r.isin(allowed))\r\n    22\t    raw=df['raw_Race'].astype('string').str.upper()\r\n    23\t    eth=df['raw_Ethnicity'].astype('string').str.upper()\r\n    24\t    # Hispanic ethnicity supersedes the raw race field; remaining source codes are recoded directly.\r\n    25\t    return pd.Series(np.select([eth.eq('H'),raw.eq('B'),raw.eq('W'),raw.eq('A'),raw.eq('I')],\r\n    26\t        ['hispanic','black','white','asian/pacific islander','other'], default='unknown'), index=df.index).astype('string')\r\n    27\t\r\n    28\tdef _groups(r):\r\n    29\t    return [x for x in RACES if (r==x).any()]\r\n    30\t\r\n    31\tdef _contrast(groups, rates, mode):\r\n    32\t    pairs=[]\r\n    33\t"]
[380.14821, "o", "    if mode=='white_reference' and 'white' in groups:\r\n    34\t        pairs=[(g,'white') for g in groups if g!='white' and g!='unknown']\r\n    35\t        if not pairs: pairs=[(groups[-1],groups[0])]\r\n    36\t    else:\r\n    37\t        pairs=[(groups[i],groups[j]) for i in range(len(groups)) for j in range(i)]\r\n    38\t    vals=[(rates[a]-rates[b],a,b) for a,b in pairs]\r\n    39\t    if not vals: return None\r\n    40\t    # The primary scalar is the largest absolute requested race contrast.\r\n    41\t    return max(vals,key=lambda z:abs(z[0]))\r\n    42\t\r\n    43\tdef _cluster_se(influence, df, mode):\r\n    44\t    if mode=='iid': return math.sqrt(max(float(np.sum(influence**2)),0.0))\r\n    45\t    def one(key):\r\n    46\t        z=pd.Series(influence,index=df.index).groupby(df[key].astype('string'),dropna=False).sum().to_numpy()\r\n    47\t        return float(np.sum(z*z))\r\n    48\t    if mode=='cluster_officer': v=one('officer_id_hash')\r\n    49\t    elif mode=='cluster_department': v=one('department_name')\r\n    50\t    else: v=one('officer_id_hash')+one('department_name')\r\n    51\t    if mode=='two_way_cluster':\r\n    52\t        # inclusion-exclusion intersection clusters (officer, department)\r\n    53\t        z=pd.DataFrame({'v':influence,'o':df['officer_id_hash'].astype('string'),'d':df['department_name'].astype('string')}).groupby(['o','d'],dropna=False)['v'].sum().to_numpy()\r\n    54\t        v-=float(np.sum(z*z))\r\n    55\t    return math.sqrt(max(v,0.0))\r\n"]
[380.148349, "o", "    56\t\r\n    57\tdef _result(n, est, se, outcome_sd, p, conv=True):\r\n    58\t    if not conv or any(x is None or not np.isfinite(x) for x in [est,se]):\r\n    59\t        return {'estimate':None,'estimate_standardized':None,'std_error':None,'std_error_standardized':None,'ci_low_standardized':None,'ci_high_standardized':None,'p_value':None,'n':int(n),'direction':'none','converged':False}\r\n    60\t    scale=1.0/max(float(outcome_sd),1e-12)\r\n    61\t    es=est*scale; ss=abs(scale)*se\r\n    62\t    return {'estimate':float(est),'estimate_standardized':float(es),'std_error':float(se),'std_error_standardized':float(ss),'ci_low_standardized':float(es-1.96*ss),'ci_high_standardized':float(es+1.96*ss),'p_value':float(2*__import__('scipy').stats.norm.sf(abs(est/se))) if se>0 else 0.0,'n':int(n),'direction':'positive' if est>0 else ('negative' if est<0 else 'none'),'converged':bool(conv)}\r\n    63\t\r\n    64\tdef analyze(df, selections):\r\n    65\t    try:\r\n    66\t        d=df.copy()\r\n    67\t        au=selections['analysis_universe']\r\n    68\t        dates=pd.to_datetime(d['date'],errors='coerce')\r\n    69\t        if au!='all_recorded_rows':\r\n    70\t            m=dates.between('2002-01-01','2015-12-31')\r\n    71\t            if au=='period_durham_county': m &= d['county_name'].eq('Durham County')\r\n    72\t            d=d.loc[m].copy(); dates=dates.loc[d.index]\r\n    73\t        r=_race(d,selections['race_definition'])\r\n    74\t        so=selections['search_outcome']\r\n    75\t        if so=='search_or_frisk':\r\n    76\t            a=_bool(d['search_conducted']); b=_bool(d['frisk_performed']); y=((a==1)|(b==1)).astype(float); ok=a.notna()|b.notna()\r\n    77\t        else:\r\n    78\t            col={'search_conducted':'search_conducted','person_search':'search_person','vehicle_search':'search_vehicle'}[so]\r\n    79\t            y=_bool(d[col]); ok=y.notna()\r\n    80\t        ok &= r.notna()\r\n    81\t        d=d.loc[ok].copy(); y=y.loc[d.index].astype(float).to_numpy(); r=r.loc[d.index]\r\n    82\t        n=len(d); groups=_groups(r)\r\n    83\t        if n<20 or len(groups)<2 or len(np.unique(y))<2: return _result(n,None,None,np.std(y),None,False)\r\n    84\t        outcome_sd=float(np.std(y,ddof=1)) if n>1 else 1.0\r\n    85\t        mode=selections['contrast_structure']; dep=selections['dependence_handling']; model=selections['race_adjustment_model']\r\n    86\t        rates={g:float(y[r.to_numpy()==g].mean()) for g in groups}\r\n    87\t        if model=='crude_rate_comparison':\r\n    88\t            cc=_contrast(groups,rates,mode); est,a,b=cc\r\n    89\t            ia=(r.to_numpy()==a); ib=(r.to_numpy()==b)\r\n    90\t            influence=(ia*(y-rates[a])/ia.sum())-(ib*(y-rates[b])/ib.sum())\r\n    91\t            se=_cluster_se(influence,d,dep)\r\n    92\t            return _result(n,est,se,outcome_sd,None,True)\r\n    93\t        # Logistic models use a sparse IRLS fit to keep the full dataset memory-safe.\r\n    94\t        from scipy import sparse as sp\r\n    95\t        from scipy.linalg import solve\r\n    96\timport scipy.linalg\r\n    97\t        race_cols=[g for g in groups if g!='white']\r\n    98\t        mats=[]\r\n    99\t        for g in race_cols:\r\n   100\t            mats.append(sp.csr_matrix((r.to_numpy()==g).astype(float)[:,None]))\r\n   101\t        if model=='adjusted_logistic':\r\n   102\t            age=pd.to_numeric(d['subject_age'],errors='coerce')\r\n   103\t            age=age.fillna(age.median()).to_numpy(float)\r\n   104\t            age=(age-np.mean(age))/max(np.std(age),1.0)\r\n   105\t            day=(pd.to_datetime(d['date'],errors='coerce')-pd.Timestamp('2000-01-01')).dt.days.fillna(0).to_numpy(float)\r\n   106\t            day=(day-np.mean(day))/max(np.std(day),1.0)\r\n   107\t            mats += [sp.csr_matrix(np.column_stack([age,day]))]\r\n   108\t            for c in ['subject_sex','reason_for_stop','county_name','department_name']:\r\n   109\t                codes=pd.Categorical(d[c].astype('string').fillna('__missing__')).codes\r\n   110\t                k=int(codes.max())+1\r\n   111\t                # Reference coding avoids exact collinearity with the intercept.\r\n   112\t                if k>1:\r\n   113\t    "]
[380.148453, "o", "                mats.append(sp.csr_matrix((np.ones(n),(np.arange(n),codes)),shape=(n,k))[:,1:])\r\n   114\t        X=sp.hstack(mats,format='csr')\r\n   115\t        X=sp.hstack([sp.csr_matrix(np.ones((n,1))),X],format='csr')\r\n   116\t        p=X.shape[1]; beta=np.zeros(p)\r\n   117\t        converged=False\r\n   118\t        for _ in range(10):\r\n   119\t            eta=np.asarray(X@beta).ravel(); pr=expit(np.clip(eta,-35,35)); w=np.maximum(pr*(1-pr),1e-8)\r\n   120\t            score=np.asarray(X.T@(y-pr)).ravel()\r\n   121\t            H=(X.T.multiply(w))@X + sp.eye(p)*1e-7\r\n   122\t            with warnings.catch_warnings():\r\n   123\t                warnings.simplefilter('ignore')\r\n   124\t                try: step=np.asarray(scipy.linalg.solve(H.toarray(),score,assume_a='sym',check_finite=False)).ravel()\r\n   125\t                except Exception: step=np.asarray(np.linalg.lstsq(H.toarray(),score,rcond=1e-10)[0]).ravel()\r\n   126\t            beta += step\r\n   127\t            if np.max(np.abs(step))<1e-7: converged=True; break\r\n   128\t        if not np.all(np.isfinite(beta)): return _result(n,None,None,outcome_sd,None,False)\r\n   129\t        # Counterfactual predictions for each included race, averaging over observed covariates.\r\n   130\t        preds={}\r\n   131\t        for gi,g in enumerate(groups):\r\n   132\t            z=X.copy().tolil()\r\n   133\t            for j,c in enumerate(race_cols): z[:,1+j]=float(c==g)\r\n   134\t            preds[g]=expit(np.clip(np.asarray(z.tocsr()@beta).ravel(),-35,35))\r\n   135\t        means={g:float(preds[g].mean()) for g in groups}; cc=_contrast(groups,means,mode)\r\n   136\t        if cc is None: return _result(n,None,None,outcome_sd,None,False)\r\n   137\t        est,a,b=cc\r\n   138\t        pa=preds[a]; pb=preds[b]\r\n   139\t        grad=np.asarray(X.T@((pa*(1-pa)-pb*(1-pb))/n)).ravel()\r\n   140\t        score=X.multiply((y-expit(np.clip(np.asarray(X@beta).ravel(),-35,35)))[:,None])\r\n   141\t        H=(X.T.multiply(np.maximum(expit(np.clip(np.asarray(X@beta).ravel(),-35,35))*(1-expit(np.clip(np.asarray(X@beta).ravel(),-35,35))),1e-8)))@X + sp.eye(p)*1e-7\r\n   142\t        bread=np.linalg.inv(H.toarray()) if np.linalg.cond(H.toarray()) < 1e12 else np.linalg.pinv(H.toarray(),rcond=1e-10)\r\n   143\t        infl=np.asarray(score@bread.T@grad).ravel()\r\n   144\t        se=_cluster_se(infl,d,dep)\r\n   145\t        return _result(n,est,se,outcome_sd,None,True)\r\n   146\t    except Exception:\r\n   147\t        return _result(len(df),None,None,1.0,None,False)\r\n   148\t\r\n   149\tdef main():\r\n   150\t    df=pd.read_csv(DATA,low_memory=False)\r\n   151\t    import gc\r\n   152\t    rows=[]\r\n   153\t    with open(OUT,'w') as f:\r\n   154\t        for fn in sorted(glob.glob('/app/universes/*.yaml')):\r\n   155\t            u=yaml.safe_load(open(fn)); selections={x['decision_id']:x['option_id'] for x in u['decisions']}\r\n   156\t            z=analyze(df,selections); z={'universe_id':u['id'],'decisions':selections,**z}\r\n   157\t            rows.append(z); f.write(json.dumps(z,separators=(',',':'))+'\\n'); f.flush(); gc.collect()\r\n   158\t    vals=[z['estimate_standardized'] for z in rows if z['estimate_standardized'] is not None]\r\n   159\t    conv=sum(bool(z['converged']) for z in rows)\r\n   160\t    with open('/app/results.md','w') as f:\r\n   161\t        f.write('# Multiverse analysis report\\n\\n')\r\n   162\t        f.write('`analyze(df, selections)` applies the selected universe filter, race definition, search outcome, race contrast, model, and dependence correction through one parameterized code path. Crude analyses compare observed race-specific search rates; logistic analyses use race alone or race plus age, sex, stop reason, county, department, and calendar date. The reported scalar contrast is the largest absolute requested race contrast. Standardized estimates divide probability contrasts and standard errors by the sample SD of the selected binary outcome.\\n\\n')\r\n   163\t        f.write('## Results\\n\\n')\r\n   164\t        f.write(f'- Universes evaluated: {len(rows)}; converged: {conv}.\\n')\r\n   165\t        if vals: f.write(f'- Standardized estimate range: {min(vals):.6g} to {max"]
[380.148542, "o", "(vals):.6g}; mean {np.mean(vals):.6g}; median {np.median(vals):.6g}.\\n')\r\n   166\t        f.write('- Results are in `universes.jsonl`; no verdict field is included. Differences reflect the selected universe, race coding, outcome, model, contrast, and uncertainty specification.\\n')\r\n   167\tif __name__=='__main__': main()\r\n"]
