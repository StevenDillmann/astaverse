[63.733451, "o", "            x['date_ord']=(pd.to_datetime(d['date'],errors='coerce')-pd.Timestamp('2000-01-01')).dt.days.fillna(0).astype(float)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.733471, "o", "> "]
[63.733654, "o", "            for c in ['subject_sex','reason_for_stop','county_name','department_name']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.733745, "o", "> "]
[63.73392, "o", "                x=pd.concat([x,pd.get_dummies(d[c].astype('string').fillna('__missing__'),prefix=c,dtype=float)],axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.734006, "o", "            cols.append(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.73416, "o", "        X=pd.concat(cols,axis=1).replace([np.inf,-np.inf],0).fillna(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.734242, "o", "        Xn=np.asarray(X,dtype=float); names=list(X.columns)\r\n\u001b[?2004l\r"]
[63.734261, "o", "\u001b[?2004h> "]
[63.73443, "o", "        if Xn.shape[1]==0: return _result(n,None,None,outcome_sd,None,False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.73452, "o", "        fit=LogisticRegression(solver='lbfgs',max_iter=250,C=1e6,fit_intercept=True)\r\n\u001b[?2004l\r"]
[63.734567, "o", "\u001b[?2004h> "]
[63.73467, "o", "        with warnings.catch_warnings():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.734823, "o", "            warnings.simplefilter('ignore'); fit.fit(Xn,y)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.73496, "o", "        beta=np.r_[fit.intercept_[0],fit.coef_[0]]\r\n\u001b[?2004l\r\u001b[?2004h>         Xa=np.c_[np.ones(n),Xn]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.735147, "o", "        # counterfactual group predictions, retaining observed covariates for adjusted models\r\n\u001b[?2004l\r\u001b[?2004h>         preds={}\r\n\u001b[?2004l\r"]
[63.735173, "o", "\u001b[?2004h> "]
[63.7353, "o", "        for g in groups:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.735413, "o", "            z=Xn.copy(); rc=[i for i,c in enumerate(names) if c==g]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.735444, "o", "            for i,c in enumerate(groups):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.735619, "o", "                if c!='white' and c in names: z[:,names.index(c)]=(c==g)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.735658, "o", "            preds[g]=expit(np.c_[np.ones(n),z]@beta)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.735892, "o", "        means={g:float(preds[g].mean()) for g in groups}; est,a,b=_contrast(groups,means,mode)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.736163, "o", "        pder=preds[a]*(1-preds[a]); qder=preds[b]*(1-preds[b]); grad=np.mean((pder[:,None]-qder[:,None])*Xa,axis=0)\r\n\u001b[?2004l\r\u001b[?2004h>         prob=expit(Xa@beta); score=Xa*(y-prob)[:,None]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.73626, "o", "        H=(Xa.T*(prob*(1-prob)))@Xa + np.eye(Xa.shape[1])*1e-8\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.736357, "o", "        bread=np.linalg.pinv(H); infl=score@bread.T@grad\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.736525, "o", "        se=_cluster_se(infl,d,dep)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.736561, "o", "        return _result(n,est,se,outcome_sd,None,True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.736762, "o", "    except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>         return _result(len(df),None,None,1.0,None,False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[63.736877, "o", "> def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.736911, "o", "    df=pd.read_csv(DATA,low_memory=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.736994, "o", "    rows=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.737073, "o", "    for fn in sorted(glob.glob('/app/universes/*.yaml')):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.737271, "o", "        u=yaml.safe_load(open(fn)); selections={x['decision_id']:x['option_id'] for x in u['decisions']}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.737431, "o", "        z=analyze(df,selections); z={'universe_id':u['id'],'decisions':selections,**z}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.737491, "o", "        rows.append(z)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.737512, "o", ">     with open(OUT,'w') as f:\r\n\u001b[?2004l\r"]
[63.737575, "o", "\u001b[?2004h> "]
[63.737705, "o", "        for z in rows: f.write(json.dumps(z,separators=(',',':'))+'\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.737861, "o", "    vals=[z['estimate_standardized'] for z in rows if z['estimate_standardized'] is not None]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.738005, "o", "    conv=sum(bool(z['converged']) for z in rows)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.738026, "o", "    with open('/app/results.md','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.738236, "o", "        f.write('# Multiverse analysis report\\n\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.739064, "o", "        f.write('`analyze(df, selections)` applies the selected universe filter, race definition, search outcome, race contrast, model, and dependence correction through one parameterized code path. Crude analyses compare observed race-specific search rates; logistic analyses use race alone or race plus age, sex, stop reason, county, department, and calendar date. The reported scalar contrast is the largest absolute requested race contrast. Standardized estimates divide probability contrasts and standard errors by the sample SD of the selected binary outcome.\\n\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.739179, "o", "        f.write('## Results\\n\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.739231, "o", "        f.write(f'- Universes evaluated: {len(rows)}; converged: {conv}.\\n')\r\n\u001b[?2004l\r"]
[63.739331, "o", "\u001b[?2004h> "]
[63.739545, "o", "        if vals: f.write(f'- Standardized estimate range: {min(vals):.6g} to {max(vals):.6g}; mean {np.mean(vals):.6g}; median {np.median(vals):.6g}.\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.739855, "o", "        f.write('- Results are in `universes.jsonl`; no verdict field is included. Differences reflect the selected universe, race coding, outcome, model, contrast, and uncertainty specification.\\n')\r\n"]
[63.739875, "o", "\u001b[?2004l\r"]
[63.739929, "o", "\u001b[?2004h> "]
[63.739995, "o", "if __name__=='__main__': main()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
