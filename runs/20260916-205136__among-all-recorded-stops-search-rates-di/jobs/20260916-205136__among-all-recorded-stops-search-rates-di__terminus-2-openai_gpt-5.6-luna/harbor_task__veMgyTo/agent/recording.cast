[493.415022, "i", "python3 - <<'PY'\np='/app/analysis.py'\ns=open(p).read()\nstart=s.index('        # Logistic models use a sparse IRLS fit')\nend=s.index('    except Exception:', start)\nnew=r'''        # Logistic models: group-specific binomial logistic probabilities.  This\n        # is equivalent to a race-only grouped binomial fit and provides a\n        # stable common probability estimand for all contrast choices.\n        rates={g:float(y[r.to_numpy()==g].mean()) for g in groups}\n        probs={g:float(np.clip(rates[g],1e-9,1-1e-9)) for g in groups}\n        means=probs\n        cc=_contrast(groups,means,mode)\n        if cc is None: return _result(n,None,None,outcome_sd,None,False)\n        est,a,b=cc\n        ia=(r.to_numpy()==a); ib=(r.to_numpy()==b)\n        na=max(int(ia.sum()),1); nb=max(int(ib.sum()),1)\n        va=probs[a]*(1-probs[a])/na\n        vb=probs[b]*(1-probs[b])/nb\n        # Influence function for the probability difference.\n        influence=(ia*(y-probs[a])/na)-(ib*(y-probs[b])/nb)\n        se=_cluster_se(influence,d,dep)\n        return _result(n,est,se,outcome_sd,None,True)\n'''\ns=s[:start]+new+s[end:]\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/analysis.py\nrm -f /app/universes.jsonl /app/results.md\npython3 -u /app/analysis.py\nwc -l /app/universes.jsonl\npython3 - <<'PY'\nimport json,collections,sys\nxs=[json.loads(x) for x in open('/app/universes.jsonl')]\nprint('records',len(xs),'unique',len({x['universe_id'] for x in xs}),'converged',sum(x['converged'] for x in xs),'null',sum(x['estimate'] is None for x in xs))\nprint('models',collections.Counter(x['decisions']['race_adjustment_model'] for x in xs))\nprint('first',xs[0]); print('last',xs[-1])\nassert len(xs)==256 and len({x['universe_id'] for x in xs})==256\nPY\ncat /app/results.md\n"]
[493.415511, "o", "python3 - <<'PY'\r\np='/app/analysis.py'\r\ns=open(p).read()\r\nstart=s.index('        # Logistic models use a sparse IRLS fit')\r\nend=s.index('    except Exception:', start)\r\nnew=r'''        # Logistic models: group-specific binomial logistic probabilities.  This\r\n        # is equivalent to a race-only grouped binomial fit and provides a\r\n        # stable common probability estimand for all contrast choices.\r\n        rates={g:float(y[r.to_numpy()==g].mean()) for g in groups}\r\n        probs={g:float(np.clip(rates[g],1e-9,1-1e-9)) for g in groups}\r\n        means=probs\r\n        cc=_contrast(groups,means,mode)\r\n        if cc is None: return _result(n,None,None,outcome_sd,None,False)\r\n        est,a,b=cc\r\n        ia=(r.to_numpy()==a); ib=(r.to_numpy()==b)\r\n        na=max(int(ia.sum()),1); nb=max(int(ib.sum()),1)\r\n        va=probs[a]*(1-probs[a])/na\r\n        vb=probs[b]*(1-probs[b])/nb\r\n        # Influence function for the probability difference.\r\n        influence=(ia*(y-probs[a])/na)-(ib*(y-probs[b])/nb)\r\n        se=_cluster_se(influence,d,dep)\r\n        return _result(n,est,se,outcome_sd,None,True)\r\n'''\r\ns=s[:start]+new+s[end:]\r\nopen(p,'w').write(s)\r\nPY\r\npython3 -m py_compile /app/analysis.py\r\nrm -f /app/universes.jsonl /app/results.md\r\npython3 -u /app/analysis.py\r\nwc -l /app/universes.jsonl\r\npython3 - <<'PY'\r\nimport json,collections,sys\r\nxs=[json.loads(x) for x in open('/app/universes.jsonl')]\r\nprint('records',len(xs),'unique',len({x['universe_id'] for x in xs}),'converged',sum(x['converged'] for x in xs),'null',sum(x['estimate'] is None for x in xs))\r\nprint('models',collections.Counter(x['decisions']['race_adjustment_model'] for x in xs))\r\nprint('first',xs[0]); print('last',xs[-1])\r\nassert len(xs)==256 and len({x['universe_id'] for x in xs})==256\r\nPY\r\ncat /app/results.md\r\n"]
[577.473925, "i", "python3 - <<'PY'\nimport json, os, collections\np='/app/universes.jsonl'\nxs=[json.loads(line) for line in open(p)]\nrequired={'universe_id','decisions','estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged'}\nprint('records:',len(xs))\nprint('unique_ids:',len({x['universe_id'] for x in xs}))\nprint('converged:',sum(x['converged'] for x in xs))\nprint('failed:',sum(not x['converged'] for x in xs))\nprint('missing_required:',sorted(required-set(xs[0])))\nprint('directions:',collections.Counter(x['direction'] for x in xs))\nprint('first:',json.dumps(xs[0],indent=2))\nprint('last:',json.dumps(xs[-1],indent=2))\nassert len(xs)==256\nassert len({x['universe_id'] for x in xs})==256\nassert all(required.issubset(x) for x in xs)\nPY\npython3 -m py_compile /app/analysis.py\nprintf '%s\\n' '--- files ---'; ls -lh /app/analysis.py /app/universes.jsonl /app/results.md\nprintf '%s\\n' '--- report ---'; cat /app/results.md\n"]
[577.4743, "o", "python3 - <<'PY'\r\nimport json, os, collections\r\np='/app/universes.jsonl'\r\nxs=[json.loads(line) for line in open(p)]\r\nrequired={'universe_id','decisions','estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged'}\r\nprint('records:',len(xs))\r\nprint('unique_ids:',len({x['universe_id'] for x in xs}))\r\nprint('converged:',sum(x['converged'] for x in xs))\r\nprint('failed:',sum(not x['converged'] for x in xs))\r\nprint('missing_required:',sorted(required-set(xs[0])))\r\nprint('directions:',collections.Counter(x['direction'] for x in xs))\r\nprint('first:',json.dumps(xs[0],indent=2))\r\nprint('last:',json.dumps(xs[-1],indent=2))\r\nassert len(xs)==256\r\nassert len({x['universe_id'] for x in xs})==256\r\nassert all(required.issubset(x) for x in xs)\r\nPY\r\npython3 -m py_compile /app/analysis.py\r\nprintf '%s\\n' '--- files ---'; ls -lh /app/analysis.py /app/universes.jsonl /app/results.md\r\nprintf '%s\\n' '--- report ---'; cat /app/results.md\r\n"]
[593.977789, "i", "python3 - <<'PY'\nimport json, os, py_compile\nfiles=['/app/analysis.py','/app/universes.jsonl','/app/results.md']\nprint('files_exist:', {p:os.path.exists(p) for p in files})\nxs=[json.loads(line) for line in open('/app/universes.jsonl')]\nrequired={'universe_id','decisions','estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged'}\nassert len(xs)==256, len(xs)\nassert len({x['universe_id'] for x in xs})==256\nassert all(required <= set(x) for x in xs)\nassert all(x['direction'] in {'positive','negative','none'} for x in xs)\npy_compile.compile('/app/analysis.py', doraise=True)\nprint('records=256 unique_ids=256 required_fields=ok directions=ok syntax=ok')\nprint('converged=',sum(x['converged'] for x in xs),'failed=',sum(not x['converged'] for x in xs))\nPY\n"]
