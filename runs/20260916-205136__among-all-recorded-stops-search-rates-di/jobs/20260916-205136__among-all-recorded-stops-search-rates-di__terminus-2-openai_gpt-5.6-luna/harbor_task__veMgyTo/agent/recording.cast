[217.561561, "i", "python3 - <<'PY'\np='/app/analysis.py'\ns=open(p).read()\nstart=s.index('        # Logistic models: race, age, sex, stop reason, county, department, and calendar date.')\nend=s.index('    except Exception:', start)\nnew=r'''        # Logistic models use a sparse IRLS fit to keep the full dataset memory-safe.\n        from scipy import sparse as sp\n        from scipy.linalg import solve\n        race_cols=[g for g in groups if g!='white']\n        mats=[]\n        for g in race_cols:\n            mats.append(sp.csr_matrix((r.to_numpy()==g).astype(float)[:,None]))\n        if model=='adjusted_logistic':\n            age=pd.to_numeric(d['subject_age'],errors='coerce')\n            age=age.fillna(age.median()).to_numpy(float)\n            day=(pd.to_datetime(d['date'],errors='coerce')-pd.Timestamp('2000-01-01')).dt.days.fillna(0).to_numpy(float)\n            mats += [sp.csr_matrix(np.column_stack([age,day]))]\n            for c in ['subject_sex','reason_for_stop','county_name','department_name']:\n                codes=pd.Categorical(d[c].astype('string').fillna('__missing__')).codes\n                k=int(codes.max())+1\n                mats.append(sp.csr_matrix((np.ones(n),(np.arange(n),codes)),shape=(n,k)))\n        X=sp.hstack(mats,format='csr')\n        X=sp.hstack([sp.csr_matrix(np.ones((n,1))),X],format='csr')\n        p=X.shape[1]; beta=np.zeros(p)\n        converged=False\n        for _ in range(30):\n            eta=np.asarray(X@beta).ravel(); pr=expit(np.clip(eta,-35,35)); w=np.maximum(pr*(1-pr),1e-8)\n            score=np.asarray(X.T@(y-pr)).ravel()\n            H=(X.T.multiply(w))@X + sp.eye(p)*1e-7\n            try: step=np.asarray(solve(H.toarray(),score,assume_a='sym')).ravel()\n            except Exception: step=np.asarray(np.linalg.pinv(H.toarray())@score).ravel()\n            beta += step\n            if np.max(np.abs(step))<1e-7: converged=True; break\n        if not converged and np.max(np.abs(step))>1e-4: return _result(n,None,None,outcome_sd,None,False)\n        # Counterfactual predictions for each included race, averaging over observed covariates.\n        preds={}\n        for gi,g in enumerate(groups):\n            z=X.copy().tolil()\n            for j,c in enumerate(race_cols): z[:,1+j]=float(c==g)\n            preds[g]=expit(np.clip(np.asarray(z.tocsr()@beta).ravel(),-35,35))\n        means={g:float(preds[g].mean()) for g in groups}; cc=_contrast(groups,means,mode)\n        if cc is None: return _result(n,None,None,outcome_sd,None,False)\n        est,a,b=cc\n        pa=preds[a]; pb=preds[b]\n        grad=np.asarray(X.T@((pa*(1-pa)-pb*(1-pb))/n)).ravel()\n        score=X.multiply((y-expit(np.clip(np.asarray(X@beta).ravel(),-35,35)))[:,None])\n        H=(X.T.multiply(np.maximum(expit(np.clip(np.asarray(X@beta).ravel(),-35,35))*(1-expit(np.clip(np.asarray(X@beta).ravel(),-35,35))),1e-8)))@X + sp.eye(p)*1e-7\n        bread=np.linalg.pinv(H.toarray())\n        infl=np.asarray(score@bread.T@grad).ravel()\n        se=_cluster_se(infl,d,dep)\n        return _result(n,est,se,outcome_sd,None,True)\n'''\ns=s[:start]+new+s[end:]\n# Remove unused sklearn import if still present and statsmodels import is harmless.\ns=s.replace('from sklearn.linear_model import LogisticRegression\\n','')\n# Replace driver with incremental output and explicit gc.\nold=\"\"\"    rows=[]\n    for fn in sorted(glob.glob('/app/universes/*.yaml')):\n        u=yaml.safe_load(open(fn)); selections={x['decision_id']:x['option_id'] for x in u['decisions']}\n        z=analyze(df,selections); z={'universe_id':u['id'],'decisions':selections,**z}\n        rows.append(z)\n    with open(OUT,'w') as f:\n        for z in rows: f.write(json.dumps(z,separators=(',',':'))+'\\\\n')\n\"\"\"\nnewdriver=\"\"\"    import gc\n    rows=[]\n    with open(OUT,'w') as f:\n        for fn in sorted(glob.glob('/app/universes/*.yaml')):\n            u=yaml.safe_load(open(fn)); selections={x['decision_id']:x['option_id'] for x in u['decisions']}\n            z=analyze(df,selections); z={'universe_id':u['id'],'decisions':selections,**z}\n            rows.append(z); f.write(json.dumps(z,separators=(',',':'))+'\\\\n'); f.flush(); gc.collect()\n\"\"\""]
[217.561736, "i", "\nif old not in s: raise SystemExit('driver block not found')\ns=s.replace(old,newdriver)\nopen(p,'w').write(s)\nPY\nrm -f /app/universes.jsonl /app/results.md\npython3 -u /app/analysis.py\nwc -l /app/universes.jsonl\npython3 - <<'PY'\nimport json,collections\nxs=[json.loads(x) for x in open('/app/universes.jsonl')]\nprint('records',len(xs),'unique',len({x['universe_id'] for x in xs}),'converged',sum(x['converged'] for x in xs),'null',sum(x['estimate'] is None for x in xs))\nprint(collections.Counter(x['decisions']['race_adjustment_model'] for x in xs))\nprint(xs[0]); print(xs[-1])\nPY\ncat /app/results.md\n"]
[217.562273, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/analysis.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.564499, "o", "start=s.index('        # Logistic models: race, age, sex, stop reason, county, department, and calendar date.')\r\n\u001b[?2004l\r\u001b[?2004h> end=s.index('    except Exception:', start)\r\n\u001b[?2004l\r\u001b[?2004h> new=r'''        # Logistic models use a sparse IRLS fit to keep the full dataset memory-safe.\r\n\u001b[?2004l\r\u001b[?2004h>         from scipy import sparse as sp\r\n\u001b[?2004l\r\u001b[?2004h>         from scipy.linalg import solve\r\n\u001b[?2004l\r\u001b[?2004h>         race_cols=[g for g in groups if g!='white']\r\n\u001b[?2004l\r\u001b[?2004h>         mats=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for g in race_cols:\r\n\u001b[?2004l\r\u001b[?2004h>             mats.append(sp.csr_matrix((r.to_numpy()==g).astype(float)[:,None]))\r\n\u001b[?2004l\r\u001b[?2004h>         if model=='adjusted_logistic':\r\n\u001b[?2004l\r\u001b[?2004h>             age=pd.to_numeric(d['subject_age'],errors='coerce')\r\n\u001b[?2004l\r\u001b[?2004h>             age=age.fillna(age.median()).to_numpy(float)\r\n\u001b[?2004l\r\u001b[?2004h>             day=(pd.to_datetime(d['date'],errors='coerce')-pd.Timestamp('2000-01-01')).dt.days.fillna(0).to_numpy(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.56504, "o", "            mats += [sp.csr_matrix(np.column_stack([age,day]))]\r\n\u001b[?2004l\r"]
[217.565318, "o", "\u001b[?2004h> "]
[217.565396, "o", "            for c in ['subject_sex','reason_for_stop','county_name','department_name']:\r\n\u001b[?2004l\r\u001b[?2004h>                 codes=pd.Categorical(d[c].astype('string').fillna('__missing__')).codes\r\n\u001b[?2004l\r"]
[217.565472, "o", "\u001b[?2004h> "]
[217.565518, "o", "                k=int(codes.max())+1"]
[217.565875, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>                 mats.append(sp.csr_matrix((np.ones(n),(np.arange(n),codes)),shape=(n,k)))\r\n\u001b[?2004l\r\u001b[?2004h>         X=sp.hstack(mats,format='csr')\r\n\u001b[?2004l\r\u001b[?2004h>         X=sp.hstack([sp.csr_matrix(np.ones((n,1))),X],format='csr')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.565929, "o", "        p=X.shape[1]; beta=np.zeros(p)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.565946, "o", "        converged=False\r\n\u001b[?2004l\r"]
[217.565971, "o", "\u001b[?2004h> "]
[217.566264, "o", "        for _ in range(30):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.566294, "o", "            eta=np.asarray(X@beta).ravel(); pr=expit(np.clip(eta,-35,35)); w=np.maximum(pr*(1-pr),1e-8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.566321, "o", "            score=np.asarray(X.T@(y-pr)).ravel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.566461, "o", "            H=(X.T.multiply(w))@X + sp.eye(p)*1e-7\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.566629, "o", "            try: step=np.asarray(solve(H.toarray(),score,assume_a='sym')).ravel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.5667, "o", "            except Exception: step=np.asarray(np.linalg.pinv(H.toarray())@score).ravel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.56677, "o", "            beta += step\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.566902, "o", "            if np.max(np.abs(step))<1e-7: converged=True; break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.567002, "o", "        if not converged and np.max(np.abs(step))>1e-4: return _result(n,None,None,outcome_sd,None,False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.567136, "o", "        # Counterfactual predictions for each included race, averaging over observed covariates.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.567209, "o", "        preds={}\r\n\u001b[?2004l\r"]
[217.567236, "o", "\u001b[?2004h> "]
[217.567275, "o", "        for gi,g in enumerate(groups):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.5674, "o", "            z=X.copy().tolil()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.567486, "o", "            for j,c in enumerate(race_cols): z[:,1+j]=float(c==g)"]
[217.567565, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.567621, "o", "            preds[g]=expit(np.clip(np.asarray(z.tocsr()@beta).ravel(),-35,35))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.56777, "o", "        means={g:float(preds[g].mean()) for g in groups}; cc=_contrast(groups,means,mode)\r\n\u001b[?2004l\r"]
[217.567839, "o", "\u001b[?2004h> "]
[217.567926, "o", "        if cc is None: return _result(n,None,None,outcome_sd,None,False)\r\n\u001b[?2004l\r\u001b[?2004h>         est,a,b=cc"]
[217.56798, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.568098, "o", "        pa=preds[a]; pb=preds[b]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.568188, "o", "        grad=np.asarray(X.T@((pa*(1-pa)-pb*(1-pb))/n)).ravel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.56827, "o", "        score=X.multiply((y-expit(np.clip(np.asarray(X@beta).ravel(),-35,35)))[:,None])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.568511, "o", "        H=(X.T.multiply(np.maximum(expit(np.clip(np.asarray(X@beta).ravel(),-35,35))*(1-expit(np.clip(np.asarray(X@beta).ravel(),-35,35))),1e-8)))@X + sp.eye(p)*1e-7\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.568568, "o", "        bread=np.linalg.pinv(H.toarray())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.568657, "o", "        infl=np.asarray(score@bread.T@grad).ravel()\r\n\u001b[?2004l\r\u001b[?2004h"]
[217.568679, "o", "> "]
[217.568727, "o", "        se=_cluster_se(infl,d,dep)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.568824, "o", "        return _result(n,est,se,outcome_sd,None,True)\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[217.568894, "o", "\u001b[?2004h> s=s[:start]+new+s[end:]\r\n\u001b[?2004l\r"]
[217.568975, "o", "\u001b[?2004h> "]
[217.569086, "o", "# Remove unused sklearn import if still present and statsmodels import is harmless.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.569215, "o", "s=s.replace('from sklearn.linear_model import LogisticRegression\\n','')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.569295, "o", "# Replace driver with incremental output and explicit gc.\r\n\u001b[?2004l\r\u001b[?2004h> old=\"\"\"    rows=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.569362, "o", "    for fn in sorted(glob.glob('/app/universes/*.yaml')):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.569544, "o", "        u=yaml.safe_load(open(fn)); selections={x['decision_id']:x['option_id'] for x in u['decisions']}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.56969, "o", "        z=analyze(df,selections); z={'universe_id':u['id'],'decisions':selections,**z}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.569709, "o", "        rows.append(z)\r\n\u001b[?2004l\r"]
[217.569808, "o", "\u001b[?2004h> "]
[217.569878, "o", "    with open(OUT,'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.569971, "o", "        for z in rows: f.write(json.dumps(z,separators=(',',':'))+'\\\\n')\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.570042, "o", "newdriver=\"\"\"    import gc\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.570082, "o", "    rows=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.570107, "o", "    with open(OUT,'w') as f:\r\n\u001b[?2004l\r"]
[217.570133, "o", "\u001b[?2004h> "]
[217.570199, "o", "        for fn in sorted(glob.glob('/app/universes/*.yaml')):\r\n\u001b[?2004l\r"]
[217.570263, "o", "\u001b[?2004h> "]
[217.570392, "o", "            u=yaml.safe_load(open(fn)); selections={x['decision_id']:x['option_id'] for x in u['decisions']}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.57052, "o", "            z=analyze(df,selections); z={'universe_id':u['id'],'decisions':selections,**z}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.57068, "o", "            rows.append(z); f.write(json.dumps(z,separators=(',',':'))+'\\\\n'); f.flush(); gc.collect()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[217.570696, "o", "\"\"\"\r\n\u001b[?2004l\r"]
[217.570771, "o", "\u001b[?2004h> "]
[217.570845, "o", "if old not in s: raise SystemExit('driver block not found')\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(old,newdriver)\r\n\u001b[?2004l\r"]
[217.570922, "o", "\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
