[380.65975, "i", "python3 - <<'PY'\np='/app/analysis.py'\ns=open(p).read()\n# Remove any misplaced scipy.linalg import and add it with the other imports.\ns=s.replace('import scipy.linalg\\n','')\nif 'from scipy import sparse\\n' in s:\n    s=s.replace('from scipy import sparse\\n','from scipy import sparse\\nimport scipy.linalg\\n',1)\nelif 'import scipy\\n' not in s:\n    s='import scipy.linalg\\n'+s\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/analysis.py\nrm -f /app/universes.jsonl /app/results.md\npython3 -u /app/analysis.py\nwc -l /app/universes.jsonl\npython3 - <<'PY'\nimport json,collections\nxs=[json.loads(x) for x in open('/app/universes.jsonl')]\nprint('records',len(xs),'unique',len({x['universe_id'] for x in xs}),'converged',sum(x['converged'] for x in xs),'null',sum(x['estimate'] is None for x in xs))\nprint('models',collections.Counter(x['decisions']['race_adjustment_model'] for x in xs))\nprint('first',xs[0]); print('last',xs[-1])\nPY\ncat /app/results.md\n"]
