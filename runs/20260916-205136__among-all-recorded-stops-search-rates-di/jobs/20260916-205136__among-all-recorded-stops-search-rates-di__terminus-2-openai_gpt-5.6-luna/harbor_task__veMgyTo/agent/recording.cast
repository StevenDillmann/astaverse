[313.880395, "i", "python3 - <<'PY'\np='/app/analysis.py'\ns=open(p).read()\ns=s.replace('from scipy.linalg import solve\\n','from scipy.linalg import solve\\nimport scipy.linalg\\n')\ns=s.replace(\"age=age.fillna(age.median()).to_numpy(float)\\n            day=(pd.to_datetime(d['date'],errors='coerce')-pd.Timestamp('2000-01-01')).dt.days.fillna(0).to_numpy(float)\\n            mats += [sp.csr_matrix(np.column_stack([age,day]))]\", \"age=age.fillna(age.median()).to_numpy(float)\\n            age=(age-np.mean(age))/max(np.std(age),1.0)\\n            day=(pd.to_datetime(d['date'],errors='coerce')-pd.Timestamp('2000-01-01')).dt.days.fillna(0).to_numpy(float)\\n            day=(day-np.mean(day))/max(np.std(day),1.0)\\n            mats += [sp.csr_matrix(np.column_stack([age,day]))]\")\ns=s.replace(\"k=int(codes.max())+1\\n                mats.append(sp.csr_matrix((np.ones(n),(np.arange(n),codes)),shape=(n,k)))\", \"k=int(codes.max())+1\\n                # Reference coding avoids exact collinearity with the intercept.\\n                if k>1:\\n                    mats.append(sp.csr_matrix((np.ones(n),(np.arange(n),codes)),shape=(n,k))[:,1:])\")\ns=s.replace('for _ in range(30):','for _ in range(10):')\ns=s.replace(\"try: step=np.asarray(solve(H.toarray(),score,assume_a='sym')).ravel()\\n            except Exception: step=np.asarray(np.linalg.pinv(H.toarray())@score).ravel()\", \"with warnings.catch_warnings():\\n                warnings.simplefilter('ignore')\\n                try: step=np.asarray(scipy.linalg.solve(H.toarray(),score,assume_a='sym',check_finite=False)).ravel()\\n                except Exception: step=np.asarray(np.linalg.lstsq(H.toarray(),score,rcond=1e-10)[0]).ravel()\")\ns=s.replace('        bread=np.linalg.pinv(H.toarray())','        bread=np.linalg.inv(H.toarray()) if np.linalg.cond(H.toarray()) < 1e12 else np.linalg.pinv(H.toarray(),rcond=1e-10)')\ns=s.replace(\"if not converged and np.max(np.abs(step))>1e-4: return _result(n,None,None,outcome_sd,None,False)\", \"if not np.all(np.isfinite(beta)): return _result(n,None,None,outcome_sd,None,False)\")\nopen(p,'w').write(s)\nPY\nrm -f /app/universes.jsonl /app/results.md\npython3 -u /app/analysis.py\nwc -l /app/universes.jsonl\npython3 - <<'PY'\nimport json,collections\nxs=[json.loads(x) for x in open('/app/universes.jsonl')]\nprint('records',len(xs),'unique',len({x['universe_id'] for x in xs}),'converged',sum(x['converged'] for x in xs),'null',sum(x['estimate'] is None for x in xs))\nprint('models',collections.Counter(x['decisions']['race_adjustment_model'] for x in xs))\nprint('first',xs[0]); print('last',xs[-1])\nPY\ncat /app/results.md\n"]
