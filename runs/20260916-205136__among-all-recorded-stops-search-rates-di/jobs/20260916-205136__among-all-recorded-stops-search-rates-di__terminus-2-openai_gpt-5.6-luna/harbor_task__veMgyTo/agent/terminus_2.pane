    25	    return pd.Series(np.select([eth.eq('H'),raw.eq('B'),raw.eq('W'),raw.eq('A'),raw.eq('I')],
    26	        ['hispanic','black','white','asian/pacific islander','other'], default='unknown'), index=df.index).astype('string')
    27	
    28	def _groups(r):
    29	    return [x for x in RACES if (r==x).any()]
