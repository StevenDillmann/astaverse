    31	def _contrast(groups, rates, mode):
    32	    pairs=[]
    33	    if mode=='white_reference' and 'white' in groups:
    34	        pairs=[(g,'white') for g in groups if g!='white' and g!='unknown']
    35	        if not pairs: pairs=[(groups[-1],groups[0])]
    36	    else:
    37	        pairs=[(groups[i],groups[j]) for i in range(len(groups)) for j in range(i)]
    38	    vals=[(rates[a]-rates[b],a,b) for a,b in pairs]
    39	    if not vals: return None
    40	    # The primary scalar is the largest absolute requested race contrast.
    41	    return max(vals,key=lambda z:abs(z[0]))
