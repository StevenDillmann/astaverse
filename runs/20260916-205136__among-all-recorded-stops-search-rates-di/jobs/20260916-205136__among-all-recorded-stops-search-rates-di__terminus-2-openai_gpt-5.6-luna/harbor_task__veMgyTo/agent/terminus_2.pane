    43	def _cluster_se(influence, df, mode):
    44	    if mode=='iid': return math.sqrt(max(float(np.sum(influence**2)),0.0))
    45	    def one(key):
    46	        z=pd.Series(influence,index=df.index).groupby(df[key].astype('string'),dropna=False).sum().to_numpy()
    47	        return float(np.sum(z*z))
    48	    if mode=='cluster_officer': v=one('officer_id_hash')
    49	    elif mode=='cluster_department': v=one('department_name')
    50	    else: v=one('officer_id_hash')+one('department_name')
    51	    if mode=='two_way_cluster':
    52	        # inclusion-exclusion intersection clusters (officer, department)
    53	        z=pd.DataFrame({'v':influence,'o':df['officer_id_hash'].astype('string'),'d':df['department_name'].astype('string')}).groupby(['o','d'],dropna=False)['v'].sum().to_numpy()
    54	        v-=float(np.sum(z*z))
    55	    return math.sqrt(max(v,0.0))
