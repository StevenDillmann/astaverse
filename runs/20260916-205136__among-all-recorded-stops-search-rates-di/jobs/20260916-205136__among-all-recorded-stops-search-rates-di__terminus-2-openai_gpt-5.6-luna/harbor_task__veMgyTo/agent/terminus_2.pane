    71	            if au=='period_durham_county': m &= d['county_name'].eq('Durham County')
    72	            d=d.loc[m].copy(); dates=dates.loc[d.index]
    73	        r=_race(d,selections['race_definition'])
    74	        so=selections['search_outcome']
