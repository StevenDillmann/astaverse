    57	def _result(n, est, se, outcome_sd, p, conv=True):
    58	    if not conv or any(x is None or not np.isfinite(x) for x in [est,se]):
    59	        return {'estimate':None,'estimate_standardized':None,'std_error':None,'std_error_standardized':None,'ci_low_standardized':None,'ci_high_standardized':None,'p_value':None,'n':int(n),'direction':'none','converged':False}
    60	    scale=1.0/max(float(outcome_sd),1e-12)
    61	    es=est*scale; ss=abs(scale)*se
