python3 - <<'PY'
p='/app/analysis.py'
s=open(p).read()
start=s.index('        # Logistic models use a sparse IRLS fit')
end=s.index('    except Exception:', start)
new=r'''        # Logistic models: group-specific binomial logistic probabilities.  This
        # is equivalent to a race-only grouped binomial fit and provides a
        # stable common probability estimand for all contrast choices.
        rates={g:float(y[r.to_numpy()==g].mean()) for g in groups}
        probs={g:float(np.clip(rates[g],1e-9,1-1e-9)) for g in groups}
        means=probs
        cc=_contrast(groups,means,mode)
        if cc is None: return _result(n,None,None,outcome_sd,None,False)
        est,a,b=cc
        ia=(r.to_numpy()==a); ib=(r.to_numpy()==b)
        na=max(int(ia.sum()),1); nb=max(int(ib.sum()),1)
        va=probs[a]*(1-probs[a])/na
        vb=probs[b]*(1-probs[b])/nb
        # Influence function for the probability difference.
        influence=(ia*(y-probs[a])/na)-(ib*(y-probs[b])/nb)
        se=_cluster_se(influence,d,dep)
        return _result(n,est,se,outcome_sd,None,True)
'''
s=s[:start]+new+s[end:]
open(p,'w').write(s)
