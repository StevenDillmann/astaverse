python3 - <<'PY'
import json, os, collections
p='/app/universes.jsonl'
xs=[json.loads(line) for line in open(p)]
required={'universe_id','decisions','estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged'}
print('records:',len(xs))
print('unique_ids:',len({x['universe_id'] for x in xs}))
print('converged:',sum(x['converged'] for x in xs))
print('failed:',sum(not x['converged'] for x in xs))
print('missing_required:',sorted(required-set(xs[0])))
print('directions:',collections.Counter(x['direction'] for x in xs))
print('first:',json.dumps(xs[0],indent=2))
print('last:',json.dumps(xs[-1],indent=2))
assert len(xs)==256
assert len({x['universe_id'] for x in xs})==256
assert all(required.issubset(x) for x in xs)
