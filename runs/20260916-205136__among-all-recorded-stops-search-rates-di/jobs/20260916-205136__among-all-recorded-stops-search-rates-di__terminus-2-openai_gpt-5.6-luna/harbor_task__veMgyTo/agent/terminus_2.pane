python3 - <<'PY'
import json, os, py_compile
files=['/app/analysis.py','/app/universes.jsonl','/app/results.md']
print('files_exist:', {p:os.path.exists(p) for p in files})
xs=[json.loads(line) for line in open('/app/universes.jsonl')]
required={'universe_id','decisions','estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged'}
assert len(xs)==256, len(xs)
assert len({x['universe_id'] for x in xs})==256
assert all(required <= set(x) for x in xs)
assert all(x['direction'] in {'positive','negative','none'} for x in xs)
py_compile.compile('/app/analysis.py', doraise=True)
print('records=256 unique_ids=256 required_fields=ok directions=ok syntax