[364.05162, "o", "echo READY; ls -lh /app/analysis.py /app/universes.jsonl /app/results.md 2>&1; echo LINES; [ -f /app/universes.jsonl ] && wc -l /app/universes.jsonl || true; echo VALIDATE; python3 -c \"import json,glob,yaml,os; p='/app/universes.jsonl'; rows=[json.loads(x) for x in open(p)] if os.path.exists(p) else []; expected=[yaml.safe_load(open(f))['id'] for f in sorted(glob.glob('/app/universes/*.yaml'))]; req={'universe_id','decisions','estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged'}; print('rows',len(rows),'expected',len(expected),'unique',len({r['universe_id'] for r in rows}),'missing_ids',len(set(expected)-{r['universe_id'] for r in rows}),'extra_ids',len({r['universe_id'] for r in rows}-set(expected)),'missing_fields',sum(1 for r in rows if req-set(r)),'converged',sum(bool(r['converged']) for r in rows)); print('first',rows[0] if rows else None); print('last',rows[-1] if rows else None)\"; echo REPORT; [ -f /app/results.md ] && cat /app/results.md || true\r\n\u001b[?2004l\rREADY\r\n"]
