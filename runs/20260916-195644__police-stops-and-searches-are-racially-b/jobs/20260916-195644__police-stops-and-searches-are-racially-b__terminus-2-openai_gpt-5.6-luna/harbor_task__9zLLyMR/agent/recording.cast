[212.791839, "o", "        res=minimize(fun,np.zeros(X.shape[1]),jac=jac,method='L-BFGS-B',options={'maxiter':80,'maxls':20})\r\n\u001b[?2004l\r\u001b[?2004h"]
[212.791924, "o", "> "]
[212.791992, "o", "        if not res.success: return empty(len(y))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.792206, "o", "        b=res.x; p=expit(X@b); w=p*(1-p); H=(X.T*w)@X+np.eye(X.shape[1])*1e-7; bread=np.linalg.pinv(H)\r\n\u001b[?2004l\rith clustered sandwic\u001b[?2004h"]
[212.792229, "o", "> "]
[212.792531, "o", "        if s.get('outcome_model_and_inference') in ('adjusted_logistic_officer_clustered','department_and_officer_controls'):\r\n\u001b[?2004l\r"]
[212.79267, "o", "\u001b[?2004h>             meat=np.zeros_like(H)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.792769, "o", "            uu=X*(yy-p)[:,None]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.792838, "o", "            for z in np.unique(groups):\r\n\u001b[?2004l\r"]
[212.792853, "o", "\u001b[?2004h> "]
[212.793075, "o", "                q=uu[groups==z].sum(axis=0); meat+=np.outer(q,q)\r\n\u001b[?2004l\r"]
[212.793151, "o", "\u001b[?2004h> "]
[212.793237, "o", "            cov=bread@meat@bread\r\n\u001b[?2004l\rri\u001b[?2004h>         else: cov=bread\r\n\u001b[?2004l\r   \u001b[?2004h"]
[212.79336, "o", "> "]
[212.793552, "o", "        se=math.sqrt(max(float(cov[j,j]),1e-20)); sd=float(np.std(X[:,j],ddof=1))\r\n\u001b[?2004l\r"]
[212.793679, "o", "\u001b[?2004h>         return std_result(float(b[j]),se,len(y),sd)\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception: return empty(len(y))\r\n\u001b[?2004l\r    g={}\r\n            for r "]
[212.793741, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ri\u001b[?2004h> def one(d,y,s):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.793972, "o", "    y=pd.Series(y,index=d.index); ok=y.notna() & d.subject_race.notna(); d=d.loc[ok]; y=y.loc[ok].astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.794136, "o", "    if len(y)<20 or y.nunique()<2 or 'white' not in set(d.subject_race): return empty(len(y))\r\n\u001b[?2004l\rns e\u001b[?2004h> "]
[212.794363, "o", "    if s.get('outcome_model_and_inference')!='unadjusted_proportions_iid': return fit_adjusted(d,y,s)\r\n\u001b[?2004l\r"]
[212.794392, "o", "\u001b[?2004h> "]
[212.794695, "o", "    races=['black'] if s.get('race_comparison_set')=='black_vs_white' else [r for r in d.subject_race.unique() if r!='white']\r\n\u001b[?2004l\rp/analy\u001b[?2004h> "]
[212.794884, "o", "    out=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for r in races:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.795057, "o", "        a=y[d.subject_race.eq(r)]; b=y[d.subject_race.eq('white')]\r\n\u001b[?2004l\rs=[jso\u001b[?2004h> "]
[212.795192, "o", "        if len(a)<2 or len(b)<2: continue\r\n\u001b[?2004l\r"]
[212.795219, "o", "\u001b[?2004h> "]
[212.795691, "o", "        diff=float(a.mean()-b.mean()); se=math.sqrt(max(a.mean()*(1-a.mean())/len(a)+b.mean()*(1-b.mean())/len(b),1e-20)); sd=float(np.std(np.r_[np.ones(len(a)),np.zeros(len(b))],ddof=1)); out.append((diff,se,sd))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.795722, "o", "    if not out: return empty(len(y))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.796059, "o", "    e=float(np.mean([z[0] for z in out])); sd=float(np.mean([z[2] for z in out])); se=float(math.sqrt(np.mean([(z[1]*z[2])**2 for z in out])))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.796237, "o", "    return std_result(e,se,len(y),sd,raw_se=float(np.mean([z[1] for z in out])))\r\n\u001b[?2004l\r"]
[212.796317, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.796438, "o", "def combine(a):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.796466, "o", "    a=[z for z in a if z.get('converged') and z.get('std_error_standardized',0)>0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.796541, "o", "    if not a: return empty(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.796841, "o", "    w=np.array([1/z['std_error_standardized']**2 for z in a]); e=float(np.average([z['estimate_standardized'] for z in a],weights=w)); se=float(1/math.sqrt(w.sum()))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.797527, "o", "    return {'estimate':float(np.average([z['estimate'] for z in a],weights=w)),'estimate_standardized':e,'std_error':float(np.average([z['std_error'] for z in a],weights=w)),'std_error_standardized':se,'ci_low_standardized':e-1.96*se,'ci_high_standardized':e+1.96*se,'p_value':float(2*stats.norm.sf(abs(e/se))),'n':int(max(z['n'] for z in a)),'direction':'positive' if e>0 else ('negative' if e<0 else 'none'),'converged':True}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[212.797559, "o", "\u001b[?2004h> def analyze(df,selections):\r\n\u001b[?2004l\r\u001b[?2004h"]
[212.79765, "o", "> "]
[212.797839, "o", "    d=prep(df,selections); o=selections.get('bias_outcome'); r=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.798033, "o", "    if o in ('search_rate','search_and_hit_rates'): r.append(one(d,d.search_conducted,selections))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.79819, "o", "    if o in ('contraband_hit_rate','search_and_hit_rates'):\r\n\u001b[?2004l\r"]
[212.798304, "o", "\u001b[?2004h> "]
[212.798552, "o", "        q=d[d.search_conducted.eq(1)]; c={'any_contraband':'contraband_found','drugs_only':'contraband_drugs','weapons_only':'contraband_weapons'}.get(selections.get('hit_definition'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.798635, "o", "        if c: r.append(one(q,q[c],selections))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.798802, "o", "    return combine(r) if len(r)>1 else (r[0] if r else empty(0))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.798906, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.799089, "o", "    df=pd.read_csv('/app/data.csv',usecols=KEY,low_memory=False)\r\n\u001b[?2004l\r"]
[212.799116, "o", "\u001b[?2004h> "]
[212.799275, "o", "    paths=sorted(glob.glob('/app/universes/*.yaml')); rows=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.799387, "o", "    with open('/app/universes.jsonl','w') as out:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.799461, "o", "        for path in paths:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.799547, "o", "            with open(path) as f: u=yaml.safe_load(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.799729, "o", "            s={z['decision_id']:z['option_id'] for z in u['decisions']}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.799752, "o", "            try: r=analyze(df,s)\r\n\u001b[?2004l\r"]
[212.799839, "o", "\u001b[?2004h> "]
[212.799972, "o", "            except Exception: r=empty(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.800168, "o", "            row={'universe_id':u['id'],'decisions':s,**r}; rows.append(row); out.write(json.dumps(row,allow_nan=False)+'\\n'); out.flush()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.80046, "o", "    good=[r for r in rows if r['converged'] and r['estimate_standardized'] is not None]; v=[r['estimate_standardized'] for r in good]\r\n\u001b[?2004l\r"]
[212.800561, "o", "\u001b[?2004h> "]
[212.801498, "o", "    lines=['# Multiverse analysis report','',f'Evaluated {len(rows)} universes; {len(good)} converged.','', 'The single parameterized `analyze` function applies every selection from the universe YAML. Geography and race filters are applied first. Search rate uses all eligible stops; hit rate restricts to searched stops and uses the selected contraband field. Clock/calendar or veil-of-darkness controls are added when selected. Unadjusted results are proportion differences; adjusted results are logistic fits with clustered sandwich uncertainty for officer-clustered specifications. Estimates are standardized by the sample SD of the focal race indicator.']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.801611, "o", "    if v:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.801916, "o", "        lines += ['',f'Standardized estimates range from {min(v):.5g} to {max(v):.5g}; median {np.median(v):.5g}. Positive values indicate a higher outcome for the focal black/non-white comparison than white.']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.802139, "o", "        for k in ['geographic_scope','race_comparison_set','bias_outcome','hit_definition','time_of_day_adjustment','outcome_model_and_inference']:\r\n\u001b[?2004l\r\u001b[?2004h>             g={}\r\n\u001b[?2004l\r"]
[212.802166, "o", "\u001b[?2004h> "]
[212.802388, "o", "            for r in good: g.setdefault(r['decisions'].get(k),[]).append(r['estimate_standardized'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.8027, "o", "            spans=[max(x)-min(x) for x in g.values() if len(x)>1]; lines.append(f'- {k}: maximum within-option spread {max(spans) if spans else 0:.5g}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.802878, "o", "    lines += ['', 'Failed fits retain null statistics and converged=false; no verdict is included.']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.803, "o", "    open('/app/results.md','w').write('\\n'.join(lines)+'\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.803044, "o", "if __name__=='__main__': main()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[212.804161, "o", "\u001b[?2004hroot@ede6727f70cf:/app# python3 /app/analysis.py\r\n\u001b[?2004l\r"]
[291.839551, "i", "printf 'Files:\\n'; ls -lh /app/universes.jsonl /app/results.md 2>&1; printf '\\nValidation:\\n'; if [ -f /app/universes.jsonl ]; then wc -l /app/universes.jsonl; python3 - <<'PY'\nimport json\np='/app/universes.jsonl'\nrows=[json.loads(x) for x in open(p)]\nrequired={'universe_id','decisions','estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged'}\nprint('rows',len(rows))\nprint('unique_ids',len({r['universe_id'] for r in rows}))\nprint('converged',sum(bool(r['converged']) for r in rows))\nprint('missing_required',sum(bool(required-set(r)) for r in rows))\nprint('first',rows[0])\nprint('last',rows[-1])\nPY\nfi; if [ -f /app/results.md ]; then printf '\\nReport:\\n'; cat /app/results.md; fi\n"]
[291.840008, "o", "printf 'Files:\\n'; ls -lh /app/universes.jsonl /app/results.md 2>&1; printf '\\nValidation:\\n'; if [ -f /app/universes.jsonl ]; then wc -l /app/universes.jsonl; python3 - <<'PY'\r\nimport json\r\np='/app/universes.jsonl'\r\nrows=[json.loads(x) for x in open(p)]\r\nrequired={'universe_id','decisions','estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged'}\r\nprint('rows',len(rows))\r\nprint('unique_ids',len({r['universe_id'] for r in rows}))\r\nprint('converged',sum(bool(r['converged']) for r in rows))\r\nprint('missing_required',sum(bool(required-set(r)) for r in rows))\r\nprint('first',rows[0])\r\nprint('last',rows[-1])\r\nPY\r\nfi; if [ -f /app/results.md ]; then printf '\\nReport:\\n'; cat /app/results.md; fi\r\n"]
[320.902107, "i", "printf 'STATUS\\n'; printf 'jsonl: '; if [ -f /app/universes.jsonl ]; then wc -l < /app/universes.jsonl; else echo missing; fi; printf 'report: '; if [ -f /app/results.md ]; then echo present; else echo missing; fi; python3 - <<'PY'\nimport os,json\np='/app/universes.jsonl'\nif not os.path.exists(p):\n print('No JSONL output found')\n raise SystemExit\nrows=[]\nfor line in open(p):\n try: rows.append(json.loads(line))\n except Exception as e: print('bad line',len(rows)+1,e)\nreq={'universe_id','decisions','estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged'}\nprint('rows=',len(rows))\nprint('unique_ids=',len({r.get('universe_id') for r in rows}))\nprint('converged=',sum(bool(r.get('converged')) for r in rows))\nprint('missing_required=',sum(bool(req-set(r)) for r in rows))\nprint('first=',rows[0] if rows else None)\nprint('last=',rows[-1] if rows else None)\nPY\n[ -f /app/results.md ] && sed -n '1,120p' /app/results.md\n"]
[320.902296, "o", "printf 'STATUS\\n'; printf 'jsonl: '; if [ -f /app/universes.jsonl ]; then wc -l < /app/universes.jsonl; else echo missing; fi; printf 'report: '; if [ -f /app/results.md ]; then echo present; else echo missing; fi; python3 - <<'PY'\r\nimport os,json\r\np='/app/universes.jsonl'\r\nif not os.path.exists(p):\r\n print('No JSONL output found')\r\n raise SystemExit\r\nrows=[]\r\nfor line in open(p):\r\n try: rows.append(json.loads(line))\r\n except Exception as e: print('bad line',len(rows)+1,e)\r\nreq={'universe_id','decisions','estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged'}\r\nprint('rows=',len(rows))\r\nprint('unique_ids=',len({r.get('universe_id') for r in rows}))\r\nprint('converged=',sum(bool(r.get('converged')) for r in rows))\r\nprint('missing_required=',sum(bool(req-set(r)) for r in rows))\r\nprint('first=',rows[0] if rows else None)\r\nprint('last=',rows[-1] if rows else None)\r\nPY\r\n[ -f /app/results.md ] && sed -n '1,120p' /app/results.md\r\n"]
[361.354985, "i", "echo READY; ls -lh /app/analysis.py /app/universes.jsonl /app/results.md 2>&1; echo LINES; [ -f /app/universes.jsonl ] && wc -l /app/universes.jsonl || true; echo VALIDATE; python3 -c \"import json,glob,yaml,os; p='/app/universes.jsonl'; rows=[json.loads(x) for x in open(p)] if os.path.exists(p) else []; expected=[yaml.safe_load(open(f))['id'] for f in sorted(glob.glob('/app/universes/*.yaml'))]; req={'universe_id','decisions','estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged'}; print('rows',len(rows),'expected',len(expected),'unique',len({r['universe_id'] for r in rows}),'missing_ids',len(set(expected)-{r['universe_id'] for r in rows}),'extra_ids',len({r['universe_id'] for r in rows}-set(expected)),'missing_fields',sum(1 for r in rows if req-set(r)),'converged',sum(bool(r['converged']) for r in rows)); print('first',rows[0] if rows else None); print('last',rows[-1] if rows else None)\"; echo REPORT; [ -f /app/results.md ] && cat /app/results.md || true\n"]
[361.355393, "o", "echo READY; ls -lh /app/analysis.py /app/universes.jsonl /app/results.md 2>&1; echo LINES; [ -f /app/universes.jsonl ] && wc -l /app/universes.jsonl || true; echo VALIDATE; python3 -c \"import json,glob,yaml,os; p='/app/universes.jsonl'; rows=[json.loads(x) for x in open(p)] if os.path.exists(p) else []; expected=[yaml.safe_load(open(f))['id'] for f in sorted(glob.glob('/app/universes/*.yaml'))]; req={'universe_id','decisions','estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged'}; print('rows',len(rows),'expected',len(expected),'unique',len({r['universe_id'] for r in rows}),'missing_ids',len(set(expected)-{r['universe_id'] for r in rows}),'extra_ids',len({r['universe_id'] for r in rows}-set(expected)),'missing_fields',sum(1 for r in rows if req-set(r)),'converged',sum(bool(r['converged']) for r in rows)); print('first',rows[0] if rows else None); print('last',rows[-1] if rows else None)\"; echo REPORT; [ -f /app/results.md ] && cat /app/results.md || true\r\n"]
