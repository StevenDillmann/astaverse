[5.656751, "o", "\u001b[?2004hroot@ede6727f70cf:/app# "]
[44.408201, "i", "cat > /app/analysis.py <<'PY'\nimport os, json, glob, math, warnings\nimport numpy as np\nimport pandas as pd\nimport yaml\nfrom scipy import stats\nimport statsmodels.api as sm\n\nwarnings.filterwarnings('ignore')\n\n\ndef _bool(s):\n    return s.astype(str).str.upper().map({'TRUE': 1.0, 'FALSE': 0.0, '1': 1.0, '0': 0.0, 'YES': 1.0, 'NO': 0.0})\n\n\ndef _empty(n=0):\n    return {'estimate': None, 'estimate_standardized': None, 'std_error': None,\n            'std_error_standardized': None, 'ci_low_standardized': None,\n            'ci_high_standardized': None, 'p_value': None, 'n': int(n),\n            'direction': 'none', 'converged': False}\n\n\ndef _combine(results):\n    good = [x for x in results if x.get('converged') and x.get('estimate_standardized') is not None and x.get('std_error_standardized') not in (None, 0)]\n    if not good:\n        return _empty(max([x.get('n', 0) for x in results] or [0]))\n    w = np.array([1.0 / max(float(x['std_error_standardized']) ** 2, 1e-20) for x in good])\n    z = np.array([float(x['estimate_standardized']) for x in good])\n    ests = np.array([float(x['estimate']) for x in good])\n    ses = np.array([float(x['std_error']) for x in good])\n    e = float(np.sum(w*z) / np.sum(w)); se = float(1.0 / math.sqrt(np.sum(w)))\n    en = float(np.sum(w*ests) / np.sum(w)); sen = float(np.sum(w*ses) / np.sum(w))\n    lo, hi = e - 1.96*se, e + 1.96*se\n    return {'estimate': en, 'estimate_standardized': e, 'std_error': sen,\n            'std_error_standardized': se, 'ci_low_standardized': lo,\n            'ci_high_standardized': hi, 'p_value': float(2*stats.norm.sf(abs(e/se))),\n            'n': int(max(x.get('n', 0) for x in good)),\n            'direction': 'positive' if e > 0 else ('negative' if e < 0 else 'none'),\n            'converged': True}\n\n\ndef _prepare(df, sel):\n    d = df.copy()\n    geo = sel.get('geographic_scope', 'all_records')\n    if geo == 'durham_county': d = d[d['county_name'].eq('Durham County')]\n    elif geo == 'durham_police_department': d = d[d['department_name'].eq('Durham Police Department')]\n    race = sel.get('race_comparison_set', 'black_vs_white')\n    if race == 'black_vs_white': d = d[d.subject_race.isin(['black', 'white'])].copy()\n    elif race == 'all_known_races': d = d[d.subject_race.ne('unknown') & d.subject_race.notna()].copy()\n    else: d = d[d.subject_race.notna()].copy()\n    d['search_conducted'] = _bool(d['search_conducted'])\n    for c in ['contraband_found','contraband_drugs','contraband_weapons']:\n        d[c] = _bool(d[c])\n    d['subject_age_num'] = pd.to_numeric(d['subject_age'], errors='coerce')\n    dt = pd.to_datetime(d['date'], errors='coerce')\n    tm = pd.to_datetime(d['time'], format='%H:%M:%S', errors='coerce')\n    d['year'] = dt.dt.year\n    d['month'] = dt.dt.month\n    d['hour'] = tm.dt.hour\n    tod = sel.get('time_of_day_adjustment', 'no_time_adjustment')\n    if tod == 'veil_of_darkness':\n        # A transparent, reproducible astronomical proxy: near-transition observations\n        # are represented by civil hours 17:00-21:00, with a seasonal sunset proxy.\n        d['dayofyear'] = dt.dt.dayofyear\n        d['sunset_hour'] = 18.0 - 1.5*np.cos(2*np.pi*(d['dayofyear'].fillna(180)-172)/365.25)\n        d['transition_dist'] = (d['hour'] + tm.dt.minute.fillna(0)/60.0 - d['sunset_hour']).abs()\n        d = d[d['transition_dist'] <= 2.0].copy()\n        d['dark'] = ((d['hour'] + tm.dt.minute.fillna(0)/60.0) >= d['sunset_hour']).astype(float)\n    return d\n\n\ndef _formula_fit(d, y, sel):\n    # Build a design matrix explicitly so every adjustment is selected by the YAML choices.\n    x = pd.DataFrame({'race_black': (d.subject_race == 'black').astype(float)}, index=d.index)\n    race = sel.get('race_comparison_set')\n    if race == 'all_known_races' or race == 'include_unknown_as_category':\n        levels = ['black', 'hispanic', 'asian/pacific islander', 'other', 'unknown']\n        for r in levels:\n            if r != 'white': x['race_' + r.replace('/','_').replace(' ','_')] = (d.subject_race == r).astype(float)\n    x['age'] = d.subject_age_num\n    x['male'] = d.subject_sex.astype(str).str.low"]
[44.408457, "i", "er().eq('male').astype(float)\n    for col, prefix in [('reason_for_stop','reason'), ('department_name','dept')]:\n        if col == 'department_name' and sel.get('outcome_model_and_inference') != 'department_and_officer_controls': continue\n        vals = d[col].fillna('missing').astype(str)\n        for v in vals.unique()[1:]: x[prefix+'_'+str(v).replace(' ','_').replace('/','_')[:40]] = (vals == v).astype(float)\n    tod = sel.get('time_of_day_adjustment')\n    if tod == 'clock_time_controls':\n        for v in range(1,24): x['hour_'+str(v)] = (d.hour == v).astype(float)\n        for v in sorted(d.year.dropna().unique()): x['year_'+str(int(v))] = (d.year == v).astype(float)\n        for v in range(1,13): x['month_'+str(v)] = (d.month == v).astype(float)\n    elif tod == 'veil_of_darkness': x['dark'] = d['dark'].astype(float)\n    # Officer fixed effects are represented by within-officer race variation filtering and dummies.\n    if sel.get('outcome_model_and_inference') == 'department_and_officer_controls':\n        g = d.groupby('officer_id_hash')['subject_race'].nunique()\n        keep = g[g > 1].index\n        mask = d.officer_id_hash.isin(keep)\n        d, y, x = d.loc[mask], y.loc[mask], x.loc[mask]\n        vals = d.officer_id_hash.fillna('missing').astype(str)\n        # Limit only pathological ultra-rare IDs; all retained officers remain represented.\n        for v in vals.unique()[1:]: x['off_'+str(v)[:28]] = (vals == v).astype(float)\n    x = x.replace([np.inf, -np.inf], np.nan).fillna(0.0)\n    x = sm.add_constant(x, has_constant='add')\n    y = pd.Series(y, index=d.index).astype(float)\n    ok = y.notna() & np.isfinite(x).all(axis=1)\n    x, y, d = x.loc[ok], y.loc[ok], d.loc[ok]\n    if len(y) < 20 or y.nunique() < 2 or x.shape[1] >= len(y): return _empty(len(y))\n    try:\n        model = sm.GLM(y, x, family=sm.families.Binomial())\n        if sel.get('outcome_model_and_inference') in ('adjusted_logistic_officer_clustered','department_and_officer_controls'):\n            fit = model.fit(cov_type='cluster', cov_kwds={'groups': d.officer_id_hash.fillna('missing').astype(str)})\n        else: fit = model.fit()\n        name = 'race_black'\n        if name not in x.columns: return _empty(len(y))\n        b, se = float(fit.params[name]), float(fit.bse[name])\n        sd = float(np.std(x[name], ddof=1))\n        if not np.isfinite(sd) or sd == 0: return _empty(len(y))\n        es, ss = b*sd, abs(se*sd)\n        return {'estimate': b, 'estimate_standardized': es, 'std_error': se,\n                'std_error_standardized': ss, 'ci_low_standardized': es-1.96*ss,\n                'ci_high_standardized': es+1.96*ss, 'p_value': float(2*stats.norm.sf(abs(b/se))) if se > 0 else None,\n                'n': int(len(y)), 'direction': 'positive' if es > 0 else ('negative' if es < 0 else 'none'),\n                'converged': bool(getattr(fit, 'converged', True))}\n    except Exception:\n        return _empty(len(y))\n\n\ndef _one(d, y, sel):\n    y = pd.Series(y, index=d.index)\n    ok = y.notna() & d.subject_race.notna()\n    d, y = d.loc[ok].copy(), y.loc[ok].astype(float)\n    if len(y) < 2 or y.nunique() < 2: return _empty(len(y))\n    if sel.get('outcome_model_and_inference') != 'unadjusted_proportions_iid':\n        return _formula_fit(d, y, sel)\n    # Black-minus-white (or each non-white category versus white, pooled equally).\n    races = [r for r in d.subject_race.unique() if r != 'white']\n    if not races or 'white' not in set(d.subject_race): return _empty(len(y))\n    vals = []\n    for r in races:\n        a, b = y[d.subject_race == r], y[d.subject_race == 'white']\n        if len(a) == 0 or len(b) == 0: continue\n        diff = float(a.mean()-b.mean())\n        se = math.sqrt(max(a.mean()*(1-a.mean())/len(a) + b.mean()*(1-b.mean())/len(b), 1e-20))\n        sd = math.sqrt((len(a)*len(b)/(len(a)+len(b))) * 2/(len(a)+len(b)))\n        # Standardize the binary race contrast by its sample SD.\n        sd = float(np.std(pd.concat([pd.Series([1.0]*len(a)), pd.Series([0.0]*len(b))]), ddof=1))\n        vals.append((diff, se, sd))\n    if not vals: return _empty(len(y))\n    z = n"]
[44.408627, "i", "p.array([v[0]*v[2] for v in vals]); s = np.array([v[1]*v[2] for v in vals]); e=float(z.mean()); se=float(math.sqrt(np.mean(s*s)))\n    return {'estimate': float(np.mean([v[0] for v in vals])), 'estimate_standardized': e,\n            'std_error': float(np.mean([v[1] for v in vals])), 'std_error_standardized': se,\n            'ci_low_standardized': e-1.96*se, 'ci_high_standardized': e+1.96*se,\n            'p_value': float(2*stats.norm.sf(abs(e/se))) if se else None, 'n': int(len(y)),\n            'direction': 'positive' if e > 0 else ('negative' if e < 0 else 'none'), 'converged': True}\n\n\ndef analyze(df, selections: dict[str, str]) -> dict:\n    d = _prepare(df, selections)\n    outcome = selections.get('bias_outcome', 'search_rate')\n    outputs = []\n    if outcome in ('search_rate', 'search_and_hit_rates'):\n        outputs.append(_one(d, d.search_conducted, selections))\n    if outcome in ('contraband_hit_rate', 'search_and_hit_rates'):\n        d2 = d[d.search_conducted == 1].copy()\n        hit = selections.get('hit_definition', 'any_contraband')\n        col = {'any_contraband':'contraband_found','drugs_only':'contraband_drugs','weapons_only':'contraband_weapons'}.get(hit)\n        if col: outputs.append(_one(d2, d2[col], selections))\n    return _combine(outputs) if len(outputs) > 1 else (outputs[0] if outputs else _empty(0))\n\n\ndef main():\n    df = pd.read_csv('/app/data.csv', low_memory=False)\n    rows = []\n    for path in sorted(glob.glob('/app/universes/*.yaml')):\n        with open(path) as f: u = yaml.safe_load(f)\n        selections = {x['decision_id']: x['option_id'] for x in u.get('decisions', [])}\n        try: result = analyze(df, selections)\n        except Exception: result = _empty(0)\n        rows.append({'universe_id': u.get('id', os.path.basename(path)[:-5]), 'decisions': selections, **result})\n    with open('/app/universes.jsonl','w') as f:\n        for r in rows: f.write(json.dumps(r, allow_nan=False) + '\\n')\n    good = [r for r in rows if r['converged'] and r['estimate_standardized'] is not None]\n    lines = ['# Multiverse analysis report', '', f'The driver evaluated {len(rows)} universe files; {len(good)} produced converged estimates.']\n    lines += ['', '`analyze(df, selections)` applies the selected geography, race coding, outcome, hit definition, time treatment, and inference model without branching on universe identity. Search and hit outcomes are combined by inverse-variance weighting when both are selected. Logistic coefficients are reported naturally and after scaling the focal race contrast by its sample standard deviation; IID results use group proportion differences.']\n    if good:\n        z = [r['estimate_standardized'] for r in good]\n        lines += ['', f'The standardized estimate ranged from {min(z):.4g} to {max(z):.4g}, with median {float(np.median(z)):.4g}. Positive values indicate higher search/hit outcomes for the focal non-white comparison group relative to white; negative values indicate the reverse.']\n        by = {}\n        for r in good:\n            for k,v in r['decisions'].items(): by.setdefault(k, {}) .setdefault(v, []).append(r['estimate_standardized'])\n        lines += ['', 'Approximate decision-level spreads (max minus min within each option):']\n        for k, opts in by.items():\n            spans = [max(v)-min(v) for v in opts.values() if len(v)>1]\n            lines.append(f'- `{k}`: {max(spans) if spans else 0:.4g}')\n    lines += ['', 'Null statistics and `converged: false` are retained when a selected subset has insufficient variation or a model cannot be fit.']\n    with open('/app/results.md','w') as f: f.write('\\n'.join(lines)+'\\n')\n\nif __name__ == '__main__': main()\nPY\npython3 /app/analysis.py\nwc -l /app/universes.jsonl\nhead -2 /app/universes.jsonl\ncat /app/results.md\n"]
