[5.642199, "o", "id: universe_000\r\ndecisions:\r\n- decision_id: bias_outcome\r\n  option_id: search_and_hit_rates\r\n- decision_id: geographic_scope\r\n  option_id: all_records\r\n- decision_id: hit_definition\r\n  option_id: any_contraband\r\n- decision_id: outcome_model_and_inference\r\n  option_id: unadjusted_proportions_iid\r\n- decision_id: race_comparison_set\r\n  option_id: black_vs_white\r\n- decision_id: time_of_day_adjustment\r\n  option_id: no_time_adjustment\r\n"]
[5.642328, "o", "\r\nAstra:\r\n"]
[5.643044, "o", "id: nc-durham-stops_multiverse\r\nname: 'nc-durham-stops: multiverse analysis'\r\ndescription: Decision space extracted by mode 'direct'.\r\ninputs:\r\n- id: dataset\r\n  type: data\r\n  source: /Users/stevend/Desktop/Asta/astaverse/data/datasets/nc-durham-stops/data.csv\r\n  description: Primary dataset under analysis\r\noutputs:\r\n- id: universe_stats\r\n  type: table\r\n  description: 'Per-universe statistics (estimate, estimate_standardized, std_error, std_error_standardized,\r\n    95% standardized confidence interval, p_value, n, direction). Carries no verdict by design: verdicts\r\n    are assigned downstream.'\r\n  inputs:\r\n  - dataset\r\n  decisions:\r\n  - bias_outcome\r\n  - geographic_scope\r\n  - hit_definition\r\n  - outcome_model_and_inference\r\n  - race_comparison_set\r\n  - time_of_day_adjustment\r\n  recipe:\r\n    command: python /app/analysis.py\r\ndecisions:\r\n  geographic_scope:\r\n    label: Geographic scope of stops\r\n    rationale: 'Which records should represent the population of police stops being tested for racial\r\n      bias?  [found by: direct]'\r\n    default: all_records\r\n    options:\r\n      all_records:\r\n        label: All records in the dataset\r\n        description: Include every row with a usable subject_race value, regardless of county_name, location,\r\n          or department_name.\r\n      durham_county:\r\n        label: Durham County stops\r\n        description: Keep only rows where county_name equals \"Durham County\"; retain stops from all departments\r\n          in that county.\r\n      durham_police_department:\r\n        label: Durham Police Department stops\r\n        description: Keep only rows where department_name equals \"Durham Police Department\", regardless\r\n          of county_name.\r\n    x_astaverse:\r\n      kind: preprocessing\r\n      post_hoc: false\r\n      option_support:\r\n        all_records: []\r\n        durham_county: []\r\n        durham_police_department: []\r\n  race_comparison_set:\r\n    label: Race comparison and coding\r\n    rationale: 'Which recorded driver-race groups should be compared?  [found by: direct]'\r\n    default: black_vs_white\r\n    options:\r\n      black_vs_white:\r\n        label: Black versus white comparison\r\n        description: Keep only rows with subject_race equal to \"black\" or \"white\"; model or report the\r\n"]
[5.643066, "o", "          black-minus-white difference, with white as the reference group.\r\n      all_known_races:\r\n        label: All known race categories\r\n        description: Keep all rows whose subject_race is not \"unknown\" and estimate separate associations\r\n          for black, white, hispanic, asian/pacific islander, and other, using white as the reference\r\n          group.\r\n      include_unknown_as_category:\r\n        label: Include unknown race as a category\r\n        description: Retain all rows, including subject_race equal to \"unknown\", and treat \"unknown\" as\r\n          an additional categorical race level rather than missing data.\r\n    x_astaverse:\r\n      kind: variable_choice\r\n      post_hoc: false\r\n      option_support:\r\n        black_vs_white: []\r\n        all_known_races: []\r\n        include_unknown_as_category: []\r\n  bias_outcome:\r\n    label: Primary observable outcome\r\n    rationale: 'Which observable consequence of a stop should be treated as the test outcome for racial\r\n      bias?  [found by: direct]'\r\n    default: search_and_hit_rates\r\n    options:\r\n      search_rate:\r\n        label: Search-conducted rate\r\n        description: Use search_conducted as a binary outcome for every included stop; estimate the racial\r\n          difference in the probability of a search.\r\n      contraband_hit_rate:\r\n"]
[5.643191, "o", "        label: Contraband hit rate among searches\r\n        description: Restrict to stops with search_conducted equal to 1 and use contraband_found as the\r\n          binary outcome; estimate racial differences in the probability that a search recovered contraband.\r\n      search_and_hit_rates:\r\n        label: Both search rate and hit rate\r\n        description: Report a search_conducted outcome for all included stops and a separate contraband_found\r\n          outcome among searched stops, treating both as primary racial-bias tests.\r\n    x_astaverse:\r\n      kind: variable_choice\r\n      post_hoc: false\r\n      option_support:\r\n        search_rate: []\r\n        contraband_hit_rate: []\r\n        search_and_hit_rates: []\r\n  hit_definition:\r\n    label: Definition of a contraband hit\r\n    rationale: 'When a hit-rate analysis is conducted, what should count as recovered contraband?  [found\r\n      by: direct]'\r\n    default: any_contraband\r\n    options:\r\n      any_contraband:\r\n        label: Any contraband\r\n        description: Among rows with search_conducted equal to 1, code a hit as contraband_found equal\r\n          to TRUE and a non-hit as contraband_found equal to FALSE; exclude missing contraband_found values.\r\n        incompatible_with:\r\n        - bias_outcome.search_rate\r\n      drugs_only:\r\n        label: Drugs only\r\n        description: Among rows with search_conducted equal to 1, use contraband_drugs as the binary hit\r\n          outcome; exclude rows where contraband_drugs is missing.\r\n        incompatible_with:\r\n        - bias_outcome.search_rate\r\n      weapons_only:\r\n        label: Weapons only\r\n        description: Among rows with search_conducted equal to 1, use contraband_weapons as the binary\r\n          hit outcome; exclude rows where contraband_weapons is missing.\r\n        incompatible_with:\r\n        - bias_outcome.search_rate\r\n      not_applicable:\r\n        label: Not applicable\r\n        description: Do not define a hit outcome because the analysis uses only search_conducted.\r\n        incompatible_with:\r\n        - bias_outcome.contraband_hit_rate\r\n        - bias_outcome.search_and_hit_rates\r\n    x_astaverse:\r\n      kind: variable_choice\r\n      post_hoc: false\r\n      option_support:\r\n        any_contraband: []\r\n        drugs_only: []\r\n        weapons_only: []\r\n        not_applicable: []\r\n  time_of_day_adjustment:\r\n    label: Treatment of stop time\r\n    rationale: 'How should date and time be used when comparing racial search or hit outcomes?  [found\r\n      by: direct]'\r\n    default: no_time_adjustment\r\n    options:\r\n      no_time_adjustment:\r\n        label: No time adjustment\r\n        description: Use date and time only for parsing or descriptive summaries; estimate racial differences\r\n          without conditioning on date, hour, or daylight status.\r\n      clock_time_controls:\r\n        label: Clock-time and calendar controls\r\n        description: Include hour-of-day indicators derived from time, plus calendar-year and month indicators\r\n          derived from date, as adjustment variables in the outcome model.\r\n      veil_of_darkness:\r\n        label: Veil-of-darkness comparison\r\n        description: Construct daylight status from date, time, and a specified sunset calculation for\r\n          the stop location; compare stops near the daylight-to-dark transition while controlling for\r\n          date or season, rather than using all hours equally.\r\n    x_astaverse:\r\n      kind: model\r\n      post_hoc: false\r\n      option_support:\r\n        no_time_adjustment: []\r\n        clock_time_controls: []\r\n        veil_of_darkness: []\r\n  outcome_model_and_inference:\r\n    label: Outcome model and uncertainty calculation\r\n    rationale: 'How should racial differences be estimated and how should repeated stops or officers affect\r\n      uncertainty?  [found by: direct]'\r\n    default: unadjusted_proportions_iid\r\n    options:\r\n      unadjusted_proportions_iid:\r\n        label: Unadjusted proportions with independent-stop uncertainty\r\n        description: Estimate group-specific outcome proportions and their differences directly, using\r\n"]
[5.643209, "o", "          a two-sample proportion test or equivalent model with observations treated as independent; do\r\n          not adjust for subject_age, subject_sex, reason_for_stop, officer_id_hash, or department_name.\r\n      adjusted_logistic_officer_clustered:\r\n        label: Covariate-adjusted logistic regression clustered by officer\r\n        description: Fit a logistic regression for the selected binary outcome with race, subject_age,\r\n          subject_sex, and reason_for_stop as predictors; include calendar or time variables only if selected\r\n          separately, and use officer_id_hash-clustered standard errors."]
[5.643223, "o", "\r\n      department_and_officer_controls:\r\n        label: Officer and department controls\r\n        description: Fit a logistic regression including race, subject_age, subject_sex, reason_for_stop,\r\n          department_name indicators, and officer_id_hash fixed effects, with uncertainty clustered by\r\n          officer_id_hash; observations from officers with no within-officer race variation cannot identify\r\n          the race coefficient.\r\n    x_astaverse:\r\n      kind: model\r\n      post_hoc: false\r\n      option_support:\r\n        unadjusted_proportions_iid: []\r\n        adjusted_logistic_officer_clustered: []\r\n        department_and_officer_controls: []\r\n  verdict_rule:\r\n    label: Verdict decision rule\r\n    rationale: How the reported statistics become a supported / not-supported verdict. Left implicit by\r\n      every plan, and consequential on its own.\r\n    default: alpha_05_two_sided\r\n    options:\r\n      alpha_05_two_sided:\r\n        label: p < 0.05, two-sided\r\n        description: Conventional two-sided test at the 5% level.\r\n      alpha_01_two_sided:\r\n        label: p < 0.01, two-sided\r\n        description: Stricter two-sided threshold at the 1% level.\r\n"]
[5.643281, "o", "      alpha_05_directional:\r\n        label: p < 0.05 and direction matches\r\n        description: Significant at 5% AND the estimate points the way the hypothesis predicts; a significant\r\n          effect the other way counts as not supported.\r\n    x_astaverse:\r\n      kind: verdict_rule\r\n      post_hoc: true\r\n      option_support:\r\n        alpha_05_two_sided: []\r\n        alpha_01_two_sided: []\r\n        alpha_05_directional: []\r\nprior_insights:\r\n  hypothesis:\r\n    id: hypothesis\r\n    label: Hypothesis under test\r\n    claim: Police stops and searches are racially biased.\r\nx_astaverse:\r\n  astra_schema_shape: 0.0.13\r\n  note: ASTRA-shaped, emitted by astaverse without astra-tools. Run `astra validate` to check conformance.\r\n"]
[5.643398, "o", "\r\nPython packages:\r\n"]
[5.654114, "o", "pandas True\r\n"]
