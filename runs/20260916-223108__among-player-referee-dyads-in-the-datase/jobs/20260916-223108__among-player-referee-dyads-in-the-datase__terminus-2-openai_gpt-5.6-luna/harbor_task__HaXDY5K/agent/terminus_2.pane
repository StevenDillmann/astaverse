[?2004l[?2004h> good=[r for r in rows if r.get('converged') is True and r.get('estimate_standardized') is not None]
[?2004l[?2004h> decisions=sorted(good[0]['decisions']) if good else []
[?2004l[?2004h> lines=['','## Decision-level movement','Among successful fits, the following ranges show how much the standardized estimate varied within each option; larger ranges indicate decisions associated with more movement in the specification curve.']
