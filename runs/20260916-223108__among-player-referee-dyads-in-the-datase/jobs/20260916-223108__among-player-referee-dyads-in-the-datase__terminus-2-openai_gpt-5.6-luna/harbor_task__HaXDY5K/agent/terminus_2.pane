[?2004l[?2004h>     for opt, vals in by.items():
[?2004l[?2004h>         ranges.append((opt,min(vals),max(vals),max(vals)-min(vals),len(vals)))
[?2004l[?2004h>     if ranges:
[?2004l[?2004h>         overall=max(x[3] for x in ranges)
[?2004l[?2004h>         summary.append((overall,d,ranges))
[?2004l[?2004h> for overall,d,ranges in sorted(summary,reverse=True):
[?2004l[?2004h>     text='; '.join(f'`{o}`: {lo:.4f} to {hi:.4f} (n={n})' for o,lo,hi,_,n in sorted(ranges))
[?2004l[?2004h>     lines.append(f'- **{d}** (largest within-option range {overall:.4f}): {text}')
[?2004l[?2004h> with open('/app/results.md','a') as f: f.write('\n'.join(lines)+'\n')
