astra:
id: silberzahn-red-cards_multiverse
name: 'silberzahn-red-cards: multiverse analysis'
description: Decision space extracted by mode 'direct'.
inputs:
- id: dataset
  type: data
  source: /Users/stevend/Desktop/Asta/astaverse/data/datasets/silberzahn-red-cards/data.csv
  description: Primary dataset under analysis
outputs:
- id: universe_stats
  type: table
  description: 'Per-universe statistics (estimate, estimate_standardized, std_error, std_error_standardized,
    95% standardized confidence interval, p_value, n, direction). Carries no verdict by design: verdicts
    are assigned downstream.'
  inputs:
  - dataset
  decisions:
  - covariate_adjustment
  - dependence_inference
  - games_exposure_handling
  - red_card_outcome_definition
  - skin_tone_rater_combination
  - skin_tone_threshold
  recipe:
    command: python /app/analysis.py
decisions:
  skin_tone_rater_combination:
    label: Skin-tone score construction
    rationale: 'How should `rater1` and `rater2` be combined into the player skin-tone score before dichotomization?  [found
      by: direct]'
    default: mean_raters
    options:
      mean_raters:
        label: Mean of both raters
        description: For each dyad, define skin_score = (`rater1` + `rater2`) / 2.
      rater1_only:
        label: Use first rater only
        description: Define skin_score = `rater1`, ignoring `rater2`.
      both_raters_thresholded:
        label: Require both raters to classify as dark
        description: Retain the two separate scores for dichotomization; a player is dark only if both
          `rater1` and `rater2` meet the selected dark-skin threshold, and light otherwise.
    x_astaverse:
      kind: variable_choice
      post_hoc: false
      option_support:
        mean_raters: []
        rater1_only: []
        both_raters_thresholded: []
  skin_tone_threshold:
    label: Binary skin-tone threshold
    rationale: 'Which prespecified threshold should convert the combined skin-tone score into dark versus
      light skin?  [found by: direct]'
    default: at_least_050
    options:
      at_least_050:
        label: "Dark if score \u2265 0.50"
        description: Set dark_skin = 1 when the score constructed from the selected rater rule is at least
          0.50; otherwise set dark_skin = 0.
      at_least_075:
        label: "Dark if score \u2265 0.75"
        description: Set dark_skin = 1 when the score constructed from the selected rater rule is at least
          0.75; otherwise set dark_skin = 0.
      above_050:
        label: Dark if score > 0.50
        description: Set dark_skin = 1 when the score constructed from the selected rater rule is strictly
          greater than 0.50; otherwise set dark_skin = 0.
    x_astaverse:
      kind: variable_choice
      post_hoc: false
      option_support:
        at_least_050: []
        at_least_075: []
        above_050: []
  red_card_outcome_definition:
    label: Any-event outcome definition
    rationale: 'Should the dyad outcome count only straight red cards, or also second-yellow sendings-off?  [found
      by: direct]'
    default: straight_red_only
    options:
      straight_red_only:
        label: At least one straight red card
        description: "Set outcome = 1 when `redCards` \u2265 1 and outcome = 0 when `redCards` = 0; ignore\
          \ `yellowReds`."
      any_sending_off:
        label: At least one sending-off of either type
        description: "Set outcome = 1 when `redCards` + `yellowReds` \u2265 1 and outcome = 0 otherwise."
    x_astaverse:
      kind: preprocessing
      post_hoc: false
      option_support:
        straight_red_only: []
        any_sending_off: []
  games_exposure_handling:
    label: Handling variation in games per dyad
    rationale: "How should the `games` exposure difference across player\u2013referee dyads enter the\
      \ logistic analysis?  [found by: direct]"
    default: unweighted_dyads
    options:
      unweighted_dyads:
        label: Unweighted dyad-level l
