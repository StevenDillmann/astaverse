[7.865195, "o", "/app/universes/universe_001.yaml {'id': 'universe_001', 'decisions': [{'decision_id': 'covariate_adjustment', 'option_id': 'player_and_league_covariates'}, {'decision_id': 'dependence_inference', 'option_id': 'model_based_iid'}, {'decision_id': 'games_exposure_handling', 'option_id': 'unweighted_dyads'}, {'decision_id': 'red_card_outcome_definition', 'option_id': 'straight_red_only'}, {'decision_id': 'skin_tone_rater_combination', 'option_id': 'mean_raters'}, {'decision_id': 'skin_tone_threshold', 'option_id': 'at_least_050'}]}\r\nastra:\r\nid: silberzahn-red-cards_multiverse\r\nname: 'silberzahn-red-cards: multiverse analysis'\r\ndescription: Decision space extracted by mode 'direct'.\r\ninputs:\r\n- id: dataset\r\n  type: data\r\n  source: /Users/stevend/Desktop/Asta/astaverse/data/datasets/silberzahn-red-cards/data.csv\r\n  description: Primary dataset under analysis\r\noutputs:\r\n- id: universe_stats\r\n  type: table\r\n  description: 'Per-universe statistics (estimate, estimate_standardized, std_error, std_error_standardized,\r\n    95% standardized confidence interval, p_value, n, direction). Carries no verdict by design: verdicts\r\n    are assigned downstream.'\r\n  inputs:\r\n  - dataset\r\n  decisions:\r\n  - covariate_adjustment\r\n  - dependence_inference\r\n  - games_exposure_handling\r\n  - red_card_outcome_definition\r\n  - skin_tone_rater_combination\r\n  - skin_tone_threshold\r\n  recipe:\r\n    command: python /app/analysis.py\r\ndecisions:\r\n  skin_tone_rater_combination:\r\n    label: Skin-tone score construction\r\n    rationale: 'How should `rater1` and `rater2` be combined into the player skin-tone score before dichotomization?  [found\r\n      by: direct]'\r\n    default: mean_raters\r\n    options:\r\n      mean_raters:\r\n        label: Mean of both raters\r\n        description: For each dyad, define skin_score = (`rater1` + `rater2`) / 2.\r\n      rater1_only:\r\n        label: Use first rater only\r\n        description: Define skin_score = `rater1`, ignoring `rater2`.\r\n      both_raters_thresholded:\r\n        label: Require both raters to classify as dark\r\n        description: Retain the two separate scores for dichotomization; a player is dark only if both\r\n          `rater1` and `rater2` meet the selected dark-skin threshold, and light otherwise.\r\n    x_astaverse:\r\n      kind: variable_choice\r\n      post_hoc: false\r\n      option_support:\r\n        mean_raters: []\r\n        rater1_only: []\r\n        both_raters_thresholded: []\r\n  skin_tone_threshold:\r\n    label: Binary skin-tone threshold\r\n    rationale: 'Which prespecified threshold should convert the combined skin-tone score into dark versus\r\n      light skin?  [found by: direct]'\r\n    default: at_least_050\r\n    options:\r\n      at_least_050:\r\n        label: \"Dark if score \\u2265 0.50\"\r\n        description: Set dark_skin = 1 when the score constructed from the selected rater rule is at least\r\n          0.50; otherwise set dark_skin = 0.\r\n      at_least_075:\r\n        label: \"Dark if score \\u2265 0.75\"\r\n        description: Set dark_skin = 1 when the score constructed from the selected rater rule is at least\r\n          0.75; otherwise set dark_skin = 0.\r\n      above_050:\r\n        label: Dark if score > 0.50\r\n        description: Set dark_skin = 1 when the score constructed from the selected rater rule is strictly\r\n          greater than 0.50; otherwise set dark_skin = 0.\r\n    x_astaverse:\r\n      kind: variable_choice\r\n      post_hoc: false\r\n      option_support:\r\n        at_least_050: []\r\n        at_least_075: []\r\n        above_050: []\r\n  red_card_outcome_definition:\r\n    label: Any-event outcome definition\r\n    rationale: 'Should the dyad outcome count only straight red cards, or also second-yellow sendings-off?  [found\r\n      by: direct]'\r\n    default: straight_red_only\r\n    options:\r\n      straight_red_only:\r\n        label: At least one straight red card\r\n        description: \"Set outcome = 1 when `redCards` \\u2265 1 and outcome = 0 when `redCards` = 0; ignore\\\r\n          \\ `yellowReds`.\"\r\n      any_sending_off:\r\n        label: At least one sending-off of either type\r\n        description: \"Set outcome = 1 when `redC"]
[7.865216, "o", "ards` + `yellowReds` \\u2265 1 and outcome = 0 otherwise.\"\r\n    x_astaverse:\r\n      kind: preprocessing\r\n      post_hoc: false\r\n      option_support:\r\n        straight_red_only: []\r\n        any_sending_off: []\r\n  games_exposure_handling:\r\n    label: Handling variation in games per dyad\r\n    rationale: \"How should the `games` exposure difference across player\\u2013referee dyads enter the\\\r\n      \\ logistic analysis?  [found by: direct]\"\r\n    default: unweighted_dyads\r\n    options:\r\n      unweighted_dyads:\r\n        label: Unweighted dyad-level l\r\n"]
