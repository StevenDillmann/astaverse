[269.357539, "o", "    d, cols = _make_frame(df, s)\r\n\u001b[?2004l\rd \u001b[?2004h"]
[269.357567, "o", "> "]
[269.357755, "o", "    X, names = _design(d, cols)\r\n\u001b[?2004l\r\u001b[?2004h>     y = d['_y'].to_numpy(float)\r\n\u001b[?2004l\r"]
[269.357817, "o", "\u001b[?2004h> "]
[269.358142, "o", "    freq = (d['_games'].to_numpy(float) if s['games_exposure_handling'] == 'games_frequency_weight' else np.ones(len(d)))\r\n\u001b[?2004l\r"]
[269.35816, "o", "\u001b[?2004h> "]
[269.358306, "o", "    beta, pr, h = _fit_logistic(X, y, freq)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.358328, "o", "    j = names.index('_dark')\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.358424, "o", "> "]
[269.358629, "o", "    dep = s['dependence_inference']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.358805, "o", "    invh = np.linalg.pinv(h, rcond=1e-10)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.358948, "o", "    if dep == 'model_based_iid':\r\n\u001b[?2004l\r)+'\\n'\u001b[?2004h>         vcov = invh\r\n\u001b[?2004l\r"]
[269.358972, "o", "\u001b[?2004h> "]
[269.359005, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.359101, "o", "> "]
[269.359213, "o", "        score = X.multiply((freq*(y-pr))[:,None]).toarray()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.359275, "o", "        if dep == 'player_clustered':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.359437, "o", "            meat = _cluster_meat(X, freq*(y-pr), d.playerShort.to_numpy())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.35957, "o", "        elif dep in ('two_way_clustered','random_intercepts'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.359719, "o", "            pair = np.array([str(a)+'\\x1f'+str(b) for a,b in zip(d.playerShort, d.refNum)], dtype=object)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.359876, "o", "            meat = (_cluster_meat(X, freq*(y-pr), d.playerShort.to_numpy()) +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.359988, "o", "                    _cluster_meat(X, freq*(y-pr), d.refNum.to_numpy()) -\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.360102, "o", "                    _cluster_meat(X, freq*(y-pr), pair))\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.360175, "o", "> "]
[269.360227, "o", "            raise ValueError('unknown dependence option')\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.360314, "o", ">         vcov = invh.dot(meat).dot(invh)\r\n\u001b[?2004l\r"]
[269.36035, "o", "\u001b[?2004h>         del score\r\n\u001b[?2004l\r"]
[269.36038, "o", "\u001b[?2004h> "]
[269.360573, "o", "    se = float(np.sqrt(max(vcov[j,j], 0)))\r\n\u001b[?2004l\r\u001b[?2004h>     b = float(beta[j])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.360642, "o", "    sd = float(d['_dark'].std(ddof=1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.360672, "o", "    eststd, sestd = b*sd, abs(sd)*se\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.360796, "o", "    return {'estimate': b, 'estimate_standardized': eststd,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.360926, "o", "            'std_error': se, 'std_error_standardized': sestd,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.361044, "o", "            'ci_low_standardized': eststd-1.96*sestd,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.361176, "o", "            'ci_high_standardized': eststd+1.96*sestd,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.361296, "o", "            'p_value': float(2*norm.sf(abs(b/se))) if se > 0 else None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.361335, "o", "            'n': int(len(d)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.361454, "o", "            'direction': 'positive' if eststd > 0 else ('negative' if eststd < 0 else 'none'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.361592, "o", "            'converged': True}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _clean(x):\r\n\u001b[?2004l\r"]
[269.361678, "o", "\u001b[?2004h> "]
[269.361702, "o", "    if isinstance(x, dict): return {k:_clean(v) for k,v in x.items()}\r\n\u001b[?2004l\r"]
[269.361864, "o", "\u001b[?2004h> "]
[269.361946, "o", "    if isinstance(x, (float,np.floating)): return None if not np.isfinite(x) else float(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.362034, "o", "    if isinstance(x, (int,np.integer)): return int(x)\r\n\u001b[?2004l\r"]
[269.362063, "o", "\u001b[?2004h>     return x\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.362117, "o", "def main():\r\n\u001b[?2004l\r"]
[269.36223, "o", "\u001b[?2004h>     df = pd.read_csv('/app/data.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.362348, "o", "    files = sorted(glob.glob('/app/universes/*.yaml'))\r\n\u001b[?2004l\r\u001b[?2004h>     records = []\r\n\u001b[?2004l\r"]
[269.362432, "o", "\u001b[?2004h>     for i, fn in enumerate(files, 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.362537, "o", "        u = yaml.safe_load(open(fn))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.362617, "o", "        decisions = _selection_map(u['decisions'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.362748, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.362769, "o", "            out = analyze(df, decisions)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.362827, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.363042, "o", "            out = {'estimate':None,'estimate_standardized':None,'std_error':None,'std_error_standardized':None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.363195, "o", "                   'ci_low_standardized':None,'ci_high_standardized':None,'p_value':None,'n':0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.363352, "o", "                   'direction':'none','converged':False,'notes':str(e)[:240]}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.36355, "o", "        rec = {'universe_id':u['id'], 'decisions':decisions}; rec.update(_clean(out)); records.append(rec)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.363646, "o", "        if i % 16 == 0: print(f'processed {i}/{len(files)}', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.363673, "o", "        gc.collect()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.363833, "o", "    with open('/app/universes.jsonl','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.363989, "o", "        for r in records: f.write(json.dumps(r,separators=(',',':'))+'\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.364141, "o", "    good = [r for r in records if r.get('converged') and r.get('estimate_standardized') is not None]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.364234, "o", "    vals = np.array([r['estimate_standardized'] for r in good])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.364359, "o", "    lines = ['# Multiverse analysis report','',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.364796, "o", "      'The selections-driven analysis constructs the selected skin-tone indicator and any-event outcome, then fits a dyad-level binomial logistic model for every universe. The focal binary predictor is standardized by its sample SD, and estimates, standard errors, and intervals are reported on that comparable scale.','',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.364988, "o", "      f'- Universes processed: {len(records)}',f'- Successful fits: {len(good)}',f'- Failed fits: {len(records)-len(good)}']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.365333, "o", "    if len(vals): lines += [f'- Standardized estimate range: {vals.min():.4f} to {vals.max():.4f}',f'- Median standardized estimate: {np.median(vals):.4f}',f'- Positive estimates: {int((vals>0).sum())}; negative estimates: {int((vals<0).sum())}']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.366199, "o", "    lines += ['','## Decision implementation','- Skin tone uses the selected rater combination and threshold.','- The outcome is straight red cards or either sending-off type.','- Games are ignored, used as frequency weights, or adjusted with log(games).','- Covariate sets add league, position, height, weight, and optionally referee-country and bias variables.','- Inference uses the selected iid, player-clustered, two-way clustered, or crossed-group robust path.','','## Interpretation','The JSONL contains one record per universe and no verdict; the standardized fields are the comparable specification-curve estimands.']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[269.366298, "o", "    open('/app/results.md','w').write('\\n'.join(lines)+'\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[269.366351, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__': main()\r\n\u001b[?2004l\r\u001b[?2004h> "]
