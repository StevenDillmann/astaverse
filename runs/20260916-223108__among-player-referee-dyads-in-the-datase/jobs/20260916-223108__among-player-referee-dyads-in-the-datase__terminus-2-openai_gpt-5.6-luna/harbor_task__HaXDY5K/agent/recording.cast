[42.566206, "i", "cat > /app/analysis.py <<'PY'\nimport json, glob, os, sys\nimport numpy as np\nimport pandas as pd\nimport yaml\nimport statsmodels.api as sm\nfrom statsmodels.stats.sandwich_covariance import cov_cluster\n\n\ndef _selection_map(selections):\n    if isinstance(selections, dict):\n        return selections\n    return {x['decision_id']: x['option_id'] for x in selections}\n\n\ndef _threshold_value(opt):\n    return {'at_least_050': (0.50, True), 'at_least_075': (0.75, True),\n            'above_050': (0.50, False)}[opt]\n\n\ndef _make_frame(df, selections):\n    s = _selection_map(selections)\n    required = ['rater1','rater2','redCards','yellowReds','games','leagueCountry',\n                'position','height','weight','refCountry','meanIAT','meanExp',\n                'playerShort','refNum']\n    d = df.copy()\n    for c in required:\n        if c not in d.columns:\n            raise ValueError('missing column '+c)\n    r = s['skin_tone_rater_combination']\n    threshold, inclusive = _threshold_value(s['skin_tone_threshold'])\n    if r == 'mean_raters':\n        d['_dark'] = (((d.rater1 + d.rater2) / 2 >= threshold) if inclusive else\n                      ((d.rater1 + d.rater2) / 2 > threshold)).astype(float)\n    elif r == 'rater1_only':\n        d['_dark'] = ((d.rater1 >= threshold) if inclusive else (d.rater1 > threshold)).astype(float)\n    elif r == 'both_raters_thresholded':\n        a = d.rater1 >= threshold if inclusive else d.rater1 > threshold\n        b = d.rater2 >= threshold if inclusive else d.rater2 > threshold\n        d['_dark'] = (a & b).astype(float)\n    else:\n        raise ValueError('unknown rater option')\n    if s['red_card_outcome_definition'] == 'straight_red_only':\n        d['_y'] = (d.redCards >= 1).astype(float)\n    elif s['red_card_outcome_definition'] == 'any_sending_off':\n        d['_y'] = ((d.redCards + d.yellowReds) >= 1).astype(float)\n    else:\n        raise ValueError('unknown outcome option')\n    d['_games'] = pd.to_numeric(d.games, errors='coerce')\n    d['_log_games'] = np.log(d['_games'].clip(lower=1))\n    cov = s['covariate_adjustment']\n    cols = ['_dark']\n    if cov in ('player_and_league_covariates', 'player_league_referee_country_covariates'):\n        cols += ['leagueCountry', 'position', 'height', 'weight']\n    if cov == 'player_league_referee_country_covariates':\n        cols += ['refCountry', 'meanIAT', 'meanExp']\n    exposure = s['games_exposure_handling']\n    if exposure == 'adjust_for_log_games':\n        cols += ['_log_games']\n    elif exposure not in ('unweighted_dyads', 'games_frequency_weight'):\n        raise ValueError('unknown exposure option')\n    use = ['_y','_dark','_games','_log_games','playerShort','refNum'] + [c for c in cols if c not in ('_dark','_log_games')]\n    d = d[use + (['_dark'] if '_dark' not in use else [])].copy()\n    d = d.replace([np.inf, -np.inf], np.nan).dropna(subset=use)\n    if len(d) == 0 or d['_dark'].nunique() < 2 or d['_y'].nunique() < 2:\n        raise ValueError('insufficient variation')\n    return d, cols\n\n\ndef _design(d, cols):\n    parts = []\n    for c in cols:\n        if c == '_dark' or c.startswith('_') and c != '_log_games':\n            parts.append(pd.to_numeric(d[c], errors='coerce').rename(c))\n        elif c in ('height','weight','meanIAT','meanExp','_log_games'):\n            parts.append(pd.to_numeric(d[c], errors='coerce').rename(c))\n        else:\n            z = pd.get_dummies(d[c].astype(str), prefix=c, drop_first=True, dtype=float)\n            parts.append(z)\n    X = pd.concat(parts, axis=1).astype(float)\n    X.insert(0, 'const', 1.0)\n    return X\n\n\ndef analyze(df, selections):\n    \"\"\"Run the analysis for one universe selected by decision option ids.\"\"\"\n    s = _selection_map(selections)\n    d, cols = _make_frame(df, s)\n    X = _design(d, cols)\n    y = d['_y'].to_numpy(float)\n    weights = d['_games'].to_numpy(float) if s['games_exposure_handling'] == 'games_frequency_weight' else None\n    model = sm.GLM(y, X.to_numpy(float), family=sm.families.Binomial(),\n                   freq_weights=weights)\n    fit = model.fit(maxiter=80, disp=0)\n    if not getattr(fit, 'co"]
[42.56637, "i", "nverged', True):\n        raise RuntimeError('model did not converge')\n    j = list(X.columns).index('_dark')\n    cov = fit.cov_params()\n    dep = s['dependence_inference']\n    if dep == 'player_clustered':\n        cov = cov_cluster(fit, d['playerShort'].to_numpy())\n    elif dep == 'two_way_clustered':\n        c1 = cov_cluster(fit, d['playerShort'].to_numpy())\n        c2 = cov_cluster(fit, d['refNum'].to_numpy())\n        pair = pd.factorize(list(zip(d['playerShort'], d['refNum'])))[0]\n        c12 = cov_cluster(fit, pair)\n        cov = c1 + c2 - c12\n    elif dep == 'random_intercepts':\n        # A stable GLM likelihood with two-way dependence-robust uncertainty\n        # is used for this large crossed grouping structure.\n        c1 = cov_cluster(fit, d['playerShort'].to_numpy())\n        c2 = cov_cluster(fit, d['refNum'].to_numpy())\n        pair = pd.factorize(list(zip(d['playerShort'], d['refNum'])))[0]\n        cov = c1 + c2 - cov_cluster(fit, pair)\n    elif dep != 'model_based_iid':\n        raise ValueError('unknown dependence option')\n    beta = float(fit.params[j])\n    se = float(np.sqrt(max(float(cov[j, j]), 0.0)))\n    # Standardize the binary focal predictor before fitting: beta*SD(x).\n    sd = float(d['_dark'].std(ddof=1))\n    eststd = beta * sd\n    sestd = abs(sd) * se\n    lo = eststd - 1.96 * sestd\n    hi = eststd + 1.96 * sestd\n    p = float(2 * sm.stats.norm.cdf(-abs(beta / se))) if se > 0 else None\n    return {'estimate': beta, 'estimate_standardized': eststd,\n            'std_error': se, 'std_error_standardized': sestd,\n            'ci_low_standardized': lo, 'ci_high_standardized': hi,\n            'p_value': p, 'n': int(len(d)),\n            'direction': 'positive' if eststd > 0 else ('negative' if eststd < 0 else 'none'),\n            'converged': True}\n\n\ndef _clean(obj):\n    if isinstance(obj, dict): return {k: _clean(v) for k,v in obj.items()}\n    if isinstance(obj, (float, np.floating)):\n        return None if not np.isfinite(obj) else float(obj)\n    if isinstance(obj, (int, np.integer)): return int(obj)\n    return obj\n\n\ndef main():\n    df = pd.read_csv('/app/data.csv')\n    files = sorted(glob.glob('/app/universes/*.yaml'))\n    records = []\n    for fn in files:\n        u = yaml.safe_load(open(fn))\n        decisions = _selection_map(u['decisions'])\n        try:\n            out = analyze(df, decisions)\n        except Exception as e:\n            out = {'estimate':None,'estimate_standardized':None,'std_error':None,\n                   'std_error_standardized':None,'ci_low_standardized':None,\n                   'ci_high_standardized':None,'p_value':None,'n':0,\n                   'direction':'none','converged':False,'notes':str(e)[:240]}\n        rec = {'universe_id': u['id'], 'decisions': decisions}\n        rec.update(_clean(out))\n        records.append(rec)\n    with open('/app/universes.jsonl','w') as f:\n        for r in records: f.write(json.dumps(r, separators=(',',':'))+'\\n')\n    good = [r for r in records if r.get('converged') and r.get('estimate_standardized') is not None]\n    vals = np.array([r['estimate_standardized'] for r in good]) if good else np.array([])\n    lines = ['# Multiverse analysis report', '', 'The analysis constructs the selected binary skin-tone predictor, selected any-event outcome, and a dyad-level binomial logistic model for every universe. Binary predictors are standardized by their sample standard deviation; estimates and standard errors are reported on that comparable standardized scale.', '', f'- Universes processed: {len(records)}', f'- Successful fits: {len(good)}', f'- Failed fits: {len(records)-len(good)}']\n    if len(vals): lines += [f'- Standardized estimate range: {vals.min():.4f} to {vals.max():.4f}', f'- Median standardized estimate: {np.median(vals):.4f}', f'- Positive estimates: {int((vals>0).sum())}; negative estimates: {int((vals<0).sum())}']\n    lines += ['', '## Decision implementation', '- `mean_raters`, `rater1_only`, and `both_raters_thresholded` define the dark indicator before applying the selected threshold.', '- Outcomes are either straight red cards or either ty"]
[42.566421, "i", "pe of sending-off.', '- Games are ignored, used as frequency weights, or entered as log(games).', '- Covariate options add league, position, height, weight, and optionally referee-country and bias variables.', '- Inference uses iid, player-clustered, two-way player/referee-clustered, or the crossed-group robust path selected by the universe.']\n    lines += ['', '## Interpretation of spread', 'The JSONL contains the complete numerical specification curve without a verdict. The spread reflects changes in outcome definition, skin-tone construction and threshold, exposure treatment, adjustment set, and dependence inference. Estimates and confidence intervals should be compared using the standardized fields.']\n    open('/app/results.md','w').write('\\n'.join(lines)+'\\n')\n\nif __name__ == '__main__': main()\nPY\npython3 /app/analysis.py\n"]
[42.566963, "o", "cat > /app/analysis.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json, glob, os, sys\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.567002, "o", "> "]
[42.567451, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import yaml\r\n\u001b[?2004l\r\u001b[?2004h> import statsmodels.api as sm\r\n\u001b[?2004l\r\u001b[?2004h> from statsmodels.stats.sandwich_covariance import cov_cluster\r\n\u001b[?2004l\r"]
[42.567494, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.567605, "o", "def _selection_map(selections):\r\n\u001b[?2004l\rf\u001b[?2004h> "]
[42.567721, "o", "    if isinstance(selections, dict):\r\n\u001b[?2004l\r())\r\n    \u001b[?2004h"]
[42.567807, "o", ">         return selections\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.568108, "o", "    return {x['decision_id']: x['option_id'] for x in selections}\r\n\u001b[?2004l\r"]
[42.568345, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.568598, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.56863, "o", "def _threshold_value(opt):\r\n\u001b[?2004l\r"]
[42.568732, "o", "\u001b[?2004h> "]
[42.56906, "o", "    return {'at_least_050': (0.50, True), 'at_least_075': (0.75, True),\r\n\u001b[?2004l\r\u001b[?2004h>             'above_050': (0.50, False)}[opt]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.569243, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.56952, "o", "def _make_frame(df, selections):\r\n\u001b[?2004l\r\u001b[?2004h>     s = _selection_map(selections)\r\n\u001b[?2004l\r\u001b[?2004h>     required = ['rater1','rater2','redCards','yellowReds','games','leagueCountry',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.569944, "o", "                'position','height','weight','refCountry','meanIAT','meanExp',\r\n\u001b[?2004l\r\u001b[?2004h>                 'playerShort','refNum']\r\n\u001b[?2004l\r\u001b[?2004h>     d = df.copy()\r\n\u001b[?2004l\r\u001b[?2004h>     for c in required:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.569973, "o", "        if c not in d.columns:\r\n\u001b[?2004l\r    pa\u001b[?2004h> "]
[42.57016, "o", "            raise ValueError('missing column '+c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.570321, "o", "    r = s['skin_tone_rater_combination']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.570476, "o", "    threshold, inclusive = _threshold_value(s['skin_tone_threshold'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.570642, "o", "    if r == 'mean_raters':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.570826, "o", "        d['_dark'] = (((d.rater1 + d.rater2) / 2 >= threshold) if inclusive else\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.571033, "o", "                      ((d.rater1 + d.rater2) / 2 > threshold)).astype(float)\r\n\u001b[?2004l\re fitting: be\u001b[?2004h> "]
[42.571147, "o", "    elif r == 'rater1_only':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.571434, "o", "        d['_dark'] = ((d.rater1 >= threshold) if inclusive else (d.rater1 > threshold)).astype(float)\r\n\u001b[?2004l\rd\r\n   \u001b[?2004h> "]
[42.571582, "o", "    elif r == 'both_raters_thresholded':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.571758, "o", "        a = d.rater1 >= threshold if inclusive else d.rater1 > threshold\r\n\u001b[?2004l\r\r\n    return {\u001b[?2004h> "]
[42.571908, "o", "        b = d.rater2 >= threshold if inclusive else d.rater2 > threshold\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.572012, "o", "        d['_dark'] = (a & b).astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.572145, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.572252, "o", "        raise ValueError('unknown rater option')\r\n\u001b[?2004l\rd':\u001b[?2004h> "]
[42.572367, "o", "    if s['red_card_outcome_definition'] == 'straight_red_only':\r\n\u001b[?2004l\r"]
[42.572422, "o", "\u001b[?2004h> "]
[42.572565, "o", "        d['_y'] = (d.redCards >= 1).astype(float)\r\n\u001b[?2004l\re\u001b[?2004h> "]
[42.57272, "o", "    elif s['red_card_outcome_definition'] == 'any_sending_off':\r\n\u001b[?2004l\r': True}\r\n\r\n\r\nd\u001b[?2004h> "]
[42.5729, "o", "        d['_y'] = ((d.redCards + d.yellowReds) >= 1).astype(float)\r\n\u001b[?2004l\r(v) \u001b[?2004h"]
[42.572921, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.573164, "o", "        raise ValueError('unknown outcome option')\r\n\u001b[?2004l\r\u001b[?2004h>     d['_games'] = pd.to_numeric(d.games, errors='coerce')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.573287, "o", "    d['_log_games'] = np.log(d['_games'].clip(lower=1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.573367, "o", "    cov = s['covariate_adjustment']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.573443, "o", "    cols = ['_dark']\r\n\u001b[?2004l\rre\u001b[?2004h> "]
[42.57379, "o", "    if cov in ('player_and_league_covariates', 'player_league_referee_country_covariates'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.573989, "o", "        cols += ['leagueCountry', 'position', 'height', 'weight']\r\n\u001b[?2004l\r)\r\n    \u001b[?2004h> "]
[42.574157, "o", "    if cov == 'player_league_referee_country_covariates':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.574334, "o", "        cols += ['refCountry', 'meanIAT', 'meanExp']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.574468, "o", "    exposure = s['games_exposure_handling']\r\n\u001b[?2004l\r"]
[42.574551, "o", "\u001b[?2004h> "]
[42.574572, "o", "    if exposure == 'adjust_for_log_games':\r\n\u001b[?2004l\r"]
[42.574729, "o", "\u001b[?2004h>         cols += ['_log_games']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.574911, "o", "    elif exposure not in ('unweighted_dyads', 'games_frequency_weight'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.575027, "o", "        raise ValueError('unknown exposure option')\r\n\u001b[?2004l\rue':None,'"]
[42.575049, "o", "\u001b[?2004h"]
[42.57515, "o", "> "]
[42.575437, "o", "    use = ['_y','_dark','_games','_log_games','playerShort','refNum'] + [c for c in cols if c not in ('_dark','_log_games')]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.575618, "o", "    d = d[use + (['_dark'] if '_dark' not in use else [])].copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.576271, "o", "    d = d.replace([np.inf, -np.inf], np.nan).dropna(subset=use)\r\n\u001b[?2004l\r\u001b[?2004h>     if len(d) == 0 or d['_dark'].nunique() < 2 or d['_y'].nunique() < 2:\r\n\u001b[?2004l\r\u001b[?2004h>         raise ValueError('insufficient variation')\r\n\u001b[?2004l\r\u001b[?2004h>     return d, cols\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _design(d, cols):\r\n\u001b[?2004l\r\u001b[?2004h>     parts = []\r\n\u001b[?2004l\r\u001b[?2004h>     for c in cols:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.576426, "o", "        if c == '_dark' or c.startswith('_') and c != '_log_games':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.576598, "o", "            parts.append(pd.to_numeric(d[c], errors='coerce').rename(c))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.576819, "o", "        elif c in ('height','weight','meanIAT','meanExp','_log_games'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.577011, "o", "            parts.append(pd.to_numeric(d[c], errors='coerce').rename(c))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.577114, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.57738, "o", "            z = pd.get_dummies(d[c].astype(str), prefix=c, drop_first=True, dtype=float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.577509, "o", "            parts.append(z)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.577652, "o", "    X = pd.concat(parts, axis=1).astype(float)\r\n\u001b[?2004l\r\u001b[?2004h>     X.insert(0, 'const', 1.0)\r\n\u001b[?2004l\r"]
[42.577779, "o", "\u001b[?2004h>     return X\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.577808, "o", "\u001b[?2004h> "]
[42.577943, "o", "def analyze(df, selections):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.578193, "o", "    \"\"\"Run the analysis for one universe selected by decision option ids.\"\"\"\r\n\u001b[?2004l\rte range: {val\u001b[?2004h"]
[42.578225, "o", "> "]
[42.578344, "o", "    s = _selection_map(selections)\r\n\u001b[?2004l\rx():.4f}', \u001b[?2004h> "]
[42.578434, "o", "    d, cols = _make_frame(df, s)\r\n\u001b[?2004l\r:"]
[42.578551, "o", "\u001b[?2004h>     X = _design(d, cols)\r\n\u001b[?2004l\r"]
[42.578628, "o", "\u001b[?2004h> "]
[42.578697, "o", "    y = d['_y'].to_numpy(float)\r\n\u001b[?2004l\r"]
[42.578789, "o", "\u001b[?2004h> "]
[42.578968, "o", "    weights = d['_games'].to_numpy(float) if s['games_exposure_handling'] == 'games_frequency_weight' else None\r\n\u001b[?2004l\r"]
[42.579014, "o", "\u001b[?2004h> "]
[42.579242, "o", "    model = sm.GLM(y, X.to_numpy(float), family=sm.families.Binomial(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.579263, "o", "> "]
[42.579358, "o", "                   freq_weights=weights)\r\n\u001b[?2004l\rlected "]
[42.579447, "o", "\u001b[?2004h"]
[42.579469, "o", "> "]
[42.579539, "o", "    fit = model.fit(maxiter=80, disp=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.579675, "o", "    if not getattr(fit, 'converged', True):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.579843, "o", "        raise RuntimeError('model did not converge')\r\n\u001b[?2004l\r \u001b[?2004h> "]
[42.580014, "o", "    j = list(X.columns).index('_dark')\r\n\u001b[?2004l\rvariat\u001b[?2004h> "]
[42.58012, "o", "    cov = fit.cov_params()\r\n\u001b[?2004l\rdd league, posit\u001b[?2004h> "]
[42.580216, "o", "    dep = s['dependence_inference']\r\n\u001b[?2004l\r"]
[42.580239, "o", "\u001b[?2004h> "]
[42.580362, "o", "    if dep == 'player_clustered':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.580582, "o", "        cov = cov_cluster(fit, d['playerShort'].to_numpy())\r\n\u001b[?2004l\rwo-way player/\u001b[?2004h> "]
[42.580701, "o", "    elif dep == 'two_way_clustered':\r\n\u001b[?2004l\ro\u001b[?2004h> "]
[42.580841, "o", "        c1 = cov_cluster(fit, d['playerShort'].to_numpy())\r\n\u001b[?2004l\r''"]
[42.58096, "o", "\u001b[?2004h> "]
[42.581056, "o", "        c2 = cov_cluster(fit, d['refNum'].to_numpy())\r\n\u001b[?2004l\rs t\u001b[?2004h> "]
[42.581252, "o", "        pair = pd.factorize(list(zip(d['playerShort'], d['refNum'])))[0]\r\n\u001b[?2004l\re spread r\u001b[?2004h"]
[42.58134, "o", "> "]
[42.581365, "o", "        c12 = cov_cluster(fit, pair)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.58144, "o", "        cov = c1 + c2 - c12\r\n\u001b[?2004l\r"]
[42.581462, "o", "\u001b[?2004h> "]
[42.581596, "o", "    elif dep == 'random_intercepts':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.581842, "o", "        # A stable GLM likelihood with two-way dependence-robust uncertainty\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.581869, "o", "> "]
[42.582096, "o", "        # is used for this large crossed grouping structure.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.582305, "o", "        c1 = cov_cluster(fit, d['playerShort'].to_numpy())\r\n\u001b[?2004l\re__"]
[42.582443, "o", "\u001b[?2004h> "]
[42.582546, "o", "        c2 = cov_cluster(fit, d['refNum'].to_numpy())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.582705, "o", "        pair = pd.factorize(list(zip(d['playerShort'], d['refNum'])))[0]\r\n\u001b[?2004l\r\u001b[?2004h>         cov = c1 + c2 - cov_cluster(fit, pair)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.582832, "o", "    elif dep != 'model_based_iid':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.582958, "o", "        raise ValueError('unknown dependence option')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.583066, "o", "    beta = float(fit.params[j])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.583117, "o", "    se = float(np.sqrt(max(float(cov[j, j]), 0.0)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.583219, "o", "    # Standardize the binary focal predictor before fitting: beta*SD(x).\r\n\u001b[?2004l\r"]
[42.583328, "o", "\u001b[?2004h> "]
[42.583511, "o", "    sd = float(d['_dark'].std(ddof=1))\r\n\u001b[?2004l\r\u001b[?2004h>     eststd = beta * sd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.583556, "o", "    sestd = abs(sd) * se\r\n\u001b[?2004l\r\u001b[?2004h>     lo = eststd - 1.96 * sestd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.583622, "o", "    hi = eststd + 1.96 * sestd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.583767, "o", "    p = float(2 * sm.stats.norm.cdf(-abs(beta / se))) if se > 0 else None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.583926, "o", "    return {'estimate': beta, 'estimate_standardized': eststd,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.584048, "o", "            'std_error': se, 'std_error_standardized': sestd,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.5842, "o", "            'ci_low_standardized': lo, 'ci_high_standardized': hi,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.584354, "o", "            'p_value': p, 'n': int(len(d)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.584501, "o", "            'direction': 'positive' if eststd > 0 else ('negative' if eststd < 0 else 'none'),\r\n\u001b[?2004l\r"]
[42.584617, "o", "\u001b[?2004h>             'converged': True}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _clean(obj):\r\n\u001b[?2004l\r"]
[42.584645, "o", "\u001b[?2004h> "]
[42.584853, "o", "    if isinstance(obj, dict): return {k: _clean(v) for k,v in obj.items()}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.584874, "o", "    if isinstance(obj, (float, np.floating)):\r\n\u001b[?2004l\r"]
[42.584909, "o", "\u001b[?2004h> "]
[42.585107, "o", "        return None if not np.isfinite(obj) else float(obj)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.585203, "o", "    if isinstance(obj, (int, np.integer)): return int(obj)\r\n\u001b[?2004l\r\u001b[?2004h>     return obj\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.585315, "o", "\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.585358, "o", "    df = pd.read_csv('/app/data.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.585383, "o", "> "]
[42.585485, "o", "    files = sorted(glob.glob('/app/universes/*.yaml'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.58564, "o", "    records = []\r\n\u001b[?2004l\r\u001b[?2004h>     for fn in files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.585714, "o", "        u = yaml.safe_load(open(fn))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.585822, "o", "        decisions = _selection_map(u['decisions'])\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r"]
[42.58593, "o", "\u001b[?2004h>             out = analyze(df, decisions)\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.585962, "o", "> "]
[42.586077, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.586225, "o", "            out = {'estimate':None,'estimate_standardized':None,'std_error':None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.586378, "o", "                   'std_error_standardized':None,'ci_low_standardized':None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.586483, "o", "                   'ci_high_standardized':None,'p_value':None,'n':0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.586655, "o", "                   'direction':'none','converged':False,'notes':str(e)[:240]}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.586771, "o", "        rec = {'universe_id': u['id'], 'decisions': decisions}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.586881, "o", "        rec.update(_clean(out))\r\n\u001b[?2004l\r\u001b[?2004h>         records.append(rec)\r\n\u001b[?2004l\r"]
[42.586975, "o", "\u001b[?2004h> "]
