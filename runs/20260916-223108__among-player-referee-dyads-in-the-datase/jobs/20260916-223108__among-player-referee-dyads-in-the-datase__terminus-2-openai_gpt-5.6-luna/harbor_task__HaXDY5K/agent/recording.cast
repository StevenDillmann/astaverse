[465.966942, "o", " c=collections.defaultdict(lambda:[0,0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[465.96702, "o", " for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[465.967149, "o", "  c[r['decisions'][key]][r['converged']==True]+=1\r\n\u001b[?2004l\r\u001b[?2004h> "]
