[125.244248, "i", "cat > /app/analysis.py <<'PY'\nimport gc, glob, json\nimport numpy as np\nimport pandas as pd\nimport yaml\nimport statsmodels.api as sm\nfrom scipy.stats import norm\nfrom statsmodels.stats.sandwich_covariance import cov_cluster\n\n\ndef _selection_map(selections):\n    if isinstance(selections, dict):\n        return selections\n    return {x['decision_id']: x['option_id'] for x in selections}\n\n\ndef _threshold_value(option):\n    return {'at_least_050': (0.50, True),\n            'at_least_075': (0.75, True),\n            'above_050': (0.50, False)}[option]\n\n\ndef _make_frame(df, selections):\n    s = _selection_map(selections)\n    threshold, inclusive = _threshold_value(s['skin_tone_threshold'])\n    needed = ['rater1', 'rater2', 'redCards', 'yellowReds', 'games',\n              'leagueCountry', 'position', 'height', 'weight', 'refCountry',\n              'meanIAT', 'meanExp', 'playerShort', 'refNum']\n    # Select only columns used by this universe; never copy the entire dataset.\n    d = df.loc[:, needed].copy()\n    if s['skin_tone_rater_combination'] == 'mean_raters':\n        score = (d['rater1'] + d['rater2']) / 2.0\n        valid_skin = d['rater1'].notna() & d['rater2'].notna()\n        d['_dark'] = (score >= threshold if inclusive else score > threshold).astype(float)\n    elif s['skin_tone_rater_combination'] == 'rater1_only':\n        valid_skin = d['rater1'].notna()\n        d['_dark'] = (d['rater1'] >= threshold if inclusive else d['rater1'] > threshold).astype(float)\n    elif s['skin_tone_rater_combination'] == 'both_raters_thresholded':\n        valid_skin = d['rater1'].notna() & d['rater2'].notna()\n        a = d['rater1'] >= threshold if inclusive else d['rater1'] > threshold\n        b = d['rater2'] >= threshold if inclusive else d['rater2'] > threshold\n        d['_dark'] = (a & b).astype(float)\n    else:\n        raise ValueError('unknown skin-tone rater option')\n    if s['red_card_outcome_definition'] == 'straight_red_only':\n        d['_y'] = (d['redCards'] >= 1).astype(float)\n    elif s['red_card_outcome_definition'] == 'any_sending_off':\n        d['_y'] = ((d['redCards'] + d['yellowReds']) >= 1).astype(float)\n    else:\n        raise ValueError('unknown outcome option')\n    d['_games'] = pd.to_numeric(d['games'], errors='coerce')\n    d['_log_games'] = np.log(d['_games'].clip(lower=1))\n    cov = s['covariate_adjustment']\n    cols = ['_dark']\n    if cov in ('player_and_league_covariates', 'player_league_referee_country_covariates'):\n        cols += ['leagueCountry', 'position', 'height', 'weight']\n    if cov == 'player_league_referee_country_covariates':\n        cols += ['refCountry', 'meanIAT', 'meanExp']\n    exposure = s['games_exposure_handling']\n    if exposure == 'adjust_for_log_games':\n        cols.append('_log_games')\n    elif exposure not in ('unweighted_dyads', 'games_frequency_weight'):\n        raise ValueError('unknown games option')\n    keep = ['_y', '_dark', '_games', '_log_games', 'playerShort', 'refNum']\n    keep += [c for c in cols if c not in keep]\n    d = d.loc[valid_skin, keep]\n    d = d.replace([np.inf, -np.inf], np.nan).dropna()\n    if len(d) == 0 or d['_dark'].nunique() < 2 or d['_y'].nunique() < 2:\n        raise ValueError('insufficient complete data or variation')\n    return d, cols\n\n\ndef _design(d, cols):\n    pieces = []\n    for c in cols:\n        if c in ('_dark', '_log_games', 'height', 'weight', 'meanIAT', 'meanExp'):\n            pieces.append(pd.to_numeric(d[c], errors='coerce').rename(c))\n        else:\n            pieces.append(pd.get_dummies(d[c].astype(str), prefix=c,\n                                         drop_first=True, dtype=np.float64))\n    X = pd.concat(pieces, axis=1).astype(np.float64)\n    X.insert(0, 'const', 1.0)\n    return X\n\n\ndef analyze(df, selections):\n    \"\"\"Run the same parameterized analysis for one selections mapping.\"\"\"\n    s = _selection_map(selections)\n    d, cols = _make_frame(df, s)\n    X = _design(d, cols)\n    y = d['_y'].to_numpy(dtype=float)\n    weights = (d['_games'].to_numpy(dtype=float)\n               if s['games_exposure_handling'] == 'games_frequency_weight' else None)"]
[125.244433, "i", "\n    fit = sm.GLM(y, X.to_numpy(dtype=float), family=sm.families.Binomial(),\n                 freq_weights=weights).fit(maxiter=80, disp=0)\n    if not getattr(fit, 'converged', True):\n        raise RuntimeError('model did not converge')\n    j = list(X.columns).index('_dark')\n    cov = np.asarray(fit.cov_params(), dtype=float)\n    dep = s['dependence_inference']\n    if dep == 'player_clustered':\n        cov = cov_cluster(fit, d['playerShort'].to_numpy())\n    elif dep in ('two_way_clustered', 'random_intercepts'):\n        c1 = cov_cluster(fit, d['playerShort'].to_numpy())\n        c2 = cov_cluster(fit, d['refNum'].to_numpy())\n        pair = pd.factorize(pd.MultiIndex.from_arrays(\n            [d['playerShort'].to_numpy(), d['refNum'].to_numpy()]))[0]\n        cov = c1 + c2 - cov_cluster(fit, pair)\n    elif dep != 'model_based_iid':\n        raise ValueError('unknown dependence option')\n    beta = float(fit.params[j])\n    variance = float(cov[j, j])\n    se = float(np.sqrt(max(variance, 0.0)))\n    sd = float(d['_dark'].std(ddof=1))\n    eststd = beta * sd\n    sestd = abs(sd) * se\n    lo = eststd - 1.96 * sestd\n    hi = eststd + 1.96 * sestd\n    p = float(2 * norm.sf(abs(beta / se))) if se > 0 else None\n    result = {'estimate': beta, 'estimate_standardized': eststd,\n              'std_error': se, 'std_error_standardized': sestd,\n              'ci_low_standardized': lo, 'ci_high_standardized': hi,\n              'p_value': p, 'n': int(len(d)),\n              'direction': ('positive' if eststd > 0 else\n                            ('negative' if eststd < 0 else 'none')),\n              'converged': True}\n    del d, X, fit, cov\n    return result\n\n\ndef _clean(x):\n    if isinstance(x, dict):\n        return {k: _clean(v) for k, v in x.items()}\n    if isinstance(x, (float, np.floating)):\n        return None if not np.isfinite(x) else float(x)\n    if isinstance(x, (int, np.integer)):\n        return int(x)\n    return x\n\n\ndef main():\n    df = pd.read_csv('/app/data.csv')\n    files = sorted(glob.glob('/app/universes/*.yaml'))\n    records = []\n    for i, fn in enumerate(files, 1):\n        u = yaml.safe_load(open(fn))\n        decisions = _selection_map(u['decisions'])\n        try:\n            out = analyze(df, decisions)\n        except Exception as exc:\n            out = {'estimate': None, 'estimate_standardized': None,\n                   'std_error': None, 'std_error_standardized': None,\n                   'ci_low_standardized': None, 'ci_high_standardized': None,\n                   'p_value': None, 'n': 0, 'direction': 'none',\n                   'converged': False, 'notes': str(exc)[:240]}\n        rec = {'universe_id': u['id'], 'decisions': decisions}\n        rec.update(_clean(out))\n        records.append(rec)\n        if i % 16 == 0:\n            print(f'processed {i}/{len(files)}', flush=True)\n        gc.collect()\n    with open('/app/universes.jsonl', 'w') as f:\n        for rec in records:\n            f.write(json.dumps(rec, separators=(',', ':')) + '\\n')\n    good = [r for r in records if r.get('converged') and r.get('estimate_standardized') is not None]\n    vals = np.array([r['estimate_standardized'] for r in good], dtype=float)\n    lines = ['# Multiverse analysis report', '',\n             'The parameterized analysis constructs the selected skin-tone indicator and any-event outcome, then fits a dyad-level binomial logistic model for each universe. The focal binary predictor is standardized by its sample SD; estimates, standard errors, and confidence intervals are reported on that comparable scale.', '',\n             f'- Universes processed: {len(records)}',\n             f'- Successful fits: {len(good)}',\n             f'- Failed fits: {len(records) - len(good)}']\n    if len(vals):\n        lines += [f'- Standardized estimate range: {vals.min():.4f} to {vals.max():.4f}',\n                  f'- Median standardized estimate: {np.median(vals):.4f}',\n                  f'- Positive estimates: {int((vals > 0).sum())}; negative estimates: {int((vals < 0).sum())}']\n    lines += ['', '## Decision implementation',\n              '- Skin tone uses the select"]
[125.244517, "i", "ed rater combination and threshold.',\n              '- The outcome is either straight red cards or either sending-off type.',\n              '- Games are ignored, used as frequency weights, or adjusted through log(games).',\n              '- Covariate sets add league, position, height, weight, and optionally referee-country and bias variables.',\n              '- Inference uses the selected iid, player-clustered, two-way clustered, or crossed-group robust path.', '',\n              '## Interpretation',\n              'The JSONL contains one numerical record per universe and no verdict. Differences across the standardized estimates reflect the analytic choices rather than changes in measurement units.']\n    with open('/app/results.md', 'w') as f:\n        f.write('\\n'.join(lines) + '\\n')\n\n\nif __name__ == '__main__':\n    main()\nPY\npython3 /app/analysis.py\n"]
