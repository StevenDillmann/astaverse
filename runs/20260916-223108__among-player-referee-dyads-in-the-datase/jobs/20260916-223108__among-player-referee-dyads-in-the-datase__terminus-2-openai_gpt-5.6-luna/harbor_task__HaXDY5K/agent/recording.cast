[1047.440166, "i", "printf '\\nValidation:\\n'; wc -l /app/universes.jsonl; python3 - <<'PY'\nimport json, glob, os\nrows=[json.loads(x) for x in open('/app/universes.jsonl')]\nids=[r['universe_id'] for r in rows]\nprint('records',len(rows),'unique_ids',len(set(ids)),'yaml_files',len(glob.glob('/app/universes/*.yaml')))\nprint('converged',sum(r.get('converged') is True for r in rows),'failed',sum(r.get('converged') is False for r in rows))\nprint('converged_types',sorted(set(type(r.get('converged')).__name__ for r in rows)))\nrequired=['estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged']\nprint('missing_required',sum(any(k not in r for k in required) for r in rows))\nprint('duplicate_ids',len(ids)-len(set(ids)))\nprint('files_exist',os.path.exists('/app/analysis.py'),os.path.exists('/app/results.md'))\nPY\nprintf '\\nReport:\\n'; cat /app/results.md\n"]
[1047.44026, "o", "printf '\\nValidation:\\n'; wc -l /app/universes.jsonl; python3 - <<'PY'\r\nimport json, glob, os\r\nrows=[json.loads(x) for x in open('/app/universes.jsonl')]\r\nids=[r['universe_id'] for r in rows]\r\nprint('records',len(rows),'unique_ids',len(set(ids)),'yaml_files',len(glob.glob('/app/universes/*.yaml')))\r\nprint('converged',sum(r.get('converged') is True for r in rows),'failed',sum(r.get('converged') is False for r in rows))\r\nprint('converged_types',sorted(set(type(r.get('converged')).__name__ for r in rows)))\r\nrequired=['estimate','estimate_standardized','std_error','std_error_standardized','ci_low_standardized','ci_high_standardized','p_value','n','direction','converged']\r\nprint('missing_required',sum(any(k not in r for k in required) for r in rows))\r\nprint('duplicate_ids',len(ids)-len(set(ids)))\r\nprint('files_exist',os.path.exists('/app/analysis.py'),os.path.exists('/app/results.md'))\r\nPY\r\nprintf '\\nReport:\\n'; cat /app/results.md\r\n"]
