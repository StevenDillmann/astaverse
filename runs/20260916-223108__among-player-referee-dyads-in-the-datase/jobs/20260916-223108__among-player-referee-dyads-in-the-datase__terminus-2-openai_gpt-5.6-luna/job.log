e_frame(df, s)\n    X = _design(d, cols)\n    y = d[\'_y\'].to_numpy(float)\n    weights = d[\'_games\'].to_numpy(float) if s[\'games_exposure_handling\'] == \'games_frequency_weight\' else None\n    model = sm.GLM(y, X.to_numpy(float), family=sm.families.Binomial(),\n                   freq_weights=weights)\n    fit = model.fit(maxiter=80, disp=0)\n    if not getattr(fit, \'converged\', True):\n        raise RuntimeError(\'model did not converge\')\n    j = list(X.columns).index(\'_dark\')\n    cov = fit.cov_params()\n    dep = s[\'dependence_inference\']\n    if dep == \'player_clustered\':\n        cov = cov_cluster(fit, d[\'playerShort\'].to_numpy())\n    elif dep == \'two_way_clustered\':\n        c1 = cov_cluster(fit, d[\'playerShort\'].to_numpy())\n        c2 = cov_cluster(fit, d[\'refNum\'].to_numpy())\n        pair = pd.factorize(list(zip(d[\'playerShort\'], d[\'refNum\'])))[0]\n        c12 = cov_cluster(fit, pair)\n        cov = c1 + c2 - c12\n    elif dep == \'random_intercepts\':\n        # A stable GLM likelihood with two-way dependence-robust uncertainty\n        # is used for this large crossed grouping structure.\n        c1 = cov_cluster(fit, d[\'playerShort\'].to_numpy())\n        c2 = cov_cluster(fit, d[\'refNum\'].to_numpy())\n        pair = pd.factorize(list(zip(d[\'playerShort\'], d[\'refNum\'])))[0]\n        cov = c1 + c2 - cov_cluster(fit, pair)\n    elif dep != \'model_based_iid\':\n        raise ValueError(\'unknown dependence option\')\n    beta = float(fit.params[j])\n    se = float(np.sqrt(max(float(cov[j, j]), 0.0)))\n    # Standardize the binary focal predictor before fitting: beta*SD(x).\n    sd = float(d[\'_dark\'].std(ddof=1))\n    eststd = beta * sd\n    sestd = abs(sd) * se\n    lo = eststd - 1.96 * sestd\n    hi = eststd + 1.96 * sestd\n    p = float(2 * sm.stats.norm.cdf(-abs(beta / se))) if se > 0 else None\n    return {\'estimate\': beta, \'estimate_standardized\': eststd,\n            \'std_error\': se, \'std_error_standardized\': sestd,\n            \'ci_low_standardized\': lo, \'ci_high_standardized\': hi,\n            \'p_value\': p, \'n\': int(len(d)),\n            \'direction\': \'positive\' if eststd > 0 else (\'negative\' if eststd < 0 else \'none\'),\n            \'converged\': True}\n\n\ndef _clean(obj):\n    if isinstance(obj, dict): return {k: _clean(v) for k,v in obj.items()}\n    if isinstance(obj, (float, np.floating)):\n        return None if not np.isfinite(obj) else float(obj)\n    if isinstance(obj, (int, np.integer)): return int(obj)\n    return obj\n\n\ndef main():\n    df = pd.read_csv(\'/app/data.csv\')\n    files = sorted(glob.glob(\'/app/universes/*.yaml\'))\n    records = []\n    for fn in files:\n        u = yaml.safe_load(open(fn))\n        decisions = _selection_map(u[\'decisions\'])\n        try:\n            out = analyze(df, decisions)\n        except Exception as e:\n            out = {\'estimate\':None,\'estimate_standardized\':None,\'std_error\':None,\n                   \'std_error_standardized\':None,\'ci_low_standardized\':None,\n                   \'ci_high_standardized\':None,\'p_value\':None,\'n\':0,\n                   \'direction\':\'none\',\'converged\':False,\'notes\':str(e)[:240]}\n        rec = {\'universe_id\': u[\'id\'], \'decisions\': decisions}\n        rec.update(_clean(out))\n        records.append(rec)\n    with open(\'/app/universes.jsonl\',\'w\') as f:\n        for r in records: f.write(json.dumps(r, separators=(\',\',\':\'))+\'\\n\')\n    good = [r for r in records if r.get(\'converged\') and r.get(\'estimate_standardized\') is not None]\n    vals = np.array([r[\'estimate_standardized\'] for r in good]) if good else np.array([])\n    lines = [\'# Multiverse analysis report\', \'\', \'The analysis constructs the selected binary skin-tone predictor, selected any-event outcome, and a dyad-level binomial logistic model for every universe. Binary predictors are standardized by their sample standard deviation; estimates and standard errors are reported on that comparable standardized scale.\', \'\', f\'- Universes processed: {len(records)}\', f\'- Successful fits: {len(good)}\', f\'- Failed fits: {len(records)-len(good)}\']\n    if len(vals): lines += [f\'- Standardized estimate range: {vals.min():.4f} to {vals.max():.4f}\', f\'- Median standardized estimate: {np.median(vals):.4f}\', f\'- Positive estimates: {int((vals>0).sum())}; negative estimates: {int((vals<0).sum())}\']\n    lines += [\'\', \'## Decision implementation\', \'- `mean_raters`, `rater1_only`, and `both_raters_thresholded` define the dark indicator before applying the selected threshold.\', \'- Outcomes are either straight red cards or either type of sending-off.\', \'- Games are ignored, used as frequency weights, or entered as log(games).\', \'- Covariate options add league, position, height, weight, and optionally referee-country and bias variables.\', \'- Inference uses iid, player-clustered, two-way player/referee-clustered, or the crossed-group robust path selected by the universe.\']\n    lines += [\'\', \'## Interpretation of spread\', \'The JSONL contains the complete numerical specification curve without a verdict. The spread reflects changes in outcome definition, skin-tone construction and threshold, exposure treatment, adjustment set, and dependence inference. Estimates and confidence intervals should be compared using the standardized fields.\']\n    open(\'/app/results.md\',\'w\').write(\'\\n\'.join(lines)+\'\\n\')\n\nif __name__ == \'__main__\': main()\nPY\npython3 /app/analysis.py\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
