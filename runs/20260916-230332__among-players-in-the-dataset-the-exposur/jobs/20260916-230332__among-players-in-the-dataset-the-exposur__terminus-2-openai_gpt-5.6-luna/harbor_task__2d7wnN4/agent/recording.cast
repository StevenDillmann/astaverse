[441.528465, "i", "printf '%s\\n' '--- processes ---'; ps aux | grep '[p]ython3' || true; printf '%s\\n' '--- files ---'; ls -lh /app/universes.jsonl /app/results.md 2>&1; printf '%s\\n' '--- count ---'; wc -l /app/universes.jsonl 2>&1; printf '%s\\n' '--- validation ---'; python3 - <<'PY'\nimport json, os, math\np='/app/universes.jsonl'\nif not os.path.exists(p):\n print('JSONL missing')\n raise SystemExit(0)\nrows=[]\nfor line in open(p):\n try: rows.append(json.loads(line))\n except Exception as e: print('parse error',repr(line[:100]),e)\nprint('rows',len(rows))\nprint('unique',len({r.get('universe_id') for r in rows}))\nprint('converged',sum(bool(r.get('converged')) for r in rows))\nprint('failed',sum(not r.get('converged') for r in rows))\nif rows: print('sample',json.dumps(rows[-1],sort_keys=True))\nPY\nprintf '%s\\n' '--- report ---'; cat /app/results.md 2>&1\n"]
[441.528677, "o", "printf '%s\\n' '--- processes ---'; ps aux | grep '[p]ython3' || true; printf '%s\\n' '--- files ---'; ls -lh /app/universes.jsonl /app/results.md 2>&1; printf '%s\\n' '--- count ---'; wc -l /app/universes.jsonl 2>&1; printf '%s\\n' '--- validation ---'; python3 - <<'PY'\r\nimport json, os, math\r\np='/app/universes.jsonl'\r\nif not os.path.exists(p):\r\n print('JSONL missing')\r\n raise SystemExit(0)\r\nrows=[]\r\nfor line in open(p):\r\n try: rows.append(json.loads(line))\r\n except Exception as e: print('parse error',repr(line[:100]),e)\r\nprint('rows',len(rows))\r\nprint('unique',len({r.get('universe_id') for r in rows}))\r\nprint('converged',sum(bool(r.get('converged')) for r in rows))\r\nprint('failed',sum(not r.get('converged') for r in rows))\r\nif rows: print('sample',json.dumps(rows[-1],sort_keys=True))\r\nPY\r\nprintf '%s\\n' '--- report ---'; cat /app/results.md 2>&1\r\n"]
