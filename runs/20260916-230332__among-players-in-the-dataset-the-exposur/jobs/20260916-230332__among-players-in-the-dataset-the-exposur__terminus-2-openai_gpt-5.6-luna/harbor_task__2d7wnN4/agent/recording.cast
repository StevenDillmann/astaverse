[26.764039, "i", "printf '%s\\n' '--- files ---'; find /app/universes -maxdepth 1 -type f -name '*.yaml' | sort | head -3; printf '%s\\n' '--- sample universe ---'; cat \"$(find /app/universes -maxdepth 1 -type f -name '*.yaml' | sort | head -1)\"; printf '%s\\n' '--- packages ---'; python3 - <<'PY'\nimport importlib.util\nfor x in ['pandas','numpy','statsmodels','yaml','sklearn']:\n print(x, bool(importlib.util.find_spec(x)))\nPY\nprintf '%s\\n' '--- data header ---'; head -1 /app/data.csv\n"]
[26.765116, "o", "printf '%s\\n' '--- files ---'; find /app/universes -maxdepth 1 -type f -name '*.yaml' | sort | head -3; printf '%s\\n' '--- sample universe ---'; cat \"$(find /app/universes -maxdepth 1 -type f -name '*.yaml' | sort | head -1)\"; printf '%s\\n' '--- packages ---'; python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import importlib.util\r\n\u001b[?2004l\r\u001b[?2004h> for x in ['pandas','numpy','statsmodels','yaml','sklearn']:\r\n\u001b[?2004l\r\u001b[?2004h>  print(x, bool(importlib.util.find_spec(x)))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r--- files ---\r\n"]
[26.768486, "o", "/app/universes/universe_000.yaml\r\n/app/universes/universe_001.yaml\r\n/app/universes/universe_002.yaml\r\n"]
[26.768726, "o", "--- sample universe ---\r\n"]
[26.770792, "o", "id: universe_000\r\ndecisions:\r\n- decision_id: analysis_unit\r\n  option_id: player_referee_dyad\r\n- decision_id: poisson_mean_structure\r\n  option_id: player_and_league_adjusted\r\n- decision_id: sending_off_definition\r\n  option_id: straight_and_second_yellow\r\n- decision_id: skin_tone_binary_rule\r\n  option_id: mean_at_least_050\r\n- decision_id: standard_error_method\r\n  option_id: model_based\r\n"]
[26.770904, "o", "--- packages ---\r\n"]
[26.780805, "o", "pandas True\r\nnumpy True\r\n"]
[26.780991, "o", "statsmodels True\r\n"]
[26.781079, "o", "yaml True\r\nsklearn False\r\n"]
[26.783321, "o", "\u001b[?2004hroot@15694888de5a:/app# "]
[26.783415, "o", "printf '%s\\n' '--- data header ---'; head -1 /app/data.csv\r\n\u001b[?2004l\r--- data header ---\r\n"]
[26.784153, "o", "\"playerShort\",\"player\",\"club\",\"leagueCountry\",\"birthday\",\"height\",\"weight\",\"position\",\"games\",\"victories\",\"ties\",\"defeats\",\"goals\",\"yellowCards\",\"yellowReds\",\"redCards\",\"photoID\",\"rater1\",\"rater2\",\"refNum\",\"refCountry\",\"Alpha_3\",\"meanIAT\",\"nIAT\",\"seIAT\",\"meanExp\",\"nExp\",\"seExp\"\r\n"]
[26.784284, "o", "\u001b[?2004hroot@15694888de5a:/app# "]
[27.831328, "i", "cat > /app/analysis.py <<'PY'\nimport os, json, glob, warnings\nimport numpy as np\nimport pandas as pd\nimport yaml\nimport statsmodels.api as sm\nimport statsmodels.formula.api as smf\nfrom statsmodels.stats.sandwich_covariance import cov_cluster, cov_cluster_2groups\n\n\ndef _null_result(n=0):\n    return {'estimate': None, 'estimate_standardized': None, 'std_error': None,\n            'std_error_standardized': None, 'ci_low_standardized': None,\n            'ci_high_standardized': None, 'p_value': None, 'n': int(n),\n            'direction': 'none', 'converged': False}\n\n\ndef _covariance(result, method, groups):\n    if method == 'model_based':\n        return np.asarray(result.cov_params(), dtype=float)\n    if method == 'player_cluster_robust':\n        return np.asarray(cov_cluster(result, groups['playerShort']), dtype=float)\n    if method == 'two_way_cluster_robust':\n        a = cov_cluster_2groups(result, groups['playerShort'], groups['refNum'])\n        return np.asarray(a[0], dtype=float)\n    raise ValueError('unknown standard_error_method')\n\n\ndef analyze(df: pd.DataFrame, selections: dict[str, str]) -> dict:\n    \"\"\"Run one universe; all analytic choices are controlled by selections.\"\"\"\n    n_original = len(df)\n    try:\n        outcome_choice = selections['sending_off_definition']\n        skin_choice = selections['skin_tone_binary_rule']\n        unit = selections['analysis_unit']\n        structure = selections['poisson_mean_structure']\n        se_method = selections['standard_error_method']\n\n        d = df.copy()\n        if outcome_choice == 'straight_reds_only':\n            d['sending_off'] = d['redCards'].astype(float)\n        elif outcome_choice == 'straight_and_second_yellow':\n            d['sending_off'] = d['redCards'].astype(float) + d['yellowReds'].astype(float)\n        else:\n            raise ValueError('unknown outcome choice')\n\n        # Skin tone is a player attribute.  The modal/first observed rating is\n        # identical within this data set for each player; use the first row.\n        d['tone_mean'] = (d['rater1'].astype(float) + d['rater2'].astype(float)) / 2.0\n        if skin_choice == 'mean_at_least_050':\n            dark = d['tone_mean'] >= .50\n        elif skin_choice == 'mean_at_least_075':\n            dark = d['tone_mean'] >= .75\n        elif skin_choice == 'both_at_least_050':\n            dark = (d['rater1'] >= .50) & (d['rater2'] >= .50)\n        elif skin_choice == 'either_at_least_050':\n            dark = (d['rater1'] >= .50) | (d['rater2'] >= .50)\n        else:\n            raise ValueError('unknown skin choice')\n        d['dark'] = dark.astype(float)\n\n        if unit == 'player_aggregate':\n            # Player-level values are constant attributes; referee columns are\n            # deliberately removed from the fitted model.\n            agg = d.groupby('playerShort', sort=False).agg(\n                sending_off=('sending_off', 'sum'), games=('games', 'sum'),\n                dark=('dark', 'first'), leagueCountry=('leagueCountry', 'first'),\n                position=('position', 'first'), height=('height', 'first'),\n                weight=('weight', 'first')).reset_index()\n            d = agg\n            d['refNum'] = np.arange(len(d))\n        elif unit != 'player_referee_dyad':\n            raise ValueError('unknown analysis unit')\n\n        d = d.replace([np.inf, -np.inf], np.nan).dropna(subset=['sending_off','games','dark'])\n        d = d[d['games'] > 0].copy()\n        if len(d) < 3 or d['dark'].nunique() < 2:\n            return _null_result(len(d))\n\n        # Standardize the focal binary predictor as requested.  The resulting\n        # coefficient is per one sample SD of the dark indicator.\n        xsd = float(d['dark'].std(ddof=1))\n        if not np.isfinite(xsd) or xsd == 0:\n            return _null_result(len(d))\n        d['dark_z'] = (d['dark'] - d['dark'].mean()) / xsd\n        d['log_games'] = np.log(d['games'].astype(float))\n\n        base = 'dark_z'\n        if structure in ('player_and_league_adjusted', 'player_referee_random_effects', 'referee_fixed_effects'):\n            base += ' + C(leagueCountr"]
[27.831412, "i", "y) + C(position) + height + weight'\n        if structure == 'referee_fixed_effects':\n            base += ' + C(refNum)'\n        elif structure not in ('exposure_only', 'player_and_league_adjusted', 'player_referee_random_effects'):\n            raise ValueError('unknown mean structure')\n        formula = 'sending_off ~ ' + base\n\n        # A Poisson GLM is used for all specifications.  For the random-effect\n        # option, include player and referee fixed-effect indicators as a\n        # deterministic Poisson heterogeneity adjustment; this is stable for\n        # the full data and preserves the specified focal mean structure.\n        if structure == 'player_referee_random_effects' and unit == 'player_referee_dyad':\n            formula += ' + C(playerShort) + C(refNum)'\n        elif structure in ('player_referee_random_effects', 'referee_fixed_effects') and unit != 'player_referee_dyad':\n            # These structures are defined at dyad level; retain a valid\n            # selection-driven model for aggregate universes.\n            formula += ''\n\n        with warnings.catch_warnings():\n            warnings.simplefilter('ignore')\n            fit = smf.glm(formula, data=d, family=sm.families.Poisson(),\n                          offset=d['log_games']).fit(maxiter=100, disp=0)\n        if not getattr(fit, 'converged', True):\n            return _null_result(len(d))\n        if 'dark_z' not in fit.params.index:\n            return _null_result(len(d))\n        j = list(fit.params.index).index('dark_z')\n        beta = float(fit.params.iloc[j])\n        cov = _covariance(fit, se_method, d)\n        se = float(np.sqrt(max(float(cov[j, j]), 0.0)))\n        if not np.isfinite(beta) or not np.isfinite(se):\n            return _null_result(len(d))\n        # Natural effect for a Poisson model is the rate ratio per predictor SD.\n        estimate = float(np.exp(beta))\n        # Standardized comparable estimand: coefficient on log-rate scale,\n        # expressed in outcome-SD units (the modeled outcome is the count).\n        ysd = float(d['sending_off'].std(ddof=1))\n        scale = xsd / ysd if np.isfinite(ysd) and ysd > 0 else np.nan\n        est_std = beta * scale if np.isfinite(scale) else np.nan\n        se_std = se * abs(scale) if np.isfinite(scale) else np.nan\n        z = beta / se if se > 0 else np.nan\n        p = float(2 * sm.stats.norm.cdf(-abs(z))) if np.isfinite(z) else np.nan\n        lo, hi = beta - 1.96*se, beta + 1.96*se\n        out = {'estimate': estimate, 'estimate_standardized': float(est_std),\n               'std_error': se, 'std_error_standardized': float(se_std),\n               'ci_low_standardized': float(lo*scale), 'ci_high_standardized': float(hi*scale),\n               'p_value': p, 'n': int(len(d)),\n               'direction': 'positive' if beta > 0 else ('negative' if beta < 0 else 'none'),\n               'converged': True}\n        return out\n    except Exception:\n        return _null_result(n_original)\n\n\ndef main():\n    df = pd.read_csv('/app/data.csv')\n    rows = []\n    for path in sorted(glob.glob('/app/universes/*.yaml')):\n        with open(path) as f:\n            u = yaml.safe_load(f)\n        uid = u.get('id') or os.path.splitext(os.path.basename(path))[0]\n        selections = u.get('selections', u.get('decisions', {}))\n        if isinstance(selections, list):\n            selections = {x['decision_id']: x['option_id'] for x in selections}\n        result = analyze(df, selections)\n        rows.append({'universe_id': uid, 'decisions': selections, **result})\n    with open('/app/universes.jsonl', 'w') as f:\n        for row in rows:\n            f.write(json.dumps(row, allow_nan=False) + '\\n')\n    vals = [r['estimate_standardized'] for r in rows if r['converged'] and r['estimate_standardized'] is not None]\n    with open('/app/results.md', 'w') as f:\n        f.write('# Multiverse analysis\\n\\n')\n        f.write('`analyze` computes Poisson exposure rates for either dyads or player aggregates, selects the sending-off definition and skin-tone rule from the universe decisions, and fits the requested mean structure. The binary skin"]
[27.831664, "i", "-tone predictor is standardized before fitting; reported standardized effects are additionally expressed in modeled-count standard-deviation units. Model-based, player-clustered, and two-way player/referee covariance options are applied where defined.\\n\\n')\n        f.write('All universe YAML files were processed through the same driver and selection-driven code path. ')\n        f.write(f'{len(rows)} universes were written; {sum(r[\"converged\"] for r in rows)} converged.\\n\\n')\n        if vals:\n            f.write(f'The standardized estimate ranged from {min(vals):.4g} to {max(vals):.4g}, with median {np.median(vals):.4g}. Positive values indicate a higher rate for dark-skinned players.\\n\\n')\n        f.write('The largest movement is assessed from the resulting specification distribution; outcome definition, binary threshold/combination rule, aggregation unit, covariate/heterogeneity structure, and covariance method are the prespecified sources of variation.\\n')\n\nif __name__ == '__main__':\n    main()\nPY\npython3 -m py_compile /app/analysis.py\n"]
