[843.203645, "o", "finite_bad 0\r\nfirst {'universe_id': 'universe_000', 'decisions': {'analysis_unit': 'player_referee_dyad', 'poisson_mean_structure': 'player_and_league_adjusted', 'sending_off_definition': 'straight_and_second_yellow', 'skin_tone_binary_rule': 'mean_at_least_050', 'standard_error_method': 'model_based'}, 'estimate': 1.3262152902388462, 'estimate_standardized': 1.79456884375035, 'std_error': 0.006036066120111053, 'std_error_standardized': 0.03836703639638588, 'ci_low_standardized': 1.7193694524134335, 'ci_high_standardized': 1.8697682350872662, 'p_value': 0.0, 'n': 146028, 'direction': 'positive', 'converged': True}\r\nlast {'universe_id': 'universe_111', 'decisions': {'analysis_unit': 'player_referee_dyad', 'poisson_mean_structure': 'referee_fixed_effects', 'sending_off_definition': 'straight_reds_only', 'skin_tone_binary_rule': 'mean_at_least_075', 'standard_error_method': 'two_way_cluster_robust'}, 'estimate': 1.0697757770637955, 'estimate_standardized': 0.5974799020114971, 'std_error': 0.026395140758380203, 'std_error_standardized': 0.2338144256126287, 'ci_low_standardized': 0.13920362781074488, 'ci_high_standardized': 1.0557561762122494, 'p_value': 0.01060781914583049, 'n': 146028, 'direction': 'positive', 'converged': True}\r\n"]
[843.205896, "o", "\u001b[?2004hroot@15694888de5a:/app# cat /app/results.md\r\n\u001b[?2004l\r"]
[843.206494, "o", "# Multiverse analysis\r\n\r\nThe parameterised `analyze` function selects the sending-off definition, skin-tone rule, analysis unit, Poisson mean structure, and standard-error method from each universe. It uses sparse Poisson IRLS, exposure offsets, standardized skin-tone predictors, and outcome-SD scaling for comparable standardized effects.\r\n\r\n112 universes were processed; 112 converged and 0 failed clearly.\r\n\r\nStandardized estimates ranged from -0.012921 to 3.1303, with median 0.31604. The spread reflects outcome definition, skin-tone classification, aggregation, covariate/heterogeneity structure, and dependence adjustment.\r\n"]
[843.206602, "o", "\u001b[?2004hroot@15694888de5a:/app# "]
[865.586224, "i", "python3 - <<'PY'\nimport json, numpy as np\nfrom collections import defaultdict\nrows=[json.loads(x) for x in open('/app/universes.jsonl')]\nkeys=['sending_off_definition','skin_tone_binary_rule','analysis_unit','poisson_mean_structure','standard_error_method']\nvals=[r['estimate_standardized'] for r in rows if r['converged'] and r['estimate_standardized'] is not None]\nwith open('/app/results.md','w') as f:\n f.write('# Multiverse analysis\\n\\n')\n f.write('The parameterised `analyze` function selects the sending-off definition, skin-tone rule, analysis unit, Poisson mean structure, and standard-error method from each universe. It uses Poisson exposure offsets, a skin-tone predictor standardized before fitting, sparse fitting for the large dyad data, and outcome-SD scaling for comparable standardized effects. The requested model-based, player-clustered, and two-way player/referee uncertainty options are selected from the universe decisions.\\n\\n')\n f.write(f'All {len(rows)} universe YAML files were processed through the same driver and selection-driven code path; {sum(r[\"converged\"] for r in rows)} converged and {sum(not r[\"converged\"] for r in rows)} failed.\\n\\n')\n f.write(f'The standardized estimate ranged from {min(vals):.6g} to {max(vals):.6g}, with median {np.median(vals):.6g}. Positive values indicate a higher exposure-adjusted sending-off rate for dark-skinned players.\\n\\n')\n f.write('## Decision-specific movement\\n\\n')\n stats=[]\n for k in keys:\n  groups=defaultdict(list)\n  for r in rows:\n   v=r.get('estimate_standardized')\n   if v is not None: groups[r['decisions'][k]].append(v)\n  means={g:float(np.mean(x)) for g,x in groups.items()}\n  allv=[v for x in groups.values() for v in x]\n  stats.append((max(means.values())-min(means.values()),k,means,min(allv),max(allv)))\n for movement,k,means,mn,mx in sorted(stats,reverse=True):\n  f.write(f'- **{k}**: group-mean spread {movement:.6g}; observed range {mn:.6g} to {mx:.6g}. Means: ')\n  f.write('; '.join(f'{g}={v:.6g}' for g,v in sorted(means.items())))\n  f.write('.\\n')\n f.write('\\nThe decision with the largest movement in group means is listed first. These are descriptive specification-curve comparisons, not a separate hypothesis test.\\n')\nprint('updated report')\nfor movement,k,means,mn,mx in sorted(stats,reverse=True): print(k, 'group_mean_spread=',movement, 'means=',means)\nPY\nprintf '%s\\n' '--- final validation ---'\npython3 - <<'PY'\nimport json,math,os\nrows=[json.loads(x) for x in open('/app/universes.jsonl')]\nprint('rows=',len(rows),'unique_ids=',len({r['universe_id'] for r in rows}),'converged=',sum(r['converged'] for r in rows))\nprint('report_exists=',os.path.exists('/app/results.md'),'jsonl_exists=',os.path.exists('/app/universes.jsonl'))\nprint('finite=',all(v is None or (isinstance(v,(int,float)) and math.isfinite(v)) for r in rows for k,v in r.items() if k not in ('universe_id','decisions','direction','converged')))\nPY\ncat /app/results.md\n"]
