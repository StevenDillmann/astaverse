[27.848745, "o", "            d = agg\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.849029, "o", "            d['refNum'] = np.arange(len(d))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.849344, "o", "        elif unit != 'player_referee_dyad':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.849499, "o", "            raise ValueError('unknown analysis unit')\r\n\u001b[?2004l\r"]
[27.849571, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.849934, "o", "        d = d.replace([np.inf, -np.inf], np.nan).dropna(subset=['sending_off','games','dark'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.850052, "o", "        d = d[d['games'] > 0].copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.850236, "o", "        if len(d) < 3 or d['dark'].nunique() < 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.85038, "o", "            return _null_result(len(d))\r\n\u001b[?2004l\r\r\n    wit\u001b[?2004h"]
[27.850457, "o", "> \r\n\u001b[?2004l\rh\u001b[?2004h> "]
[27.850822, "o", "        # Standardize the focal binary predictor as requested.  The resulting\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.851153, "o", "        # coefficient is per one sample SD of the dark indicator.\r\n\u001b[?2004l\r'es\u001b[?2004h> "]
[27.851311, "o", "        xsd = float(d['dark'].std(ddof=1))\r\n\u001b[?2004l\r"]
[27.85134, "o", "\u001b[?2004h> "]
[27.851469, "o", "        if not np.isfinite(xsd) or xsd == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[27.851487, "o", "> "]
[27.851718, "o", "            return _null_result(len(d))\r\n\u001b[?2004l\rd"]
[27.851818, "o", "\u001b[?2004h> "]
[27.852142, "o", "        d['dark_z'] = (d['dark'] - d['dark'].mean()) / xsd\r\n\u001b[?2004l\r')\r\n\u001b[?2004h"]
[27.852191, "o", "> "]
[27.852399, "o", "        d['log_games'] = np.log(d['games'].astype(float))\r\n\u001b[?2004l\r"]
[27.852511, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[27.85254, "o", "        base = 'dark_z'\r\n\u001b[?2004l\r"]
[27.852611, "o", "\u001b[?2004h"]
[27.852631, "o", "> "]
[27.852959, "o", "        if structure in ('player_and_league_adjusted', 'player_referee_random_effects', 'referee_fixed_effects'):\r\n\u001b[?2004l\r"]
[27.852988, "o", "\u001b[?2004h> "]
[27.853172, "o", "            base += ' + C(leagueCountry) + C(position) + height + weight'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.853298, "o", "        if structure == 'referee_fixed_effects':\r\n\u001b[?2004l\r"]
[27.853318, "o", "\u001b[?2004h> "]
[27.853423, "o", "            base += ' + C(refNum)'\r\n\u001b[?2004l\r"]
[27.853446, "o", "\u001b[?2004h> "]
[27.853836, "o", "        elif structure not in ('exposure_only', 'player_and_league_adjusted', 'player_referee_random_effects'):\r\n\u001b[?2004l\r"]
[27.853862, "o", "\u001b[?2004h> "]
[27.854045, "o", "            raise ValueError('unknown mean structure')\r\n\u001b[?2004l\rAll universe"]
[27.854135, "o", "\u001b[?2004h> "]
[27.854208, "o", "        formula = 'sending_off ~ ' + base\r\n\u001b[?2004l\r"]
[27.854307, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.854621, "o", "        # A Poisson GLM is used for all specifications.  For the random-effect\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.854965, "o", "        # option, include player and referee fixed-effect indicators as a\r\n\u001b[?2004l\r\u001b[?2004h"]
[27.855079, "o", "> "]
[27.855378, "o", "        # deterministic Poisson heterogeneity adjustment; this is stable for\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.855659, "o", "        # the full data and preserves the specified focal mean structure.\r\n\u001b[?2004l\rositi\u001b[?2004h"]
[27.855688, "o", "> "]
[27.856201, "o", "        if structure == 'player_referee_random_effects' and unit == 'player_referee_dyad':\r\n\u001b[?2004l\rte('The large\u001b[?2004h> "]
[27.856392, "o", "            formula += ' + C(playerShort) + C(refNum)'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.856794, "o", "        elif structure in ('player_referee_random_effects', 'referee_fixed_effects') and unit != 'player_referee_dyad':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.857095, "o", "            # These structures are defined at dyad level; retain a valid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.857339, "o", "            # selection-driven model for aggregate universes.\r\n\u001b[?2004l\rl"]
[27.857362, "o", "\u001b[?2004h> "]
[27.85746, "o", "            formula += ''\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.857533, "o", "        with warnings.catch_warnings():\r\n\u001b[?2004l\r"]
[27.857613, "o", "\u001b[?2004h> "]
[27.857839, "o", "            warnings.simplefilter('ignore')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.858024, "o", "            fit = smf.glm(formula, data=d, family=sm.families.Poisson(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.858234, "o", "                          offset=d['log_games']).fit(maxiter=100, disp=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[27.858295, "o", ">         if not getattr(fit, 'converged', True):\r\n\u001b[?2004l\r"]
[27.858341, "o", "\u001b[?2004h> "]
[27.858421, "o", "            return _null_result(len(d))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.858564, "o", "        if 'dark_z' not in fit.params.index:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.858749, "o", "            return _null_result(len(d))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.858836, "o", "        j = list(fit.params.index).index('dark_z')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.858911, "o", "        beta = float(fit.params.iloc[j])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.859016, "o", "        cov = _covariance(fit, se_method, d)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.859181, "o", "        se = float(np.sqrt(max(float(cov[j, j]), 0.0)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.859411, "o", "        if not np.isfinite(beta) or not np.isfinite(se):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.859575, "o", "            return _null_result(len(d))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.859746, "o", "        # Natural effect for a Poisson model is the rate ratio per predictor SD.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.859908, "o", "        estimate = float(np.exp(beta))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.860109, "o", "        # Standardized comparable estimand: coefficient on log-rate scale,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.860228, "o", "        # expressed in outcome-SD units (the modeled outcome is the count).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.860302, "o", "        ysd = float(d['sending_off'].std(ddof=1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.860418, "o", "        scale = xsd / ysd if np.isfinite(ysd) and ysd > 0 else np.nan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.860535, "o", "        est_std = beta * scale if np.isfinite(scale) else np.nan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.860686, "o", "        se_std = se * abs(scale) if np.isfinite(scale) else np.nan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.860803, "o", "        z = beta / se if se > 0 else np.nan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.860916, "o", "        p = float(2 * sm.stats.norm.cdf(-abs(z))) if np.isfinite(z) else np.nan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.861022, "o", "        lo, hi = beta - 1.96*se, beta + 1.96*se\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.861162, "o", "        out = {'estimate': estimate, 'estimate_standardized': float(est_std),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.861317, "o", "               'std_error': se, 'std_error_standardized': float(se_std),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.861448, "o", "               'ci_low_standardized': float(lo*scale), 'ci_high_standardized': float(hi*scale),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.861533, "o", "               'p_value': p, 'n': int(len(d)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.861753, "o", "               'direction': 'positive' if beta > 0 else ('negative' if beta < 0 else 'none'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.861778, "o", "               'converged': True}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.861924, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception:"]
[27.86201, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.862085, "o", "        return _null_result(n_original)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[27.862137, "o", "\u001b[?2004h> "]
[27.862166, "o", "def main():\r\n\u001b[?2004l\r"]
[27.862268, "o", "\u001b[?2004h"]
[27.862301, "o", ">     df = pd.read_csv('/app/data.csv')\r\n\u001b[?2004l\r"]
[27.86236, "o", "\u001b[?2004h> "]
[27.862417, "o", "    rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.862666, "o", "    for path in sorted(glob.glob('/app/universes/*.yaml')):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.86274, "o", "        with open(path) as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.862785, "o", "            u = yaml.safe_load(f)\r\n\u001b[?2004l\r"]
[27.862847, "o", "\u001b[?2004h> "]
[27.862979, "o", "        uid = u.get('id') or os.path.splitext(os.path.basename(path))[0]\r\n"]
[27.863054, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[27.863169, "o", "        selections = u.get('selections', u.get('decisions', {}))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.863299, "o", "        if isinstance(selections, list):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.863492, "o", "            selections = {x['decision_id']: x['option_id'] for x in selections}\r\n"]
[27.863578, "o", "\u001b[?2004l\r\u001b[?2004h"]
[27.86368, "o", "> "]
[27.863811, "o", "        result = analyze(df, selections)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.863963, "o", "        rows.append({'universe_id': uid, 'decisions': selections, **result})\r\n\u001b[?2004l\r\u001b[?2004h"]
[27.86404, "o", "> "]
[27.864171, "o", "    with open('/app/universes.jsonl', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[27.864269, "o", "> "]
[27.864368, "o", "        for row in rows:\r\n\u001b[?2004l\r"]
[27.864469, "o", "\u001b[?2004h> "]
[27.864697, "o", "            f.write(json.dumps(row, allow_nan=False) + '\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[27.864756, "o", "> "]
[27.864991, "o", "    vals = [r['estimate_standardized'] for r in rows if r['converged'] and r['estimate_standardized'] is not None]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.8651, "o", "    with open('/app/results.md', 'w') as f:\r\n\u001b[?2004l\r"]
[27.865117, "o", "\u001b[?2004h> "]
[27.865273, "o", "        f.write('# Multiverse analysis\\n\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[27.865311, "o", "> "]
[27.866125, "o", "        f.write('`analyze` computes Poisson exposure rates for either dyads or player aggregates, selects the sending-off definition and skin-tone rule from the universe decisions, and fits the requested mean structure. The binary skin-tone predictor is standardized before fitting; reported standardized effects are additionally expressed in modeled-count standard-deviation units. Model-based, player-clustered, and two-way player/referee covariance options are applied where defined.\\n\\n')\r\n\u001b[?2004l\r"]
[27.866197, "o", "\u001b[?2004h> "]
[27.866278, "o", "        f.write('All universe YAML files were processed through the same driver and selection-driven code path. ')\r\n\u001b[?2004l\r"]
[27.86634, "o", "\u001b[?2004h"]
[27.866381, "o", "> "]
[27.866534, "o", "        f.write(f'{len(rows)} universes were written; {sum(r[\"converged\"] for r in rows)} converged.\\n\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.866608, "o", "        if vals:\r\n\u001b[?2004l\r"]
[27.866664, "o", "\u001b[?2004h> "]
[27.86698, "o", "            f.write(f'The standardized estimate ranged from {min(vals):.4g} to {max(vals):.4g}, with median {np.median(vals):.4g}. Positive values indicate a higher rate for dark-skinned players.\\n\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.86745, "o", "        f.write('The largest movement is assessed from the resulting specification distribution; outcome definition, binary threshold/combination rule, aggregation unit, covariate/heterogeneity structure, and covariance method are the prespecified sources of variation.\\n')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.867543, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[27.870259, "o", "\u001b[?2004h"]
[27.87028, "o", "root@15694888de5a:/app# "]
[27.870369, "o", "python3 -m py_compile /app/analysis.py\r\n\u001b[?2004l\r"]
