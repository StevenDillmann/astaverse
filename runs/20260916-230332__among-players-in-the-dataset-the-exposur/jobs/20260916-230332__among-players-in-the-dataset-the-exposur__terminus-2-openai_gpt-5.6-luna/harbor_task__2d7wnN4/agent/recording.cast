[134.459915, "i", "python3 - <<'PY'\np='/app/analysis.py'\ns=open(p).read()\ns=s.replace('from statsmodels.stats.sandwich_covariance import cov_cluster, cov_cluster_2groups\\n', 'from statsmodels.stats.sandwich_covariance import cov_cluster, cov_cluster_2groups\\nfrom scipy.stats import norm\\n')\ns=s.replace(\"p = float(2 * sm.stats.norm.cdf(-abs(z))) if np.isfinite(z) else np.nan\", \"p = float(2 * norm.cdf(-abs(z))) if np.isfinite(z) else np.nan\")\ns=s.replace(\"scale = xsd / ysd if np.isfinite(ysd) and ysd > 0 else np.nan\", \"scale = 1.0 / ysd if np.isfinite(ysd) and ysd > 0 else np.nan\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/analysis.py\n"]
