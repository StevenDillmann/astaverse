erved range {mn:.6g} to {mx:.6g}. Means: \')\n  f.write(\'; \'.join(f\'{g}={v:.6g}\' for g,v in sorted(means.items())))\n  f.write(\'.\\n\')\n f.write(\'\\nThe decision with the largest movement in group means is listed first. These are descriptive specification-curve comparisons, not a separate hypothesis test.\\n\')\nprint(\'updated report\')\nfor movement,k,means,mn,mx in sorted(stats,reverse=True): print(k, \'group_mean_spread=\',movement, \'means=\',means)\nPY\nprintf \'%s\\n\' \'--- final validation ---\'\npython3 - <<\'PY\'\nimport json,math,os\nrows=[json.loads(x) for x in open(\'/app/universes.jsonl\')]\nprint(\'rows=\',len(rows),\'unique_ids=\',len({r[\'universe_id\'] for r in rows}),\'converged=\',sum(r[\'converged\'] for r in rows))\nprint(\'report_exists=\',os.path.exists(\'/app/results.md\'),\'jsonl_exists=\',os.path.exists(\'/app/universes.jsonl\'))\nprint(\'finite=\',all(v is None or (isinstance(v,(int,float)) and math.isfinite(v)) for r in rows for k,v in r.items() if k not in (\'universe_id\',\'decisions\',\'direction\',\'converged\')))\nPY\ncat /app/results.md\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
