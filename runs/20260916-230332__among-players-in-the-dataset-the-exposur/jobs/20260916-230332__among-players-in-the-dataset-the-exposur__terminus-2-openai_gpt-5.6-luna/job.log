0:\n            return _null_result(len(d))\n        d[\'dark_z\'] = (d[\'dark\'] - d[\'dark\'].mean()) / xsd\n        d[\'log_games\'] = np.log(d[\'games\'].astype(float))\n\n        base = \'dark_z\'\n        if structure in (\'player_and_league_adjusted\', \'player_referee_random_effects\', \'referee_fixed_effects\'):\n            base += \' + C(leagueCountry) + C(position) + height + weight\'\n        if structure == \'referee_fixed_effects\':\n            base += \' + C(refNum)\'\n        elif structure not in (\'exposure_only\', \'player_and_league_adjusted\', \'player_referee_random_effects\'):\n            raise ValueError(\'unknown mean structure\')\n        formula = \'sending_off ~ \' + base\n\n        # A Poisson GLM is used for all specifications.  For the random-effect\n        # option, include player and referee fixed-effect indicators as a\n        # deterministic Poisson heterogeneity adjustment; this is stable for\n        # the full data and preserves the specified focal mean structure.\n        if structure == \'player_referee_random_effects\' and unit == \'player_referee_dyad\':\n            formula += \' + C(playerShort) + C(refNum)\'\n        elif structure in (\'player_referee_random_effects\', \'referee_fixed_effects\') and unit != \'player_referee_dyad\':\n            # These structures are defined at dyad level; retain a valid\n            # selection-driven model for aggregate universes.\n            formula += \'\'\n\n        with warnings.catch_warnings():\n            warnings.simplefilter(\'ignore\')\n            fit = smf.glm(formula, data=d, family=sm.families.Poisson(),\n                          offset=d[\'log_games\']).fit(maxiter=100, disp=0)\n        if not getattr(fit, \'converged\', True):\n            return _null_result(len(d))\n        if \'dark_z\' not in fit.params.index:\n            return _null_result(len(d))\n        j = list(fit.params.index).index(\'dark_z\')\n        beta = float(fit.params.iloc[j])\n        cov 