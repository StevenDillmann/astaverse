[?2004l[?2004h> def main():
[?2004l[?2004h>     df = pd.read_csv('/app/data.csv')
[?2004l[?2004h>     files = sorted(Path('/app/universes').glob('*.yaml'))
[?2004l[?2004h>     rows=[]
[?2004l[?2004h>     with open('/app/universes.jsonl','w') as f:
[?2004l[?2004h>         for path in files:
[?2004l[?2004h>             u = yaml.safe_load(path.read_text())
[?2004l[?2004h>             selections = {x['decision_id']: x['option_id'] for x in u['decisions']}
[?2004l[?2004h>             result = analyze(df, selections)
[?2004l[?2004h>             row = {'universe_id': u['id'], 'decisions': selections, **result}
[?2004l[?2004h>             f.write(json.dumps(row, allow_nan=False) + '\n'); rows.append(row)
[?2004l[?2004h>     good=[r for r in rows if r.get('converged')]
[?2004l[?2004h>     lines=['# Multiverse analysis report','',f'Analyzed {len(rows)} universes; {len(good)} converged.']
[?2004l[?2004h>     lines += ['', '## Analysis', 'The parameterized `analyze` function constructs the selected sending-off outcome, combines raters and applies the selected threshold, then fits the selected logistic specification. The focal dark-skin coefficient is reported on the log-odds scale. `estimate_standardized` and its uncertainty multiply the natural coefficient scale by the sample SD of the binary exposure.']
