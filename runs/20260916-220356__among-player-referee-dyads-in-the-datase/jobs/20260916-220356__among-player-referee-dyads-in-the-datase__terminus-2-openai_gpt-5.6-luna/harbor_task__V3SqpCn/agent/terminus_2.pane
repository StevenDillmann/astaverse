[?2004lpython3 - <<'PY'
import json,pathlib,collections,math
p=pathlib.Path('/app/universes.jsonl')
rows=[json.loads(x) for x in p.read_text().splitlines()] if p.exists() else []
print('lines',len(rows),'unique',len({r['universe_id'] for r in rows}))
print('converged',sum(bool(r.get('converged')) for r in rows),'failed',sum(not bool(r.get('converged')) for r in rows))
print('last',rows[-1]['universe_id'] if rows else None,'report',pathlib.Path('/app/results.md').exists())
print('notes',collections.Counter(r.get('notes','OK') for r in rows))
print('bad finite',sum(any(isinstance(r.get(k),float) and not math.isfinite(r[k]) for k in ['estimate','std_error']) for r in rows))
