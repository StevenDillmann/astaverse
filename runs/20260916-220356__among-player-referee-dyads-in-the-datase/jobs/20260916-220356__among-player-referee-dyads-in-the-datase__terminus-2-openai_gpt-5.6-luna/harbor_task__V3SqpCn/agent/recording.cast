[721.327003, "i", "python3 - <<'PY'\np='/app/analysis.py'\ns=open(p).read()\ns=s.replace(\"for _ in range(12):\", \"for _ in range(4):\")\ns=s.replace(\"if len(vals) >= 3: se = float(np.std(vals, ddof=1))\", \"if len(vals) >= 3: se = float(np.std(vals, ddof=1))\\n            else: return _empty(n, 'insufficient successful bootstrap replicates')\")\n# Release large temporary bootstrap objects each iteration.\ns=s.replace(\"if good: vals.append(float(bb[nn.index('dark_skin')]))\\n                except Exception: pass\", \"if good: vals.append(float(bb[nn.index('dark_skin')]))\\n                    del bb\\n                except Exception: pass\")\n# Add gc import and collect after bootstrap.\ns=s.replace(\"import json, math, os, warnings\", \"import json, math, os, warnings, gc\")\ns=s.replace(\"else: return _empty(n, 'insufficient successful bootstrap replicates')\\n        if not np.isfinite(se):\", \"else: return _empty(n, 'insufficient successful bootstrap replicates')\\n            gc.collect()\\n        if not np.isfinite(se):\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/analysis.py\n"]
