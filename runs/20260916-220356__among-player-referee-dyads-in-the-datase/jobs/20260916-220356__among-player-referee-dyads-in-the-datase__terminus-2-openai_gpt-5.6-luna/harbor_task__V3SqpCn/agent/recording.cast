[589.836233, "i", "python3 - <<'PY'\nimport pathlib,yaml\nseen={}\nfor p in sorted(pathlib.Path('/app/universes').glob('*.yaml')):\n u=yaml.safe_load(p.read_text()); s={x['decision_id']:x['option_id'] for x in u['decisions']}\n k=s['logistic_model_specification']\n if k not in seen: seen[k]=(p.name,s)\nprint(seen)\nPY\n"]
