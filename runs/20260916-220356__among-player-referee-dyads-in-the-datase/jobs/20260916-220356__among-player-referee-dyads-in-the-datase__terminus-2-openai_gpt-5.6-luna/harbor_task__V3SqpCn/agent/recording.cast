[51.176207, "o", "            rng = np.random.default_rng(202503)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.176224, "o", "            vals = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.176317, "o", "> "]
[51.176462, "o", "            players = d.playerShort.unique(); refs = d.refNum.unique()\r\n\u001b[?2004l\r"]
[51.176485, "o", "\u001b[?2004h> "]
[51.176593, "o", "            for _ in range(12):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.17692, "o", "                wp = pd.Series(rng.multinomial(len(players), np.ones(len(players))/len(players)), index=players)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.177093, "o", "                wr = pd.Series(rng.multinomial(len(refs), np.ones(len(refs))/len(refs)), index=refs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.177403, "o", "                bw = wp.reindex(d.playerShort).to_numpy()*wr.reindex(d.refNum).to_numpy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.177495, "o", "                try:\r\n\u001b[?2004l\r"]
[51.17757, "o", "\u001b[?2004h> "]
[51.177756, "o", "                    bb, _, _, good, _, nn = _model_fit(d, spec, None if weights is None else weights*bw)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.17792, "o", "                    if good: vals.append(float(bb[nn.index('dark_skin')]))"]
[51.178001, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.178073, "o", "                except Exception: pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.178094, "o", "> "]
[51.178271, "o", "            if len(vals) >= 3: se = float(np.std(vals, ddof=1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.178449, "o", "        if not np.isfinite(se): return _empty(n, 'variance estimation failed')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.178528, "o", "        eststd = beta*sd; sestd = abs(sd)*se\r\n\u001b[?2004l\r"]
[51.178606, "o", "\u001b[?2004h> "]
[51.178723, "o", "        lo = eststd - 1.96*sestd; hi = eststd + 1.96*sestd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.178829, "o", "        z = beta/se if se > 0 else 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.178924, "o", "        p = float(2*0.5*math.erfc(abs(z)/math.sqrt(2))) if se > 0 else 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.179062, "o", "        direction = 'positive' if beta > 0 else ('negative' if beta < 0 else 'none')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.179191, "o", "        return {'estimate': beta, 'estimate_standardized': eststd, 'std_error': se,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.179328, "o", "                'std_error_standardized': sestd, 'ci_low_standardized': lo,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.179417, "o", "                'ci_high_standardized': hi, 'p_value': p, 'n': n,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.179537, "o", "                'direction': direction, 'converged': True}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.179609, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.179677, "o", "        return _empty(len(df), type(e).__name__ + ': ' + str(e)[:180])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.179694, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.179778, "o", "\u001b[?2004h> def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.179851, "o", "    df = pd.read_csv('/app/data.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.179933, "o", "    files = sorted(Path('/app/universes').glob('*.yaml'))\r\n\u001b[?2004l\r\u001b[?2004h>     rows=[]\r\n\u001b[?2004l\r"]
[51.180005, "o", "\u001b[?2004h> "]
[51.180076, "o", "    with open('/app/universes.jsonl','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.180148, "o", "        for path in files:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.180211, "o", "            u = yaml.safe_load(path.read_text())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.180338, "o", "            selections = {x['decision_id']: x['option_id'] for x in u['decisions']}\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.18036, "o", "> "]
[51.180472, "o", "            result = analyze(df, selections)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.180663, "o", "            row = {'universe_id': u['id'], 'decisions': selections, **result}\r\n\u001b[?2004l\r"]
[51.180688, "o", "\u001b[?2004h> "]
[51.18086, "o", "            f.write(json.dumps(row, allow_nan=False) + '\\n'); rows.append(row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.180959, "o", "    good=[r for r in rows if r.get('converged')]\r\n\u001b[?2004l\r"]
[51.180999, "o", "\u001b[?2004h> "]
[51.181186, "o", "    lines=['# Multiverse analysis report','',f'Analyzed {len(rows)} universes; {len(good)} converged.']\r\n\u001b[?2004l\r"]
[51.181268, "o", "\u001b[?2004h> "]
[51.181978, "o", "    lines += ['', '## Analysis', 'The parameterized `analyze` function constructs the selected sending-off outcome, combines raters and applies the selected threshold, then fits the selected logistic specification. The focal dark-skin coefficient is reported on the log-odds scale. `estimate_standardized` and its uncertainty multiply the natural coefficient scale by the sample SD of the binary exposure.']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.182806, "o", "    lines += ['', 'Second yellows are either included with straight reds or excluded. Rater scores are averaged, taken singly, or restricted to exact agreement. Games are ignored, used as frequency weights, or included as a covariate. Models are crude, adjusted for league/position/height/weight where applicable, referee fixed-effect, or penalized crossed player/referee intercept models. Uncertainty is model-based, two-way clustered, or bootstrap as selected.']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.182829, "o", "    if good:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.183253, "o", "        vals=np.array([r['estimate_standardized'] for r in good]); lines += ['', '## Spread', f'Standardized estimates ranged from {vals.min():.4g} to {vals.max():.4g}; median {np.median(vals):.4g}.']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.18357, "o", "        for dec in ['sending_off_outcome','skin_tone_combination','skin_tone_threshold','games_exposure_handling','logistic_model_specification','uncertainty_estimation']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.183628, "o", "            groups={}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.183809, "o", "            for r in good: groups.setdefault(r['decisions'][dec],[]).append(r['estimate_standardized'])\r\n\u001b[?2004l\r"]
[51.183833, "o", "\u001b[?2004h> "]
[51.183981, "o", "            lines.append(f'### {dec}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.184219, "o", "            for k,v in sorted(groups.items()): lines.append(f'- `{k}`: median {np.median(v):.4g}, range {min(v):.4g} to {max(v):.4g}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.184401, "o", "    Path('/app/results.md').write_text('\\n'.join(lines)+'\\n')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.184454, "o", "\u001b[?2004h> "]
[51.184499, "o", "if __name__ == '__main__': main()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[51.186277, "o", "\u001b[?2004hroot@eb0a35882f2e:/app# "]
[51.186298, "o", "python3 -m py_compile /app/analysis.py\r\n\u001b[?2004l\r"]
