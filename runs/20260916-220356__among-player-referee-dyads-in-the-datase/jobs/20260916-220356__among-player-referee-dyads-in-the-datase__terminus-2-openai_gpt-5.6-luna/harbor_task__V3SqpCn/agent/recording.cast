[128.644265, "o", "            # Add games as a linear covariate while preserving the selected model family.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.644446, "o", "            # This is represented by augmenting the adjusted design in a temporary frame.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.644635, "o", "            d = d.copy(); d['position'] = d['position'].astype(str) + '__games_' + d['games'].astype(str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.644755, "o", "            # retain a numeric games effect through a centered continuous column below\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.644899, "o", "        b, pr, H, ok, X, names = _model_fit(d, spec, weights)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.645015, "o", "        focal = names.index('dark_skin')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.645109, "o", "        beta = float(b[focal])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.645212, "o", "        if gameopt == 'games_as_predictor':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.645332, "o", "            # Refit with an explicit games column for the requested covariate adjustment.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.645431, "o", "            X0, names0 = _design(d, spec)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.645586, "o", "            X = sparse.hstack([X0, sparse.csr_matrix(d[['games']].to_numpy(float))], format='csr')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.64578, "o", "            names = names0 + ['games']; b, pr, H, ok = _logistic_sparse(X, d.outcome, weights, np.zeros(X.shape[1]), 70)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.645903, "o", "            focal = names.index('dark_skin'); beta = float(b[focal])\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r"]
[128.645924, "o", "\u001b[?2004h> "]
[128.646057, "o", "new=\"\"\"        include_games = (gameopt == 'games_as_predictor')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.6462, "o", "        b, pr, H, ok, X, names = _model_fit(d, spec, weights, include_games)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.646301, "o", "        focal = names.index('dark_skin')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.646329, "o", "        beta = float(b[focal])\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.646405, "o", "if old not in s:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.646522, "o", " print('old analyze block not found')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.646547, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.646612, "o", " s=s.replace(old,new)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.646718, "o", "# Ensure bootstrap preserves games predictor\r\n\u001b[?2004l\r"]
[128.646825, "o", "\u001b[?2004h> "]
[128.647128, "o", "s=s.replace(\"_model_fit(d, spec, None if weights is None else weights*bw)\", \"_model_fit(d, spec, None if weights is None else weights*bw, include_games)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
