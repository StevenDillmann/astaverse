[591.887857, "i", "python3 - <<'PY'\nimport sys,time,yaml,pandas as pd\nsys.path.insert(0,'/app')\nfrom analysis import analyze\ndf=pd.read_csv('/app/data.csv')\nids=['universe_032','universe_033','universe_040','universe_041']\nfor ident in ids:\n try:\n  u=yaml.safe_load(open('/app/universes/'+ident+'.yaml'))\n  sel={x['decision_id']:x['option_id'] for x in u['decisions']}\n  t=time.time(); r=analyze(df,sel)\n  print(ident,round(time.time()-t,2),r.get('converged'),r.get('estimate'),r.get('std_error'),r.get('notes'))\n except Exception as e: print(ident,'EXCEPTION',type(e).__name__,str(e)[:200])\nPY\n"]
