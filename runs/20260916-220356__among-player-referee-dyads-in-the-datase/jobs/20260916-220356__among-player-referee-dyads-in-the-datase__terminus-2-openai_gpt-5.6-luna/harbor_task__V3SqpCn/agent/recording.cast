[128.635367, "i", "python3 - <<'PY'\np='/app/analysis.py'\ns=open(p).read()\na=s.index('def _design(')\nb=s.index('\\ndef _logistic_sparse', a)\nnew=r'''def _design(d, spec, include_games=False):\n    mats = [sparse.csr_matrix(np.ones((len(d), 1), dtype=float)),\n            sparse.csr_matrix(d[['dark_skin']].to_numpy(float))]\n    names = ['const', 'dark_skin']\n    def add_cat(col, prefix):\n        vals = pd.Categorical(d[col].astype(str))\n        codes = vals.codes\n        k = len(vals.categories)\n        if k > 1:\n            rows = np.arange(len(d))[codes > 0]\n            cols = codes[codes > 0] - 1\n            dat = np.ones(len(rows), dtype=float)\n            mats.append(sparse.csr_matrix((dat, (rows, cols)), shape=(len(d), k-1)))\n            names.extend([prefix + '_' + str(x) for x in vals.categories[1:]])\n    if spec in ('adjusted_player_league_logistic', 'referee_fixed_effect_logistic'):\n        add_cat('leagueCountry', 'leagueCountry')\n        add_cat('position', 'position')\n        mats.append(sparse.csr_matrix(d[['height','weight']].to_numpy(float)))\n        names.extend(['height', 'weight'])\n    if spec == 'referee_fixed_effect_logistic':\n        add_cat('refNum', 'ref')\n    if spec == 'crossed_random_intercepts':\n        add_cat('playerShort', 'player')\n        add_cat('refNum', 'ref')\n    if include_games:\n        mats.append(sparse.csr_matrix(d[['games']].to_numpy(float)))\n        names.append('games')\n    return sparse.hstack(mats, format='csr'), names\n'''\ns=s[:a]+new+s[b:]\na=s.index('def _model_fit(')\nb=s.index('\\ndef _model_based_se', a)\nnew=r'''def _model_fit(d, spec, weights=None, include_games=False):\n    X, names = _design(d, spec, include_games)\n    if spec == 'crossed_random_intercepts':\n        penalty = np.zeros(X.shape[1])\n        penalty[2:] = 1.0\n        return (*_logistic_sparse(X, d.outcome, weights, penalty, 60), X, names)\n    if spec == 'referee_fixed_effect_logistic':\n        return (*_logistic_sparse(X, d.outcome, weights, None, 70), X, names)\n    res = sm.GLM(d.outcome.to_numpy(float), X.toarray(),\n                 family=sm.families.Binomial(),\n                 freq_weights=None if weights is None else np.asarray(weights)).fit()\n    b = np.asarray(res.params)\n    pr = np.asarray(res.fittedvalues)\n    ww = (np.ones(len(d)) if weights is None else np.asarray(weights))*pr*(1-pr)\n    H = (X.T @ X.multiply(ww[:, None])).tocsc()\n    return b, pr, H, bool(getattr(res, 'converged', True)), X, names\n'''\ns=s[:a]+new+s[b:]\n# Replace the games/design fitting block in analyze\nold=\"\"\"        if gameopt == 'games_as_predictor':\n            # Add games as a linear covariate while preserving the selected model family.\n            # This is represented by augmenting the adjusted design in a temporary frame.\n            d = d.copy(); d['position'] = d['position'].astype(str) + '__games_' + d['games'].astype(str)\n            # retain a numeric games effect through a centered continuous column below\n        b, pr, H, ok, X, names = _model_fit(d, spec, weights)\n        focal = names.index('dark_skin')\n        beta = float(b[focal])\n        if gameopt == 'games_as_predictor':\n            # Refit with an explicit games column for the requested covariate adjustment.\n            X0, names0 = _design(d, spec)\n            X = sparse.hstack([X0, sparse.csr_matrix(d[['games']].to_numpy(float))], format='csr')\n            names = names0 + ['games']; b, pr, H, ok = _logistic_sparse(X, d.outcome, weights, np.zeros(X.shape[1]), 70)\n            focal = names.index('dark_skin'); beta = float(b[focal])\n\"\"\"\nnew=\"\"\"        include_games = (gameopt == 'games_as_predictor')\n        b, pr, H, ok, X, names = _model_fit(d, spec, weights, include_games)\n        focal = names.index('dark_skin')\n        beta = float(b[focal])\n\"\"\"\nif old not in s:\n print('old analyze block not found')\nelse:\n s=s.replace(old,new)\n# Ensure bootstrap preserves games predictor\ns=s.replace(\"_model_fit(d, spec, None if weights is None else weights*bw)\", \"_model_fit(d, spec, None if weights is None else weights*bw, include_games)\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /ap"]
