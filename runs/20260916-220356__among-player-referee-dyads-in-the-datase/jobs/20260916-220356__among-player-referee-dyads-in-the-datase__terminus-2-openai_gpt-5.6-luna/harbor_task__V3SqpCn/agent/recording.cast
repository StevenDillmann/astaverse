[523.05932, "i", "python3 - <<'PY'\nimport sys,time,yaml,pandas as pd\nsys.path.insert(0,'/app')\nfrom analysis import analyze\ndf=pd.read_csv('/app/data.csv')\nfor i in range(26,32):\n u=yaml.safe_load(open(f'/app/universes/universe_{i:03}.yaml'))\n sel={x['decision_id']:x['option_id'] for x in u['decisions']}\n t=time.time()\n try:\n  r=analyze(df,sel)\n  print(i, round(time.time()-t,2), r.get('converged'), r.get('estimate'), r.get('std_error'), r.get('notes'))\n except Exception as e: print(i,'EXCEPTION',type(e).__name__,e)\nPY\n"]
